# --- Core (required) ---
DEEPGRAM_API_KEY=your_deepgram_key_here
GROQ_API_KEY=gsk_your_groq_key_here
PORT=3001
# Comma-separated; empty = permissive (dev). Lock down in production.
ALLOWED_ORIGINS=

# --- Translation-tier rollout flags (spec 0101) ---
# Each tier registers only when BOTH its provider key AND its enable flag are set
# (truthy = 1/true/yes/on). Lets you switch a tier on/off from the environment.
# The three optional tiers default OFF; Standard is the base tier and defaults ON
# (it's force-registered as the fallback default even if you set it to 0).
DEEPGRAM_STANDARD=1   # Standard (Deepgram + Groq)  — default ON
SONIOX_ENHANCED=1     # Enhanced (Soniox, client-direct)
OPENAI_PRO=1          # Pro (OpenAI GPT-Realtime-Translate)
GEMINI_PREMIUM=1      # Premium (Gemini Live Translate)

# --- Enhanced translation engine: Soniox (OPTIONAL, spec 0101) ---
# Client-direct tier between Standard and Pro: the browser connects straight to Soniox
# with a server-minted temp key (the raw key never leaves the server). Needs
# SONIOX_ENHANCED=1 above AND the key below.
SONIOX_API_KEY=
SONIOX_STT_MODEL=stt-rt-v5
SONIOX_COST_PER_MINUTE=0.015
SONIOX_COST_MARKUP_PERCENT=85
# Multi-region scaffolding (US is live; EU/JP fall back to US until provisioned).
SONIOX_API_KEY_EU=
SONIOX_API_KEY_JP=

# --- Pro translation engine: OpenAI GPT-Realtime-Translate (OPTIONAL, spec 0093) ---
# End-to-end speech-to-speech translation (natural audio + matching subtitles).
# Registers only with OPENAI_PRO=1 (above) AND the key below.
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-translate
# Raw server cost per minute (USD). The user-facing rate is cost × (1 + markup);
# the raw value is never exposed to clients. Set this to your real OpenAI cost.
OPENAI_COST_PER_MINUTE=0.30
# Per-engine markup (PERCENT). Falls back to ENGINE_DEFAULT_MARKUP_PERCENT, then 50.
OPENAI_COST_MARKUP_PERCENT=50
ENGINE_DEFAULT_MARKUP_PERCENT=50
# Hard cap on concurrent OpenAI realtime sessions across the process (group-room
# backpressure: sessions = speakers × distinct target languages).
OPENAI_REALTIME_MAX_SESSIONS=16

# --- Premium translation engine: Google Gemini 3.5 Live Translate (OPTIONAL, spec 0100) ---
# Natural speech-to-speech with auto source detection (70+ languages); the top tier in
# the selector. Registers only with GEMINI_PREMIUM=1 (above) AND the key below.
GOOGLE_AI_API_KEY=
# Live Translate model id (read from env — the preview id changes at GA).
GEMINI_LIVE_TRANSLATE_MODEL=gemini-3.5-live-translate-preview
# Raw server cost per minute (USD). User-facing rate is cost × (1 + markup); the raw
# value is never exposed. NOTE: 0.023 is a planning figure — confirm the real Gemini
# Live preview rate before launch.
GEMINI_COST_PER_MINUTE=0.023
# Per-engine markup (PERCENT). Falls back to ENGINE_DEFAULT_MARKUP_PERCENT, then 50.
GEMINI_COST_MARKUP_PERCENT=50
# Hard cap on concurrent Gemini Live sessions across the process. The PREVIEW tier
# limits concurrent sessions and we hold one per target language — keep conservative.
GEMINI_LIVE_MAX_SESSIONS=16

# --- Auth + Billing (OPTIONAL) ---
# Leave DATABASE_URL / GOOGLE_CLIENT_ID / JWT_SECRET empty to run in guest-only
# mode (no accounts, no metering). Fill all three to enable accounts + credits.

# Database
DATABASE_URL=

# Auth
GOOGLE_CLIENT_ID=
JWT_SECRET=
JWT_EXPIRY_HOURS=168

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Set these to your production frontend URL in Railway (e.g. https://voxtranslate.app).
STRIPE_SUCCESS_URL=http://localhost:4321/?checkout=success
STRIPE_CANCEL_URL=http://localhost:4321/?checkout=cancel

# --- Pricing for the Standard engine: Deepgram STT + Groq translation (USD) ---
# Charged per speaking-minute (flat — one Deepgram session per speaker regardless of
# room size): user_rate = COST_PER_MINUTE * (1 + MARKUP_PERCENTAGE).
#   • COST_PER_MINUTE — real cost ≈ Deepgram streaming $0.0077/min + Groq ~$0.0002/min
#     ≈ $0.008/min. Keep this at the true cost.
#   • MARKUP_PERCENTAGE is a FRACTION (0.25 = 25%, 0.75 = 75%) — NOTE this differs from
#     the Premium OPENAI_COST_MARKUP_PERCENT, which is a PERCENT (50 = 50%).
# The markup must cover BOTH the Stripe fee (~2.9% + $0.30) AND the bonus credits on
# the larger packages (e.g. Business = 80 credits for $60), which together mean one
# spent credit nets only ~$0.72–0.91 of real revenue. At 0.25 the most-bonused package
# loses money; 0.75 nets ≥25% real profit on every package.
COST_PER_MINUTE=0.008
MARKUP_PERCENTAGE=0.75
FREE_CREDITS=2.00
LOW_BALANCE_THRESHOLD=0.50
MIN_BALANCE_TO_JOIN=0.05
USAGE_UPDATE_INTERVAL=5
# Optional cap on guest session length (minutes); empty = unlimited.
GUEST_MAX_MINUTES=

# Credit packages — JSON array. stripe_price_id is never sent to the client.
# IMPORTANT: wrap the value in SINGLE quotes — the JSON contains double quotes
# and dotenv would otherwise mangle them (resulting in zero packages).
CREDIT_PACKAGES='[{"id":"starter","name":"Starter","price_usd":5.00,"credits_usd":5.00,"stripe_price_id":"price_xxx1"},{"id":"plus","name":"Plus","price_usd":15.00,"credits_usd":17.00,"stripe_price_id":"price_xxx2"},{"id":"pro","name":"Pro","price_usd":30.00,"credits_usd":36.00,"stripe_price_id":"price_xxx3"},{"id":"business","name":"Business","price_usd":60.00,"credits_usd":80.00,"stripe_price_id":"price_xxx4"}]'

# --- Advanced features (OPTIONAL; sensible defaults) ---

# Room glossary
GLOSSARY_MAX_ENTRIES=200

# AI models (Groq). Real-time translation uses the translation model; offline
# analysis (report/sentiment/email draft) uses the report model; the fallback
# model handles primary-model errors + live suggestions.
GROQ_TRANSLATION_MODEL=openai/gpt-oss-20b
GROQ_REPORT_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# Max concurrent in-flight Groq *translation* calls process-wide (admission cap,
# spec 0069). Bounds real-time fan-out under a traffic spike so a burst can't open
# an unbounded number of parallel Groq requests. Does not touch the AI features.
GROQ_TRANSLATE_MAX_CONCURRENCY=64

# AI feature prices (USD, user-facing).
CREDITS_REPORT_BASE=0.05
CREDITS_REPORT_PER_MINUTE=0.002
CREDITS_SENTIMENT_BASE=0.05
CREDITS_SENTIMENT_PER_PARTICIPANT=0.01
CREDITS_SENTIMENT_PER_MINUTE=0.002
CREDITS_EMAIL_DRAFT=0.02
CREDITS_SUGGESTIONS_PER_MINUTE=0.005
SUGGESTIONS_INTERVAL_SECONDS=15
# Chat document-upload translation: base + per-target-language. Charged only to a
# signed-in user with credits; guests/no-credits get the file as a plain attachment
# (no Groq call). Groq 8B cost is tiny — bump these if the real margin drifts.
CREDITS_UPLOAD_TRANSLATE_BASE=0.01
CREDITS_UPLOAD_TRANSLATE_PER_LANG=0.005

# Auto language detection: how much audio to buffer for the REST probe.
AUTO_DETECT_BUFFER_MS=3000

# Resend (follow-up email). Leave empty to disable the email feature (503).
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=

# Recipient for user bug reports (spec 0071). Defaults to the owner's address if
# unset; email is only sent when RESEND_* above is configured.
BUG_REPORT_TO=

# Canonical public origin of the web app (spec 0082). Used to build call invite
# links and the logo URL inside transactional emails — these must point at our
# own domain. Defaults to https://voxtranslate.app; trailing slash is trimmed.
APP_BASE_URL=

# Chat file upload (spec 0018). Both URL + service key must be set to enable the
# attach button; otherwise the upload endpoint returns 503. Create a PRIVATE
# Supabase Storage bucket named `chat-files` (or override SUPABASE_BUCKET);
# downloads use time-limited signed URLs. SUPABASE_SERVICE_KEY is the
# secret/service key — server only, never shipped to the client.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=chat-files
# Max upload size in bytes (default 5 MiB). Documents only (txt/md/csv/pdf/docx/
# doc/odt/rtf/xlsx/pptx); txt/pdf/docx are text-extracted + translated.
SUPABASE_MAX_UPLOAD_BYTES=5242880
# Signed download-URL lifetime in seconds (default 7 days).
SUPABASE_SIGNED_URL_TTL_SECS=604800

# TURN relay (spec 0026 / 0059 / 0077) — media relay for cross-NAT / cross-border
# calls that direct P2P + STUN can't connect. Left empty → STUN-only (relayed calls
# fail). Pick ONE credential mode (precedence top-to-bottom when several are set):
#   • Cloudflare Realtime TURN (RECOMMENDED, geo-distributed anycast): set
#     TURN_CLOUDFLARE_KEY_ID + TURN_CLOUDFLARE_API_TOKEN. The server mints a
#     short-lived credential per /api/ice via Cloudflare's API; the api_token stays
#     server-side and Cloudflare supplies its own URLs (leave TURN_URLS empty).
#     Create a TURN key at Cloudflare → Realtime → TURN.
#   • Self-hosted coturn: TURN_URLS + TURN_SECRET (the coturn `static-auth-secret`).
#     The server mints short-lived HMAC creds; the secret never reaches the client.
#   • Managed relay (Metered/Twilio/etc.): TURN_URLS + TURN_USERNAME + TURN_PASSWORD,
#     passed straight through. Use a relay-scoped account — these reach the client.
TURN_CLOUDFLARE_KEY_ID=
TURN_CLOUDFLARE_API_TOKEN=
TURN_URLS=
TURN_SECRET=
TURN_USERNAME=
TURN_PASSWORD=
# Minted-credential lifetime in seconds (Cloudflare + TURN_SECRET modes; default 3600).
TURN_TTL_SECS=3600

# Cloudflare edge / WAF (spec 0066 / 0078, issue #111) — only when the origin is
# behind Cloudflare (api.voxtranslate.app proxied → this origin). See
# infra/cloudflare/README.md for the full runbook.
#   • CLIENT_IP_HEADER: trust Cloudflare's real-client-IP header for per-IP limits
#     + logs. Set to cf-connecting-ip ONLY when behind Cloudflare (else leave unset —
#     the default uses the unforgeable last X-Forwarded-For hop).
#   • CF_ORIGIN_SECRET: a long random string Cloudflare injects as the `x-origin-verify`
#     request header (via a Transform Rule). When set, the server rejects any request
#     (except /health) lacking it → blocks direct-to-origin access that bypasses the
#     WAF. Leave empty until the Cloudflare side injects the header, or you'll 403
#     legitimate traffic.
CLIENT_IP_HEADER=
CF_ORIGIN_SECRET=
