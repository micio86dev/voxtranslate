# Client build-time env (Astro/Vite). Only PUBLIC_-prefixed vars reach the browser.
# These are read at BUILD time on Vercel — changing one needs a client redeploy.
# Every var here is OPTIONAL: unset → the in-code fallback (shown) is used.

# Backend host for WS + HTTP (server on Railway). Falls back to the page's own host.
# PUBLIC_WS_HOST=voxtranslate-server-production.up.railway.app

# Total video upload budget in bit/s, split across peers and network-adapted
# (specs 0030–0032 / 0044). Defaults: mobile 1.2 Mbit/s, desktop 2.4 Mbit/s.
# PUBLIC_VIDEO_BUDGET_MOBILE=1200000
# PUBLIC_VIDEO_BUDGET_DESKTOP=2400000
