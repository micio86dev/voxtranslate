# Client build-time env (Astro/Vite). Only PUBLIC_-prefixed vars reach the browser.
# These are read at BUILD time on Vercel — changing one needs a client redeploy.
# Every var here is OPTIONAL: unset → the in-code fallback (shown) is used.

# Backend host for WS + HTTP (prod API behind Cloudflare). Falls back to the page's own host.
# PUBLIC_WS_HOST=api.voxtranslate.app

# Total video upload budget in bit/s, split across peers and network-adapted
# (specs 0030–0032 / 0044). Defaults: mobile 1.2 Mbit/s, desktop 2.4 Mbit/s.
# PUBLIC_VIDEO_BUDGET_MOBILE=1200000
# PUBLIC_VIDEO_BUDGET_DESKTOP=2400000

# Upload budget WHILE SCREEN SHARING (bit/s, spec 0088). Screen content (text/UI)
# needs more than a camera or it looks grainy; this cap applies only during a
# share, then reverts to the camera budget. Desktop-only. Default 4 Mbit/s — raise
# it if the shared screen still looks soft.
# PUBLIC_VIDEO_BUDGET_SCREEN=4000000

# --- Origins (build-time; default to production if unset) --------------------
# PUBLIC_SITE_ORIGIN is read by astro.config.mjs via process.env (import.meta.env
# does not exist there) and sets the canonical/sitemap origin for the app.
PUBLIC_SITE_ORIGIN=https://app.voxtranslate.app
PUBLIC_DASHBOARD_URL=https://dashboard.voxtranslate.app
