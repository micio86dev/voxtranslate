  "onbHomeWelcomeTitle": "VoxTranslate ಗೆ ಸ್ವಾಗತ",
  "onbHomeWelcomeBody": "ಯಾವುದೇ ಭಾಷೆಯಲ್ಲಿ, ಯಾರೊಂದಿಗಾದರೂ ಮಾತನಾಡಿ. ನಿಮ್ಮ ಮಾತು ಲೈವ್ ಉಪಶೀರ್ಷಿಕೆಗಳಾಗಿ ಮತ್ತು ಭಾಷಾಂತರಿತ ಧ್ವನಿಯಾಗಿ ಬದಲಾಗುತ್ತದೆ — ನೈಜ-ಸಮಯದಲ್ಲಿ, ಪ್ರತಿ ಕರೆಯಲ್ಲೂ.",
  "onbHomeStartTitle": "ಕರೆ ಆರಂಭಿಸಿ ಅಥವಾ ಸೇರಿ",
  "onbHomeStartBody": "ನಿಮ್ಮ ಹೆಸರು ಮತ್ತು ಭಾಷೆ ಹೊಂದಿಸಿ, ನಂತರ ಕೋಣೆ ಕೋಡ್ ನಮೂದಿಸಿ ಹೊಸ ಕೋಣೆ ತೆರೆಯಿರಿ ಅಥವಾ ಸ್ನೇಹಿತರ ಕೋಣೆಗೆ ಸೇರಿ. ಕೋಣೆ ಪ್ರವೇಶಿಸಿ ಒತ್ತಿದರೆ ನೀವು ಒಳಗೆ.",
  "onbHomeTiersTitle": "ನಿಮ್ಮ ಭಾಷಾಂತರ ಶ್ರೇಣಿ ಆಯ್ಕೆಮಾಡಿ",
  "onbHomeTiersBody": "Standard ನಿಮಗೆ ಲೈವ್ ಉಪಶೀರ್ಷಿಕೆಗಳು ಮತ್ತು ಭಾಷಾಂತರಿತ ಧ್ವನಿಯನ್ನು ಕೈಗೆಟುಕುವ ದರದಲ್ಲಿ ನೀಡುತ್ತದೆ. ಮೇಲ್ದರ್ಜೆಯ ಶ್ರೇಣಿಗಳು ವೇಗವಾಗಿ ಮತ್ತು ಹೆಚ್ಚು ನಿಖರವಾಗಿ ಭಾಷಾಂತರಿಸುತ್ತವೆ. ಕರೆಗೆ ಮುನ್ನ ಯಾವಾಗ ಬೇಕಾದರೂ ಬದಲಾಯಿಸಿ.",
  "onbHomeCreditsTitle": "ನಿಮ್ಮ ಕ್ರೆಡಿಟ್‌ಗಳು",
  "onbHomeCreditsBody": "ಕರೆಗಳು ಪ್ರತಿ ಭಾಷಾಂತರ ಭಾಷೆಗೆ, ನಿಮಿಷಕ್ಕೆ ನಿಮ್ಮ ಬಾಕಿಯಿಂದ ಕಡಿತಗೊಳ್ಳುತ್ತವೆ. ಕ್ರೆಡಿಟ್‌ಗಳನ್ನು ಖರೀದಿಸಿ ಮೂಲಕ ಯಾವಾಗ ಬೇಕಾದರೂ ಸೇರಿಸಿ — ಬಾಕಿ ಯಾವಾಗಲೂ ಮೇಲ್ಭಾಗದಲ್ಲಿ ಕಾಣಿಸುತ್ತದೆ.",
  "onbHomeGuestTitle": "ನಿಮ್ಮ ಇತಿಹಾಸ ಉಳಿಸಲು ಸೈನ್ ಇನ್ ಮಾಡಿ",
  "onbHomeGuestBody": "ಈಗಲೇ ಅತಿಥಿಯಾಗಿ ಮಾತನಾಡಲು ಶುರುಮಾಡಿ. ಕರೆ ಇತಿಹಾಸ, ಲಿಪ್ಯಂತರಗಳು ಮತ್ತು ಕ್ರೆಡಿಟ್‌ಗಳನ್ನು ಎಲ್ಲಾ ಸಾಧನಗಳಲ್ಲಿ ಇರಿಸಿಕೊಳ್ಳಲು ಸೈನ್ ಇನ್ ಮಾಡಿ.",
  "wizWebinarTitle": "ಲೈವ್ ವೆಬಿನಾರ್ ಪ್ರಸಾರ ಮಾಡಿ",
  "wizWebinarBody": "ಲೈವ್ ವೆಬಿನಾರ್ ಆಯೋಜಿಸಿ ಮತ್ತು ನಿಮ್ಮ ಪ್ರೇಕ್ಷಕರಿಗೆ ಅದನ್ನು ತಮ್ಮದೇ ಭಾಷೆಯಲ್ಲಿ ರಿಯಲ್-ಟೈಮ್ ಅನುವಾದದೊಂದಿಗೆ ಅನುಸರಿಸಲು ಅವಕಾಶ ನೀಡಿ. ವೆಬಿನಾರ್ ರಚಿಸಲು ಸಕ್ರಿಯ Business ಅಥವಾ Enterprise ಚಂದಾದಾರಿಕೆ ಅಗತ್ಯವಿದೆ.",
  "onbHomeCtaTitle": "ನೀವು ಸಿದ್ಧವಾದಾಗ ನಾವೂ ಸಿದ್ಧ",
  "onbHomeCtaBody": "ಅಷ್ಟೇ ಪ್ರವಾಸ. ನಿಮ್ಮ ಭಾಷೆ ಹೊಂದಿಸಿ, ಕೋಣೆ ಆಯ್ಕೆಮಾಡಿ ಮತ್ತು ಹಲೋ ಹೇಳಿ. ಈ ಮಾರ್ಗದರ್ಶಿಯನ್ನು \"?\" ಬಟನ್‌ನಿಂದ ಯಾವಾಗ ಬೇಕಾದರೂ ಮತ್ತೆ ತೆರೆಯಿರಿ.",
  "onbHomeCtaButton": "ಮಾತನಾಡಲು ಆರಂಭಿಸಿ",
  "onbCallIntroTitle": "ಕರೆಗೆ ಸ್ವಾಗತ",
  "onbCallIntroBody": "ನಿಮ್ಮ ನಿಯಂತ್ರಣಗಳ ಸಂಕ್ಷಿಪ್ತ ಪ್ರವಾಸ ಇಲ್ಲಿದೆ. ನೀವು ಯಾವಾಗ ಬೇಕಾದರೂ ಬಿಟ್ಟುಬಿಡಬಹುದು.",
  "onbCallMicTitle": "ಮೈಕ್ರೊಫೋನ್",
  "onbCallMicBody": "ನಿಮ್ಮನ್ನು ಮ್ಯೂಟ್ ಮಾಡಿ ಮತ್ತು ಅನ್‌ಮ್ಯೂಟ್ ಮಾಡಿ. ನೀವು ಮಾತನಾಡಿದಾಗ, ನಿಮ್ಮ ಮಾತುಗಳನ್ನು ಲಿಪ್ಯಂತರಿಸಿ ಎಲ್ಲರಿಗೂ ಭಾಷಾಂತರಿಸಲಾಗುತ್ತದೆ.",
  "onbCallCamTitle": "ಕ್ಯಾಮೆರಾ",
  "onbCallCamBody": "ನಿಮ್ಮ ಕ್ಯಾಮೆರಾವನ್ನು ಆನ್ ಅಥವಾ ಆಫ್ ಮಾಡಿ. ಎರಡೂ ಸಂದರ್ಭದಲ್ಲೂ ನಿಮ್ಮ ಆಡಿಯೊ ನಿರಂತರ ಹರಿಯುತ್ತದೆ.",
  "onbCallCaptionsTitle": "ಲೈವ್ ಉಪಶೀರ್ಷಿಕೆಗಳು",
  "onbCallCaptionsBody": "ವೀಡಿಯೊ ಮೇಲೆ ಭಾಷಾಂತರಿತ ಉಪಶೀರ್ಷಿಕೆಗಳನ್ನು ತೋರಿಸಿ ಅಥವಾ ಮರೆಮಾಡಿ.",
  "onbCallVoiceTitle": "ಭಾಷಾಂತರಿತ ಧ್ವನಿ",
  "onbCallVoiceBody": "ಮಾತಿನ ಭಾಷಾಂತರವನ್ನು ಆನ್ ಅಥವಾ ಆಫ್ ಮಾಡಿ. ಎಲ್ಲರನ್ನೂ ನಿಮ್ಮ ಭಾಷೆಯಲ್ಲಿ ಕೇಳಲು ಇದನ್ನು ಆನ್ ಆಗಿ ಇರಿಸಿ.",
  "onbCallChatTitle": "ಚಾಟ್",
  "onbCallChatBody": "ಕೋಣೆಗೆ ಸಂದೇಶ ಕಳುಹಿಸಿ. ನೀವು ಟೈಪ್ ಮಾಡುವ ಎಲ್ಲವೂ ಪ್ರತಿಯೊಬ್ಬರಿಗೂ ಸ್ವಯಂ-ಭಾಷಾಂತರಗೊಳ್ಳುತ್ತದೆ.",
  "onbCallRoomTitle": "ಕೋಣೆ ಮತ್ತು ಭಾಷೆ",
  "onbCallRoomBody": "ಇದು ನಿಮ್ಮ ಕೋಣೆ ಕೋಡ್ ಮತ್ತು ನೀವು ಕೇಳುತ್ತಿರುವ ಭಾಷೆಯನ್ನು ತೋರಿಸುತ್ತದೆ. ಕೋಡ್ ನಕಲಿಸಿ ಹಂಚಿಕೊಳ್ಳಲು ಅದನ್ನು ಟ್ಯಾಪ್ ಮಾಡಿ.",
  "onbCallMoreTitle": "ಹೆಚ್ಚಿನ ಸಾಧನಗಳು",
  "onbCallMoreBody": "ಪರದೆ ಹಂಚಿಕೆ, ರೆಕಾರ್ಡಿಂಗ್, ವೈಟ್‌ಬೋರ್ಡ್, ಪ್ರತಿಕ್ರಿಯೆಗಳು ಮತ್ತು ಇನ್ನಷ್ಟು ಇಲ್ಲಿವೆ.",
  "onbCallShareTitle": "ನಿಮ್ಮ ಪರದೆ ಹಂಚಿಕೊಳ್ಳಿ",
  "onbCallShareBody": "ಕರೆಯಿಂದ ಹೊರಬರದೆ ಒಂದು ವಿಂಡೋ ಅಥವಾ ನಿಮ್ಮ ಇಡೀ ಪರದೆಯನ್ನು ಕೋಣೆಗೆ ತೋರಿಸಿ.",
  "onbCallInviteTitle": "ಜನರನ್ನು ಆಹ್ವಾನಿಸಿ",
  "onbCallInviteBody": "ಇತರರನ್ನು ಸೇರಿಸಲು ಆಹ್ವಾನ ಲಿಂಕ್ ನಕಲಿಸಿ ಅಥವಾ ಇಮೇಲ್ ಮೂಲಕ ಕಳುಹಿಸಿ.",
  "onbCallLeaveTitle": "ಕರೆಯಿಂದ ನಿರ್ಗಮಿಸಿ",
  "onbCallLeaveBody": "ಮುಗಿದಾಗ ಕರೆ ಕಡಿತಗೊಳಿಸಿ. ಲಿಪ್ಯಂತರಗಳು ಮತ್ತು ಡೌನ್‌ಲೋಡ್‌ಗಳೊಂದಿಗೆ ಸಾರಾಂಶ ನಿಮಗೆ ಸಿಗುತ್ತದೆ.",
  "onbCallDoneTitle": "ಎಲ್ಲವೂ ಸಿದ್ಧವಾಗಿದೆ",
  "onbCallDoneBody": "ಈ ಪ್ರವಾಸವನ್ನು \"?\" ಬಟನ್‌ನಿಂದ ಯಾವಾಗ ಬೇಕಾದರೂ ಮತ್ತೆ ತೆರೆಯಿರಿ. ಸಂಭಾಷಣೆ ಆನಂದಿಸಿ.",
