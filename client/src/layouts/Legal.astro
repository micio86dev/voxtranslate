---
// Shared chrome for the legal pages (Terms, Privacy, Acceptable Use).
import Base from './Base.astro';

interface Props {
  title: string;
  description?: string;
  updated?: string;
  version?: string;
}
const {
  title,
  description = `${title} for VoxTranslate — real-time video meetings with live AI translation.`,
  updated = '16 June 2026',
  version = '2026-06-16',
} = Astro.props;
---

<Base title={`${title} · VoxTranslate`} description={description}>
  <main class="legal">
    <a class="legal-back" href="/">← VoxTranslate</a>

    <header class="legal-header">
      <h1>{title}</h1>
      <p class="legal-meta">Last updated: {updated} · Version {version}</p>
    </header>

    <article class="legal-body">
      <slot />
    </article>

    <footer class="legal-footer-links">
      <a href="/terms">Terms</a> ·
      <a href="/privacy">Privacy</a> ·
      <a href="/acceptable-use">Acceptable Use</a>
    </footer>
  </main>

  <script>
    // Overlay backoffice-managed content if present; otherwise keep the bundled
    // copy rendered above (works offline / when the API is down).
    import { fetchLegal, renderMarkdown } from '../scripts/content';
    const slug = location.pathname.replace(/\//g, '');
    const _m = document.cookie.match(/(?:^|;\s*)vt_lang=([^;]+)/);
    const _cookie = _m ? decodeURIComponent(_m[1]) : null;
    const lang = (_cookie || navigator.language || 'en').slice(0, 2).toLowerCase();
    if (slug) {
      fetchLegal(slug, lang)
        .then((doc) => {
          if (!doc) return;
          const h1 = document.querySelector('.legal-header h1');
          const body = document.querySelector('.legal-body');
          const meta = document.querySelector('.legal-meta');
          if (h1 && doc.title) {
            h1.textContent = doc.title;
            document.title = `${doc.title} · VoxTranslate`;
          }
          // The managed version is the single source of truth for the date too, so a
          // published edit can never leave the header claiming an older policy than the
          // body below it. Rendered in the reader's language; a version string that
          // isn't a date just shows as-is.
          if (meta && doc.version) {
            const d = new Date(doc.version);
            const stamp = Number.isNaN(d.getTime())
              ? doc.version
              : d.toLocaleDateString(lang, { day: 'numeric', month: 'long', year: 'numeric' });
            meta.textContent = `Last updated: ${stamp} · Version ${doc.version}`;
          }
          if (body && doc.body) body.innerHTML = renderMarkdown(doc.body);
        })
        .catch(() => {});
    }
  </script>

  <style is:global>
    .legal {
      max-width: 760px;
      margin: 0 auto;
      padding: 32px 20px 64px;
    }
    .legal-back {
      display: inline-block;
      margin-bottom: 20px;
      color: var(--muted);
      text-decoration: none;
      font-size: 0.9rem;
    }
    .legal-back:hover { color: var(--text); }
    .legal-header h1 { font-size: 1.7rem; margin: 0 0 6px; }
    .legal-meta { color: var(--muted); font-size: 0.85rem; margin: 0 0 8px; }
    .legal-body { color: var(--text); }
    .legal-body h2 { font-size: 1.15rem; margin: 32px 0 10px; }
    .legal-body h3 { font-size: 1rem; margin: 22px 0 8px; }
    .legal-body p, .legal-body li { color: var(--text); font-size: 0.95rem; }
    .legal-body a { color: var(--accent); }
    .legal-body ul { padding-inline-start: 22px; }
    .legal-body li { margin: 6px 0; }
    .legal-body table {
      width: 100%;
      border-collapse: collapse;
      margin: 14px 0;
      font-size: 0.9rem;
    }
    .legal-body th, .legal-body td {
      border: 1px solid var(--border);
      padding: 8px 10px;
      text-align: start;
      vertical-align: top;
    }
    .legal-body th { background: var(--surface); color: var(--muted); font-weight: 600; }
    .legal-footer-links {
      margin-top: 48px;
      padding-top: 18px;
      border-top: 1px solid var(--border);
      text-align: center;
      color: var(--muted);
      font-size: 0.85rem;
    }
    .legal-footer-links a { color: var(--muted); text-decoration: underline; margin: 0 4px; }
    .legal-footer-links a:hover { color: var(--text); }
  </style>
</Base>
