---
const {
  title = 'VoxTranslate — Real-Time Video Meetings with Live Translation',
  // Site-wide fallback; every page should pass its own ~150-char description.
  description = 'Real-time video meetings with live AI voice translation and auto-translated chat. Speak your language, be understood in theirs — free, in your browser.',
  // Social-card image (Open Graph / Twitter). Override per page when relevant.
  image = '/icon.png',
  // Set true on pages that must not be indexed (e.g. 404).
  noindex = false,
} = Astro.props;

// Absolute URLs for canonical + social cards. Astro.site is the production
// origin (astro.config); Astro.url.pathname is this page's path at build time.
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(image, Astro.site);

// Warm the cross-origin API connection during HTML parse. The whole boot chain
// (files/config → content/i18n → auth/config) waits on a fresh DNS+TCP+TLS
// handshake to this origin; preconnecting it overlaps that cost with the CSS/JS
// download instead of paying it serially after boot() fires. Built from
// PUBLIC_WS_HOST (same source as HTTP_BASE in app.ts) — unset in local dev
// (same-origin), so we skip the hint there. crossorigin: the API fetches are
// anonymous CORS (Authorization header, no cookies), so the warmed connection
// matches their mode and is actually reused.
const wsHost = import.meta.env.PUBLIC_WS_HOST;
const apiOrigin = wsHost ? `https://${wsHost}` : null;

// Apple PWA startup images (splash screens). iOS/iPadOS Safari ignores the
// manifest background_color + theme_color for the launch screen — the ONLY way
// to brand the iOS launch is an exact-resolution apple-touch-startup-image per
// device, selected by a media query (device points + DPR + orientation). These
// apple-* tags are iOS-only; Android/Chrome ignores them and uses the manifest
// instead, so this is the custom-iOS / manifest-Android split by construction.
// Assets are generated by scripts/gen-ios-splash.py — brand blue (#0871ab) with
// the centred rounded app icon, matching the manifest background_color so there
// is no blue→black flash. Each entry is [width, height, dpr] in portrait points;
// the landscape variant swaps the pixel dimensions.
const appleSplash: [number, number, number][] = [
  [440, 956, 3], [402, 874, 3], [430, 932, 3], [393, 852, 3], [428, 926, 3],
  [390, 844, 3], [375, 812, 3], [414, 896, 3], [414, 896, 2], [414, 736, 3],
  [375, 667, 2], [320, 568, 2], [1032, 1376, 2], [1024, 1366, 2], [834, 1210, 2],
  [834, 1194, 2], [820, 1180, 2], [810, 1080, 2], [834, 1112, 2], [768, 1024, 2],
  [744, 1133, 2],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <!-- No maximum-scale: users must be able to zoom (WCAG 1.4.4). -->
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="dark" />

    <!-- Resource hints (kept early so connections warm during parse). -->
    {apiOrigin && <link rel="preconnect" href={apiOrigin} crossorigin />}
    {/* dns-prefetch fallback for browsers that skip a crossorigin preconnect (spec 0104). */}
    {apiOrigin && <link rel="dns-prefetch" href={apiOrigin} />}
    <!-- Google Sign-In is lazy-loaded on the login screen (the fresh-visitor
         landing in billing mode); a DNS hint trims its connection setup without
         the waste of a full preconnect on the signed-in (home) path. -->
    <link rel="dns-prefetch" href="https://accounts.google.com" />
    <link rel="dns-prefetch" href="https://fonts.gstatic.com" />

    <title>{title}</title>

    <!-- SEO -->
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />

    <!-- Open Graph (Facebook, LinkedIn, iMessage, Slack, …) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="VoxTranslate" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter / X card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />

    <!-- PWA -->
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#0871ab" />
    <!-- Tiny dedicated favicon (~2 KB) — the browser pulls rel=icon on every load, so it must
         NOT be the 238 KB social image. The large icon.png stays for og:image/twitter:image
         (off the critical path). apple-touch-icon is iOS home-screen only. (spec 0104) -->
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {/* Per-device iOS splash screens (see appleSplash above). */}
    {
      appleSplash.map(([dw, dh, dpr]) => {
        const pw = dw * dpr;
        const ph = dh * dpr;
        const mq = `screen and (device-width: ${dw}px) and (device-height: ${dh}px) and (-webkit-device-pixel-ratio: ${dpr})`;
        return (
          <Fragment>
            <link
              rel="apple-touch-startup-image"
              media={`${mq} and (orientation: portrait)`}
              href={`/splash/apple-splash-${pw}x${ph}.png`}
            />
            <link
              rel="apple-touch-startup-image"
              media={`${mq} and (orientation: landscape)`}
              href={`/splash/apple-splash-${ph}x${pw}.png`}
            />
          </Fragment>
        );
      })
    }
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="VoxTranslate" />
    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(() => {});
        });
      }
    </script>
  </head>
  <body>
    <slot />
    <style is:global>
      :root {
        --bg: #0a0b10;
        --surface: #13141c;
        --surface-2: #1a1b26;
        --surface-elevated: #1a1b26;
        --border: #252836;
        --text: #e2e4ec;
        /* ≥4.5:1 on --bg/--surface (the old #6b7089 was ~3.8:1, AA fail). */
        --muted: #8a90a8;
        --text-muted: #8a90a8;
        --accent: #3b82f6;
        /* Solid button background: white text on #3b82f6 is 3.7:1 (AA fail),
           on #2563eb it is 5.2:1. Keep --accent for text/borders on dark. */
        --accent-strong: #2563eb;
        --accent-dim: #1e3a8a;
        --accent-soft: rgba(59, 130, 246, 0.15);
        --rec: #ef4444;
        --danger: #ef4444;
        --success: #22c55e;
        --warning: #f59e0b;
        --radius: 12px;
        --radius-sm: 8px;
        --radius-md: 12px;
        --radius-lg: 16px;

        /* Typography scale (rem, relative to the 16px root). */
        --font-xs: 0.78rem;
        --font-sm: 0.85rem;
        --font-md: 0.95rem;
        --font-base: 1rem;
        --font-weight-medium: 500;
        --font-weight-semibold: 600;
        --font-weight-bold: 700;

        /* Interactive controls. */
        --tap-target: 44px; /* min hit area for taps (WCAG 2.5.5) */
        --btn-radius: 10px;
        --btn-radius-sm: 8px;
        --transition-fast: 0.15s;

        /* Ghost/secondary button: an accent-tonal wash over the surface with an
           accent-tinted border (spec 0034/0038 → strengthened in 0070 S5). The
           old flat fill read as disabled; the accent tint keeps it on-brand and
           obviously tappable, distinct from the muted :disabled state. */
        --btn-ghost-bg: color-mix(in srgb, var(--accent) 22%, var(--surface));
        --btn-ghost-bg-hover: color-mix(in srgb, var(--accent) 34%, var(--surface));
        --btn-ghost-border: color-mix(in srgb, var(--accent) 55%, var(--border));
      }

      * {
        box-sizing: border-box;
      }

      /* The `hidden` attribute must win over component `display` rules
         (e.g. avatar/mute-indicator/chat-badge toggled via el.hidden in JS). */
      [hidden] {
        display: none !important;
      }

      html,
      body {
        margin: 0;
        padding: 0;
        height: 100%;
      }

      body {
        background: var(--bg);
        color: var(--text);
        font-family: system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif;
        -webkit-font-smoothing: antialiased;
        line-height: 1.5;
      }

      button {
        font-family: inherit;
        cursor: pointer;
      }

      input,
      select {
        font-family: inherit;
      }

      /* ---- Button & control primitives ----
         Global (not page-scoped) so they style BOTH template-authored buttons
         and the ones built in JS (bookmark edit/delete, AI-tools report/sentiment/
         email forms). Page-level layout tweaks live in index.astro as scoped
         overrides, which always win on specificity. */
      .icon-btn {
        flex: none;
        font-size: 1.1rem;
        padding: 0 14px;
      }
      .btn-primary {
        width: 100%;
        min-height: 48px;
        background: var(--accent-strong);
        color: #fff;
        border: none;
        border-radius: var(--btn-radius);
        padding: 13px;
        font-size: var(--font-base);
        font-weight: var(--font-weight-semibold);
        transition: filter var(--transition-fast);
      }
      .btn-primary:hover {
        filter: brightness(1.08);
      }
      .btn-primary:active {
        transform: translateY(1px);
      }
      .btn-primary:disabled {
        background: var(--surface);
        color: var(--muted);
        border: 1px solid var(--border);
        cursor: not-allowed;
        filter: none;
        transform: none;
      }
      .btn-primary:disabled:hover {
        filter: none;
      }
      /* Loading spinner for any button mid async work: add class .btn-loading.
         Renders a spinning ring before the button's existing label and inherits
         its color (currentColor), so it needs no extra markup or copy. */
      @keyframes btn-spin { to { transform: rotate(360deg); } }
      .btn-loading::before {
        content: "";
        display: inline-block;
        width: 0.95em;
        height: 0.95em;
        margin-inline-end: 0.55em;
        vertical-align: -0.1em;
        border: 2px solid currentColor;
        border-top-color: transparent;
        border-radius: 50%;
        animation: btn-spin 0.7s linear infinite;
      }
      @media (prefers-reduced-motion: reduce) {
        .btn-loading::before { animation-duration: 1.8s; }
      }
      .btn-ghost {
        background: var(--btn-ghost-bg);
        border: 1px solid var(--btn-ghost-border);
        color: var(--text);
        border-radius: var(--btn-radius-sm);
        padding: 9px 13px;
        font-size: var(--font-sm);
        font-weight: var(--font-weight-medium);
        cursor: pointer;
        transition: background var(--transition-fast), border-color var(--transition-fast), transform 0.05s;
        white-space: nowrap;
      }
      .btn-ghost:hover {
        background: var(--btn-ghost-bg-hover);
        border-color: var(--accent);
      }
      .btn-ghost:active {
        transform: translateY(1px);
      }
      .btn-ghost:disabled {
        opacity: 0.4;
        cursor: not-allowed;
        background: var(--surface);
        border-color: var(--border);
        color: var(--muted);
      }
      .btn-ghost:disabled:hover {
        background: var(--surface);
        border-color: var(--border);
      }
      /* Icon-only buttons centre their glyph; declared after .btn-ghost so the
         ghost padding/font-size win for the common `btn-ghost icon-btn` pairing. */
      .icon-btn {
        display: grid;
        place-items: center;
      }
      .icon-btn .ico {
        width: 18px;
        height: 18px;
      }

      /* ---- Connection-status banner (net-status.ts, created on <body>) ----
         A small pill at the bottom: red offline, amber when the realtime
         transport is reconnecting, green flash on recovery. Backgrounds are the
         semantic colours darkened so white text clears AA (≥4.5:1). */
      .net-status {
        position: fixed;
        left: 50%;
        bottom: 24px;
        transform: translate(-50%, 18px);
        z-index: 90;
        display: flex;
        align-items: center;
        gap: 9px;
        max-width: min(92vw, 360px);
        padding: 9px 16px;
        border-radius: 999px;
        font-size: var(--font-sm);
        font-weight: var(--font-weight-medium);
        color: #fff;
        white-space: nowrap;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
        transition: opacity 0.3s, transform 0.3s, background-color 0.35s, border-color 0.35s;
      }
      .net-status.show {
        opacity: 1;
        visibility: visible;
        transform: translate(-50%, 0);
      }
      .net-status-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #fff;
        flex: none;
      }
      .net-status.net-offline {
        background: color-mix(in srgb, var(--danger) 80%, #000);
        border: 1px solid var(--danger);
      }
      .net-status.net-degraded {
        background: color-mix(in srgb, var(--warning) 64%, #000);
        border: 1px solid var(--warning);
      }
      .net-status.net-online {
        background: color-mix(in srgb, var(--success) 60%, #000);
        border: 1px solid var(--success);
      }
      /* Gentle pulse while a problem is live; the dot is steady once restored.
         (The global prefers-reduced-motion rule below stills it.) */
      .net-status.net-offline .net-status-dot,
      .net-status.net-degraded .net-status-dot {
        animation: net-status-pulse 1.4s ease-in-out infinite;
      }
      @keyframes net-status-pulse {
        0%,
        100% {
          opacity: 1;
        }
        50% {
          opacity: 0.35;
        }
      }

      ::selection {
        background: var(--accent);
        color: #fff;
      }

      /* Keyboard focus must always be visible (WCAG 2.4.7); --accent is ≥3:1
         against every surface in the palette (1.4.11). */
      :focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 2px;
      }

      /* Respect reduced-motion: kill pulse/wave/slide animations + transitions
         (WCAG 2.3.3). */
      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
          scroll-behavior: auto !important;
        }
      }
    </style>
  </body>
</html>
