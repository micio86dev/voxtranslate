---
import Base from '../../layouts/Base.astro';
import en from '../../scripts/i18n/en.json';
// Server-render the English default into every data-i18n slot so the page paints real
// text at FCP; applyI18n() localizes on the client when the active locale differs.
// Single source of truth: en.json (no drift). Same pattern as index.astro.
const T = (k: string): string => (en as Record<string, string>)[k] ?? '';
---

<Base
  title="Connect VoxTranslate for Chrome"
  description="Authorise the VoxTranslate Chrome extension to use your account."
  noindex={true}
>
  <main class="consent" data-i18n-label="extConnectTitle" aria-label="Connect VoxTranslate for Chrome">
    <header class="head">
      <div class="mark" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
             stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 2a3 3 0 0 1 3 3v6a3 3 0 0 1-6 0V5a3 3 0 0 1 3-3Z" />
          <path d="M19 10v1a7 7 0 0 1-14 0v-1M12 18v4" />
        </svg>
      </div>
      <h1 data-i18n="extConnectTitle">{T('extConnectTitle')}</h1>
    </header>

    <!-- Loading: a skeleton, not a spinner parked in the content well. -->
    <section id="state-loading" class="panel" aria-busy="true">
      <p class="sr-only" data-i18n="extConnectChecking">{T('extConnectChecking')}</p>
      <div class="skeleton" aria-hidden="true">
        <span class="sk sk-a"></span><span class="sk sk-b"></span><span class="sk sk-c"></span>
      </div>
    </section>

    <section id="state-signin" class="panel" hidden>
      <p class="lead" data-i18n="extConnectSigninBody">{T('extConnectSigninBody')}</p>
      <div class="actions">
        <a class="btn btn-primary" href="/" data-i18n="extConnectSigninCta">{T('extConnectSigninCta')}</a>
      </div>
      <p class="hint" data-i18n="extConnectSigninHint">{T('extConnectSigninHint')}</p>
    </section>

    <section id="state-confirm" class="panel" hidden>
      <!-- WHO is being connected leads. Consent without knowing the account is not
           consent, and it is the one thing a lookalike page cannot fake. -->
      <p class="account"><span id="who" class="who"></span></p>
      <p class="lead" data-i18n="extConnectLead">{T('extConnectLead')}</p>

      <!-- The scope list carries the trust. It used to be a grey paragraph of fine
           print, which is where users stop reading. Stated as concrete grants and,
           just as importantly, concrete limits. -->
      <ul class="scope grants">
        <li data-i18n="extConnectCan1">{T('extConnectCan1')}</li>
        <li data-i18n="extConnectCan2">{T('extConnectCan2')}</li>
      </ul>
      <ul class="scope limits">
        <li data-i18n="extConnectCant1">{T('extConnectCant1')}</li>
        <li data-i18n="extConnectCant2">{T('extConnectCant2')}</li>
      </ul>

      <!-- Allow is primary, Cancel is a real, equally reachable button — not a grey
           whisper. A consent screen that makes refusal harder than acceptance is a
           dark pattern, whatever it looks like. -->
      <div class="actions">
        <button id="deny" class="btn btn-ghost" type="button" data-i18n="extConnectCancel">{T('extConnectCancel')}</button>
        <button id="allow" class="btn btn-primary" type="button" data-i18n="extConnectAllow">{T('extConnectAllow')}</button>
      </div>
    </section>

    <section id="state-done" class="panel" hidden>
      <p class="lead done" data-i18n="extConnectDoneTitle">{T('extConnectDoneTitle')}</p>
      <p class="hint" data-i18n="extConnectDoneBody">{T('extConnectDoneBody')}</p>
    </section>

    <p id="error" class="error" role="alert" aria-live="assertive" hidden></p>
  </main>
</Base>

<style>
  /* Dark, on the app's own tokens. A consent screen that does not look like the product
     it is granting access to reads as a lookalike, so visual continuity is a security
     affordance here, not a preference. */
  .consent {
    max-width: 30rem;
    margin: 0 auto;
    padding: clamp(2rem, 8vh, 4.5rem) 1.25rem 3rem;
    color: var(--text);
  }

  .head {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    margin-bottom: 1.5rem;
  }
  .mark {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    flex: none;
    border-radius: var(--radius-sm);
    background: var(--accent-soft);
    color: var(--accent);
  }
  .mark svg { width: 1.15rem; height: 1.15rem; }
  h1 {
    margin: 0;
    font-size: 1.2rem;
    font-weight: var(--font-weight-semibold);
    letter-spacing: -0.01em;
  }

  .panel {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  /* The account line is the anchor: largest text on the screen after the title. */
  .account { margin: 0; }
  .who {
    font-size: 1.05rem;
    font-weight: var(--font-weight-semibold);
    color: var(--text);
    overflow-wrap: anywhere;
  }
  .lead {
    margin: 0;
    font-size: var(--font-md);
    line-height: 1.55;
    color: var(--text);
  }
  .lead.done { color: var(--success); font-weight: var(--font-weight-medium); }
  .hint {
    margin: 0;
    font-size: var(--font-sm);
    line-height: 1.5;
    color: var(--text-muted);
  }

  /* Grants and limits share a shape so they read as one list with two signs, rather
     than two unrelated blocks. The marker carries the meaning; colour only reinforces
     it, so this survives being read without colour perception. */
  .scope {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }
  .scope li {
    position: relative;
    padding-left: 1.6rem;
    font-size: var(--font-sm);
    line-height: 1.5;
    color: var(--text);
  }
  .scope li::before {
    position: absolute;
    left: 0;
    top: -0.02em;
    font-weight: var(--font-weight-bold);
  }
  .grants li::before { content: '+'; color: var(--success); }
  .limits li::before { content: '−'; color: var(--text-muted); }
  .limits li { color: var(--text-muted); }

  /* The literal ask: two actions on one baseline, same height, same shape. */
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 0.4rem;
  }
  .btn {
    flex: 1 1 auto;
    min-width: 8.5rem;
    min-height: var(--tap-target);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0 1.2rem;
    border-radius: var(--btn-radius);
    border: 1px solid transparent;
    font: inherit;
    font-size: var(--font-md);
    font-weight: var(--font-weight-semibold);
    cursor: pointer;
    text-decoration: none;
    transition:
      background-color var(--transition-fast) ease-out,
      border-color var(--transition-fast) ease-out;
  }
  .btn-primary { background: var(--accent); color: #fff; }
  .btn-primary:hover { background: var(--accent-strong); }
  .btn-ghost {
    background: transparent;
    color: var(--text);
    border-color: var(--border);
  }
  .btn-ghost:hover { border-color: var(--text-muted); }
  .btn:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .btn:disabled { opacity: 0.55; cursor: default; }

  .error {
    margin: 1.25rem 0 0;
    padding: 0.7rem 0.9rem;
    border: 1px solid var(--danger);
    border-radius: var(--radius-sm);
    color: var(--danger);
    font-size: var(--font-sm);
    line-height: 1.5;
  }

  .skeleton { display: flex; flex-direction: column; gap: 0.7rem; }
  .sk {
    height: 0.85rem;
    border-radius: 999px;
    background: var(--surface-elevated);
    animation: pulse 1.4s ease-in-out infinite;
  }
  .sk-a { width: 60%; }
  .sk-b { width: 90%; animation-delay: 0.12s; }
  .sk-c { width: 75%; animation-delay: 0.24s; }
  @keyframes pulse { 0%, 100% { opacity: 0.45; } 50% { opacity: 0.85; } }

  .sr-only {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .sk { animation: none; }
    .btn { transition: none; }
  }

  /* Under ~30rem the row would leave two cramped half-width buttons; stack them and
     keep Allow first under the thumb. */
  @media (max-width: 30rem) {
    .actions { flex-direction: column-reverse; }
    .btn { width: 100%; }
  }
</style>

<script>
  import { HTTP_BASE } from '../../scripts/auth';
  import { applyI18n, detectLang, loadLocale, setUiLang, t } from '../../scripts/i18n';

  /**
   * Extension login handoff.
   *
   * The extension opens this page through `chrome.identity.launchWebAuthFlow` with a
   * PKCE challenge. Using the session the user already has here, we ask the backend for
   * a short-lived code and hand it back on the redirect. The access token itself is
   * NEVER put in the URL — the extension exchanges the code for it over POST.
   */
  const params = new URLSearchParams(location.search);
  const challenge = params.get('code_challenge') ?? '';
  const method = params.get('code_challenge_method') ?? '';
  const state = params.get('state') ?? '';
  const redirectUri = params.get('redirect_uri') ?? '';

  const show = (id: string) => {
    for (const el of document.querySelectorAll<HTMLElement>('.panel')) el.hidden = true;
    const target = document.getElementById(id);
    if (target) target.hidden = false;
  };
  /** Surface a failure by i18n key, so an error is never the one English string left. */
  const fail = (key: string) => {
    const el = document.getElementById('error');
    if (el) {
      el.textContent = t(key);
      el.hidden = false;
    }
  };

  /**
   * Only ever redirect back to the extension's own callback origin. Without this check
   * a crafted link could send a valid code to an attacker-controlled URL.
   */
  function redirectAllowed(uri: string): boolean {
    try {
      const url = new URL(uri);
      return url.protocol === 'https:' && url.hostname.endsWith('.chromiumapp.org');
    } catch {
      return false;
    }
  }

  function token(): string | null {
    try {
      return localStorage.getItem('vox.token');
    } catch {
      return null;
    }
  }

  async function main() {
    // Localize before anything is shown: a consent screen the user cannot read is a
    // consent screen they cannot give.
    const lang = detectLang();
    setUiLang(lang);
    await loadLocale(lang);
    applyI18n();

    if (!challenge || method !== 'S256' || !state || !redirectUri) {
      show('state-loading');
      fail('extConnectErrParams');
      return;
    }
    if (!redirectAllowed(redirectUri)) {
      show('state-loading');
      fail('extConnectErrRedirect');
      return;
    }

    const session = token();
    if (!session) {
      show('state-signin');
      return;
    }

    // Confirm the session is still valid, and show WHO is being connected — consent
    // without knowing which account is not consent.
    try {
      const res = await fetch(`${HTTP_BASE}/api/user/me`, {
        headers: { Authorization: `Bearer ${session}` },
        cache: 'no-store',
      });
      if (!res.ok) {
        show('state-signin');
        return;
      }
      const me = (await res.json()) as { email?: string; name?: string };
      const who = document.getElementById('who');
      if (who) who.textContent = me.name || me.email || t('extConnectYourAccount');
    } catch {
      show('state-loading');
      fail('extConnectErrNetwork');
      return;
    }

    show('state-confirm');

    document.getElementById('deny')?.addEventListener('click', () => {
      location.replace(`${redirectUri}?error=access_denied&state=${encodeURIComponent(state)}`);
    });

    const allow = document.getElementById('allow') as HTMLButtonElement | null;
    allow?.addEventListener('click', () => {
      void (async () => {
        // Disable while in flight: a double click would burn the code and land the user
        // on an error they did nothing to cause.
        if (allow) allow.disabled = true;
        try {
          const res = await fetch(`${HTTP_BASE}/api/extension/code`, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              Authorization: `Bearer ${session}`,
            },
            body: JSON.stringify({
              code_challenge: challenge,
              code_challenge_method: 'S256',
            }),
          });
          if (!res.ok) {
            if (allow) allow.disabled = false;
            fail('extConnectErrRefused');
            return;
          }
          const { code } = (await res.json()) as { code: string };
          show('state-done');
          const target = new URL(redirectUri);
          target.searchParams.set('code', code);
          target.searchParams.set('state', state);
          location.replace(target.toString());
        } catch {
          if (allow) allow.disabled = false;
          fail('extConnectErrNetwork');
        }
      })();
    });
  }

  void main();
</script>
