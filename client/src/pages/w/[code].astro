---
// Webinar participant page (webinar phase 1, F1-5). A guest opens a shared link
// `/w/{code}` and watches the host's live, auto-translated broadcast.
//
// This route is rendered ON-DEMAND (`prerender = false`) — the whole rest of the app
// stays static. On-demand rendering lets us server-side fetch the webinar so the
// <title> and Open Graph tags reflect the real webinar title (a shared link must
// preview correctly on social / chat). A missing/cancelled code returns 404 and we
// render a friendly "not found" state. All playback + polling happens client-side in
// hls-player.ts (mounted below).
export const prerender = false;

import Base from '../../layouts/Base.astro';

const { code = '' } = Astro.params;

// Server-side API origin. In production PUBLIC_WS_HOST points at the API host; locally
// (unset) we skip the SSR fetch and let the client fetch same-origin at runtime.
const wsHost = import.meta.env.PUBLIC_WS_HOST;
const apiBase = wsHost ? `https://${wsHost}` : '';

interface PublicWebinar {
  code: string;
  title: string;
  status: 'scheduled' | 'live' | 'ended' | 'cancelled';
  source_language: string;
  tier: 'standard' | 'enhanced';
  join_url: string;
  playback_url: string | null;
  guest_id: string;
}

let webinar: PublicWebinar | null = null;
let notFound = false;

if (apiBase && code) {
  try {
    const res = await fetch(`${apiBase}/api/w/${encodeURIComponent(code)}`);
    if (res.ok) {
      webinar = (await res.json()) as PublicWebinar;
    } else if (res.status === 404) {
      notFound = true;
    }
    // Any other status (5xx / network): fall through with webinar=null; the client
    // player will retry the fetch and surface its own error/waiting state.
  } catch {
    // SSR fetch failed (API cold / unreachable) — render the shell and let the client
    // player fetch at runtime. Not a hard 404.
  }
}

if (notFound) {
  Astro.response.status = 404;
}

// SEO/meta: the real webinar title when known, a generic fallback otherwise. This
// page is never indexed (public but ephemeral, one row per broadcast).
const pageTitle = webinar
  ? `${webinar.title} · VoxTranslate`
  : 'Webinar · VoxTranslate';
const pageDesc = webinar
  ? `Join “${webinar.title}” on VoxTranslate — watch live, auto-translated into your own language.`
  : 'Watch a live, auto-translated webinar on VoxTranslate.';
---

<Base title={pageTitle} description={pageDesc} noindex={true}>
  <main class="wv" data-code={code} data-notfound={notFound ? '1' : '0'}>
    {
      notFound ? (
        <div class="wv-card">
          <div class="wv-glyph" aria-hidden="true">🌐</div>
          <h1 class="wv-title" data-i18n="wvNotFoundTitle">Webinar not found</h1>
          <p class="wv-text" data-i18n="wvNotFoundText">
            This webinar link is invalid or has been cancelled.
          </p>
          <a class="wv-btn" href="/" data-i18n="wvBackHome">Back to VoxTranslate</a>
        </div>
      ) : (
        <div class="wv-stage">
          <header class="wv-head">
            <h1 class="wv-heading">{webinar ? webinar.title : ''}</h1>
            <div class="wv-head-meta">
              <!-- Live audience count — hidden until the presence WS reports a value. -->
              <span id="wv-watching" class="wv-watching hidden" role="status" aria-live="polite">
                <span class="wv-watching-ico" aria-hidden="true"></span><span id="wv-watching-text"></span>
              </span>
              <span id="wv-status" class="wv-badge" role="status" data-i18n="wvStateWaiting">
                Waiting to start…
              </span>
            </div>
          </header>

          <div class="wv-video-wrap">
            <!-- `playsinline` is required for iOS to play inline (not fullscreen); the
                 muted default lets autoplay proceed under the browser audio policy. -->
            <video
              id="wv-video"
              class="wv-video"
              playsinline
              controls
              muted
              preload="none"
            ></video>

            <!-- Live subtitles overlay (Fase 2): the host's speech transcribed +
                 translated into the viewer's language, streamed over the presence WS. -->
            <div id="wv-subtitles" class="wv-subtitles" role="status" aria-live="polite"></div>

            <!-- Tap-to-start overlay: shown only when even muted autoplay was blocked. -->
            <button id="wv-tap" type="button" class="wv-tap hidden" data-i18n="wvTapToStart">
              Tap to start
            </button>

            <!-- Waiting / ended overlays (driven by the player state). -->
            <div id="wv-overlay-waiting" class="wv-overlay">
              <div class="wv-spinner" aria-hidden="true"></div>
              <p data-i18n="wvWaitingBody">The host hasn’t started yet. This page will start playing automatically.</p>
            </div>
            <div id="wv-overlay-ended" class="wv-overlay hidden">
              <div class="wv-glyph" aria-hidden="true">👋</div>
              <p data-i18n="wvEndedBody">This webinar has ended. Thanks for watching!</p>
              <a class="wv-btn" href="/" data-i18n="wvBackHome">Back to VoxTranslate</a>
            </div>
            <div id="wv-overlay-error" class="wv-overlay hidden">
              <div class="wv-glyph" aria-hidden="true">⚠️</div>
              <p data-i18n="wvErrorBody">We couldn’t load this webinar. Please refresh to try again.</p>
            </div>
          </div>

          <!-- Viewer controls (Fase 2): audio mute/unmute + "listen in the original
               language" + a captions on/off toggle. The video starts muted for autoplay;
               these let the guest opt into the host's audio and control subtitles. -->
          <div class="wv-controls">
            <button id="wv-mute" type="button" class="wv-ctl" aria-pressed="false" data-i18n="wvMuteAudio">
              Mute audio
            </button>
            <button id="wv-listen" type="button" class="wv-ctl" aria-pressed="false" data-i18n="wvListenOriginal">
              Listen in the original language
            </button>
            <button id="wv-cc" type="button" class="wv-ctl" aria-pressed="true" data-i18n="wvSubtitlesOn">
              Subtitles on
            </button>
            <!-- Chat show/hide toggle (Feature ⑤). Hidden until the view controller confirms
                 the webinar has chat enabled; then it reveals + toggles the panel below. -->
            <button id="wv-chat-toggle" type="button" class="wv-ctl hidden" aria-pressed="false" aria-controls="wv-chat" data-i18n="wvChatShow">
              Show chat
            </button>
          </div>

          <!-- Auto-translated chat panel (Feature ⑤). Everyone sends; everyone reads each
               message translated into their own language. Collapsed + hidden until enabled
               and the guest taps "Show chat". The list has aria-live=polite so new messages
               are announced; the input row is reachable above the mobile keyboard. -->
          <section id="wv-chat" class="wv-chat hidden" aria-label="Chat">
            <div id="wv-chat-list" class="wv-chat-list" role="log" aria-live="polite" aria-relevant="additions"></div>
            <!-- One-time display-name prompt for a guest who hasn't chosen a name yet. -->
            <div id="wv-chat-name" class="wv-chat-name hidden">
              <label class="wv-chat-name-label" for="wv-chat-name-input" data-i18n="wvChatNamePrompt">Choose a display name to chat</label>
              <div class="wv-chat-name-row">
                <input id="wv-chat-name-input" class="wv-chat-name-input" type="text" maxlength="40" autocomplete="off" data-i18n-ph="wvChatNamePlaceholder" placeholder="Your name" />
                <button id="wv-chat-name-save" type="button" class="wv-chat-send" data-i18n="wvChatSend">Send</button>
              </div>
            </div>
            <form id="wv-chat-form" class="wv-chat-form">
              <input id="wv-chat-input" class="wv-chat-input" type="text" maxlength="500" autocomplete="off" enterkeyhint="send" data-i18n-ph="wvChatPlaceholder" placeholder="Type a message…" />
              <button id="wv-chat-send" type="submit" class="wv-chat-send" data-i18n="wvChatSend">Send</button>
            </form>
            <p id="wv-chat-notice" class="wv-chat-notice hidden" role="status" aria-live="polite"></p>
          </section>
        </div>
      )
    }
  </main>

  <script>
    import { mountWebinarPlayer } from '../../scripts/webinar-view';
    mountWebinarPlayer();
  </script>

  <style>
    .wv {
      min-height: 100dvh;
      display: grid;
      place-items: center;
      padding: 16px;
      background:
        radial-gradient(1200px 600px at 50% -10%, rgba(59, 130, 246, 0.18), transparent 60%),
        var(--bg);
    }
    .wv-card {
      text-align: center;
      max-width: 460px;
      width: 100%;
    }
    .wv-glyph {
      font-size: 3rem;
      margin-bottom: 12px;
    }
    .wv-title {
      font-size: 1.5rem;
      margin: 0 0 8px;
    }
    .wv-text {
      color: var(--text-muted, #9aa4b2);
      margin: 0 0 20px;
    }
    .wv-btn {
      display: inline-block;
      padding: 12px 20px;
      border-radius: 10px;
      background: var(--accent, #3b82f6);
      color: #fff;
      text-decoration: none;
      font-weight: 600;
    }
    .wv-stage {
      width: 100%;
      max-width: 960px;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }
    .wv-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      flex-wrap: wrap;
    }
    .wv-head-meta {
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .wv-heading {
      font-size: 1.3rem;
      margin: 0;
    }
    .wv-watching {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 0.82rem;
      font-weight: 600;
      padding: 4px 12px;
      border-radius: 999px;
      background: var(--surface, #1b2330);
      border: 1px solid var(--border, #2a3444);
      color: var(--text-muted, #9aa4b2);
    }
    .wv-watching.hidden {
      display: none;
    }
    .wv-watching-ico {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: currentColor;
      opacity: 0.7;
    }
    .wv-badge {
      font-size: 0.82rem;
      font-weight: 600;
      padding: 4px 12px;
      border-radius: 999px;
      background: var(--surface, #1b2330);
      border: 1px solid var(--border, #2a3444);
      color: var(--text-muted, #9aa4b2);
    }
    .wv-badge.is-live {
      background: rgba(239, 68, 68, 0.15);
      border-color: rgba(239, 68, 68, 0.5);
      color: #f87171;
    }
    .wv-video-wrap {
      position: relative;
      width: 100%;
      aspect-ratio: 16 / 9;
      background: #000;
      border-radius: 14px;
      overflow: hidden;
    }
    .wv-video {
      width: 100%;
      height: 100%;
      object-fit: contain;
      background: #000;
    }
    .wv-overlay {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 14px;
      padding: 24px;
      text-align: center;
      color: #e5e7eb;
      background: rgba(0, 0, 0, 0.55);
      backdrop-filter: blur(2px);
    }
    .wv-overlay.hidden {
      display: none;
    }
    .wv-tap {
      position: absolute;
      inset: 0;
      display: grid;
      place-items: center;
      font-size: 1.1rem;
      font-weight: 700;
      color: #fff;
      background: rgba(0, 0, 0, 0.5);
      border: none;
      cursor: pointer;
    }
    .wv-tap.hidden {
      display: none;
    }
    /* Live-subtitle overlay: a caption band along the bottom of the video. Empty until
       the first frame; pointer-events off so it never blocks the video controls. */
    .wv-subtitles {
      position: absolute;
      left: 0;
      right: 0;
      bottom: 8px;
      display: flex;
      justify-content: center;
      padding: 0 16px;
      pointer-events: none;
      z-index: 2;
    }
    /* The subtitle box + line spans are created at runtime by subtitle-render.ts, so their
       classes must be :global (Astro's scoping can't reach JS-created nodes). */
    .wv-subtitles :global(.subtitle) {
      display: inline-flex;
      flex-direction: column;
      gap: 2px;
      max-width: 90%;
      padding: 6px 12px;
      border-radius: 8px;
      background: rgba(0, 0, 0, 0.68);
      color: #fff;
      text-align: center;
      text-shadow: 0 1px 2px rgba(0, 0, 0, 0.6);
      line-height: 1.35;
    }
    .wv-subtitles :global(.subtitle-interim) {
      opacity: 0.75;
    }
    .wv-subtitles :global(.subtitle-translation) {
      font-size: 1rem;
      font-weight: 600;
    }
    .wv-subtitles :global(.subtitle-original) {
      font-size: 0.82rem;
      opacity: 0.8;
    }
    /* Viewer controls row (audio + captions). */
    .wv-controls {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      justify-content: center;
    }
    .wv-ctl {
      font-size: 0.85rem;
      font-weight: 600;
      padding: 8px 14px;
      border-radius: 999px;
      background: var(--surface, #1b2330);
      border: 1px solid var(--border, #2a3444);
      color: var(--text, #e5e7eb);
      cursor: pointer;
    }
    .wv-ctl:hover {
      border-color: var(--accent, #3b82f6);
    }
    /* Pressed state (audio on / captions on) — a subtle accent tint. */
    .wv-ctl[aria-pressed='true'] {
      background: rgba(59, 130, 246, 0.15);
      border-color: rgba(59, 130, 246, 0.5);
      color: #93c5fd;
    }
    /* Auto-translated chat panel (Feature ⑤). Mobile-first: a bounded, scrollable message
       list with a sticky input row that clears the on-screen keyboard via the safe-area
       inset. Tap targets are >=44px; motion respects prefers-reduced-motion. */
    .wv-chat {
      display: flex;
      flex-direction: column;
      gap: 10px;
      width: 100%;
      max-width: 960px;
      margin: 0 auto;
      padding: 12px;
      border-radius: 14px;
      background: var(--surface, #1b2330);
      border: 1px solid var(--border, #2a3444);
    }
    .wv-chat.hidden {
      display: none;
    }
    .wv-chat-list {
      display: flex;
      flex-direction: column;
      gap: 8px;
      min-height: 120px;
      max-height: 40vh;
      overflow-y: auto;
      overscroll-behavior: contain;
      -webkit-overflow-scrolling: touch;
      scroll-behavior: smooth;
      padding-right: 4px;
    }
    /* One message row: a colored name + the translated body. Host messages are tinted. */
    .wv-chat-msg {
      display: flex;
      flex-direction: column;
      gap: 2px;
      padding: 8px 10px;
      border-radius: 10px;
      background: rgba(255, 255, 255, 0.03);
      line-height: 1.35;
      word-break: break-word;
    }
    .wv-chat-msg.is-host {
      background: rgba(59, 130, 246, 0.12);
      border: 1px solid rgba(59, 130, 246, 0.35);
    }
    .wv-chat-name-line {
      font-size: 0.78rem;
      font-weight: 700;
      color: var(--text-muted, #9aa4b2);
    }
    .wv-chat-msg.is-host .wv-chat-name-line {
      color: #93c5fd;
    }
    .wv-chat-host-tag {
      font-size: 0.68rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      margin-left: 6px;
      padding: 1px 6px;
      border-radius: 999px;
      background: rgba(59, 130, 246, 0.25);
      color: #bfdbfe;
    }
    .wv-chat-body {
      font-size: 0.95rem;
      color: var(--text, #e5e7eb);
    }
    .wv-chat-empty {
      margin: auto;
      padding: 16px;
      text-align: center;
      font-size: 0.85rem;
      color: var(--text-muted, #9aa4b2);
    }
    /* Input row + one-time name row: reachable above the mobile keyboard. */
    .wv-chat-form,
    .wv-chat-name-row {
      display: flex;
      gap: 8px;
      padding-bottom: env(safe-area-inset-bottom, 0);
    }
    .wv-chat-name {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }
    .wv-chat-name.hidden {
      display: none;
    }
    .wv-chat-name-label {
      font-size: 0.85rem;
      font-weight: 600;
      color: var(--text-muted, #9aa4b2);
    }
    .wv-chat-input,
    .wv-chat-name-input {
      flex: 1 1 auto;
      min-width: 0;
      min-height: 44px;
      padding: 0 14px;
      font-size: 1rem;
      border-radius: 10px;
      background: var(--bg, #0d0f16);
      border: 1px solid var(--border, #2a3444);
      color: var(--text, #e5e7eb);
    }
    .wv-chat-input:focus,
    .wv-chat-name-input:focus {
      outline: 2px solid var(--accent, #3b82f6);
      outline-offset: 1px;
    }
    .wv-chat-send {
      flex: 0 0 auto;
      min-height: 44px;
      min-width: 44px;
      padding: 0 18px;
      font-size: 0.9rem;
      font-weight: 700;
      border-radius: 10px;
      border: none;
      background: var(--accent, #3b82f6);
      color: #fff;
      cursor: pointer;
    }
    .wv-chat-send:disabled {
      opacity: 0.55;
      cursor: default;
    }
    .wv-chat-notice {
      margin: 0;
      font-size: 0.82rem;
      font-weight: 600;
      color: #f87171;
    }
    .wv-chat-notice.hidden {
      display: none;
    }
    .wv-spinner {
      width: 42px;
      height: 42px;
      border-radius: 50%;
      border: 3px solid rgba(255, 255, 255, 0.25);
      border-top-color: #fff;
      animation: wv-spin 0.9s linear infinite;
    }
    @keyframes wv-spin {
      to {
        transform: rotate(360deg);
      }
    }
    /* Respect reduced-motion: freeze the spinner + drop smooth chat auto-scroll (WCAG 2.3.3). */
    @media (prefers-reduced-motion: reduce) {
      .wv-spinner {
        animation: none;
      }
      .wv-chat-list {
        scroll-behavior: auto;
      }
    }
  </style>
</Base>
