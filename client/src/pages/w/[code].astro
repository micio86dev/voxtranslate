---
// Webinar participant page (webinar phase 1, F1-5). A guest opens a shared link
// `/w/{code}` and watches the host's live, auto-translated broadcast.
//
// This route is rendered ON-DEMAND (`prerender = false`) — the whole rest of the app
// stays static. On-demand rendering lets us server-side fetch the webinar so the
// <title> and Open Graph tags reflect the real webinar title (a shared link must
// preview correctly on social / chat). A missing/cancelled code returns 404 and we
// render a friendly "not found" state. All playback + polling happens client-side in
// hls-player.ts (mounted below).
export const prerender = false;

import Base from '../../layouts/Base.astro';

const { code = '' } = Astro.params;

// Server-side API origin. In production PUBLIC_WS_HOST points at the API host; locally
// (unset) we skip the SSR fetch and let the client fetch same-origin at runtime.
const wsHost = import.meta.env.PUBLIC_WS_HOST;
const apiBase = wsHost ? `https://${wsHost}` : '';

interface PublicWebinar {
  code: string;
  title: string;
  status: 'scheduled' | 'live' | 'ended' | 'cancelled';
  source_language: string;
  tier: 'standard' | 'enhanced';
  join_url: string;
  playback_url: string | null;
  guest_id: string;
  members_only: boolean;
  actual_start?: string | null;
  scheduled_end?: string | null;
}

let webinar: PublicWebinar | null = null;
let notFound = false;

if (apiBase && code) {
  try {
    const res = await fetch(`${apiBase}/api/w/${encodeURIComponent(code)}`);
    if (res.ok) {
      webinar = (await res.json()) as PublicWebinar;
    } else if (res.status === 404) {
      notFound = true;
    }
    // Any other status (5xx / network): fall through with webinar=null; the client
    // player will retry the fetch and surface its own error/waiting state.
  } catch {
    // SSR fetch failed (API cold / unreachable) — render the shell and let the client
    // player fetch at runtime. Not a hard 404.
  }
}

if (notFound) {
  Astro.response.status = 404;
}

// SEO/meta: the real webinar title when known, a generic fallback otherwise. This
// page is never indexed (public but ephemeral, one row per broadcast).
const pageTitle = webinar
  ? `${webinar.title} · VoxTranslate`
  : 'Webinar · VoxTranslate';
const pageDesc = webinar
  ? `Join “${webinar.title}” on VoxTranslate — watch live, auto-translated into your own language.`
  : 'Watch a live, auto-translated webinar on VoxTranslate.';
---

<Base title={pageTitle} description={pageDesc} noindex={true}>
  <main class="wv" data-code={code} data-notfound={notFound ? '1' : '0'} data-members-only={webinar?.members_only ? '1' : '0'}>
    {
      notFound ? (
        <div class="wv-card">
          <div class="wv-glyph" aria-hidden="true">🌐</div>
          <h1 class="wv-title" data-i18n="wvNotFoundTitle">Webinar not found</h1>
          <p class="wv-text" data-i18n="wvNotFoundText">
            This webinar link is invalid or has been cancelled.
          </p>
          <a class="wv-btn" href="/" data-i18n="wvBackHome">Back to VoxTranslate</a>
        </div>
      ) : (
        <div class="wv-stage">
          <!-- Pre-webinar name gate: shown only to guests who have no stored display name.
               webinar-view.ts shows it immediately and hides it on submit. Guests who
               already have a name (returning visitors) never see this overlay. -->
          <div id="wv-name-gate" class="wv-name-gate hidden">
            <div class="wv-name-gate-card">
              <p class="wv-name-gate-label" data-i18n="wvChatNamePrompt">Choose a display name to chat</p>
              <div class="wv-name-gate-row">
                <input id="wv-name-gate-input" class="wv-name-gate-input" type="text" maxlength="40"
                       autocomplete="nickname" enterkeyhint="go"
                       data-i18n-ph="wvChatNamePlaceholder" placeholder="Your name" />
                <button id="wv-name-gate-save" type="button" class="wv-btn" data-i18n="wvChatSend">Send</button>
              </div>
            </div>
          </div>

          <header class="wv-head">
            <h1 class="wv-heading">{webinar ? webinar.title : ''}</h1>
            <div class="wv-head-meta">
              <!-- Live audience count — hidden until the presence WS reports a value. -->
              <span id="wv-watching" class="wv-watching hidden" role="status" aria-live="polite">
                <span class="wv-watching-ico" aria-hidden="true"></span><span id="wv-watching-text"></span>
              </span>
              <!-- Live timer — hidden until the webinar is live. Counts up (elapsed) by
                   default; clicking toggles to a countdown when the webinar has a
                   scheduled end (no-op otherwise). Styled like a clickable .wv-badge. -->
              <button id="wv-timer" type="button" class="wv-timer hidden" role="status" aria-live="off"></button>
              <span id="wv-status" class="wv-badge" role="status" data-i18n="wvStateWaiting">
                Waiting to start…
              </span>
            </div>
          </header>

          <div class="wv-video-wrap">
            <!-- `playsinline` is required for iOS to play inline (not fullscreen).
                 No `muted` — tryAutoplay() attempts unmuted first; it falls back to
                 muted + tap-to-unmute overlay when the browser blocks unmuted autoplay.
                 No `controls` — we render our own control bar below.
                 preload="auto" (not "none"): the src is only set once the webinar is
                 live (in attach()), and on iOS/Safari native HLS preload="none" defers
                 loading until a play() gesture — so canplay never fires, autoplay is
                 gated, and viewers get a stuck/black player. Auto lets it buffer + play. -->
            <video
              id="wv-video"
              class="wv-video"
              playsinline
              preload="auto"
            ></video>

            <!-- Live subtitles overlay (Fase 2): the host's speech transcribed +
                 translated into the viewer's language, streamed over the presence WS. -->
            <div id="wv-subtitles" class="wv-subtitles" role="status" aria-live="polite"></div>

            <!-- Tap-to-start overlay: shown only when even muted autoplay was blocked. -->
            <button id="wv-tap" type="button" class="wv-tap hidden" data-i18n="wvTapToStart">
              Tap to start
            </button>

            <!-- Primary start CTA: shown once the webinar is live. Clicking it is the
                 user gesture that reliably starts playback (autoplay is blocked until
                 then) and activates the translated audio when a translation is available. -->
            <button id="wv-cta" type="button" class="wv-cta hidden" data-i18n="wvJoinWebinar">
              Join webinar
            </button>

            <!-- Waiting / ended overlays (driven by the player state). -->
            <div id="wv-overlay-waiting" class="wv-overlay">
              <!-- Host avatar shown when available (043); falls back to spinner for
                   webinars without one or while the avatar hasn’t loaded yet. -->
              <img id="wv-host-avatar" class="wv-host-avatar hidden" alt="" aria-hidden="true" />
              <div id="wv-waiting-spinner" class="wv-spinner" aria-hidden="true"></div>
              <p data-i18n="wvWaitingBody">The host hasn’t started yet. This page will start playing automatically.</p>
            </div>
            <div id="wv-overlay-ended" class="wv-overlay hidden">
              <div class="wv-glyph" aria-hidden="true">👋</div>
              <p data-i18n="wvEndedBody">This webinar has ended. Thanks for watching!</p>
              <a class="wv-btn" href="/" data-i18n="wvBackHome">Back to VoxTranslate</a>
            </div>
            <div id="wv-overlay-error" class="wv-overlay hidden">
              <div class="wv-glyph" aria-hidden="true">⚠️</div>
              <p data-i18n="wvErrorBody">We couldn’t load this webinar. Please refresh to try again.</p>
            </div>
            <!-- Members-only overlay: shown when the webinar requires login and the user is not authenticated. -->
            <div id="wv-overlay-members-only" class="wv-overlay hidden">
              <div class="wv-card">
                <div class="wv-glyph" aria-hidden="true">🔒</div>
                <h2 class="wv-title" data-i18n="wvMembersOnlyTitle">Members only</h2>
                <p class="wv-text" data-i18n="wvMembersOnlyText">
                  Log in to join this webinar.
                </p>
                <a class="wv-btn" href="/" data-i18n="wvMembersOnlyLogin">Log in</a>
              </div>
            </div>
          </div>

          <!-- Viewer controls (Fase 2): two independent audio buttons + a captions toggle.
               wv-mute  = on/off toggle (aria-pressed=true when audio is active).
               wv-listen = audio-source selector; toggles original HLS audio on/off;
                           Fase 3 will extend it to switch between original and TTS audio.
               wv-listen is hidden (via onInfo) when host and viewer speak the same language. -->
          <div class="wv-controls">
            <button id="wv-mute" type="button" class="wv-ctl" aria-pressed="false">
              <span class="wv-ctl-ico" aria-hidden="true">🔊</span>
              <span class="wv-ctl-label" data-i18n="wvMuteAudio">Mute audio</span>
            </button>
            <button id="wv-listen" type="button" class="wv-ctl hidden" aria-pressed="false">
              <span class="wv-ctl-ico" aria-hidden="true">🌐</span>
              <span class="wv-ctl-label" data-i18n="wvListenTranslated">Listen translated</span>
            </button>
            <button id="wv-cc" type="button" class="wv-ctl" aria-pressed="true">
              <span class="wv-ctl-ico wv-cc-badge" aria-hidden="true">CC</span>
              <span class="wv-ctl-label" data-i18n="wvSubtitlesOn">Subtitles on</span>
            </button>
            <!-- Transcript history toggle. Always shown; collapses the history panel. -->
            <button id="wv-transcript-toggle" type="button" class="wv-ctl" aria-pressed="false" aria-controls="wv-transcript">
              <span class="wv-ctl-ico" aria-hidden="true">📄</span>
              <span class="wv-ctl-label" data-i18n="wvTranscriptShow">Show transcript</span>
            </button>
            <!-- Chat show/hide toggle (Feature ⑤). Hidden until the view controller confirms
                 the webinar has chat enabled; then it reveals + toggles the panel below. -->
            <button id="wv-chat-toggle" type="button" class="wv-ctl hidden" aria-pressed="false" aria-controls="wv-chat">
              <span class="wv-ctl-ico" aria-hidden="true">💬</span>
              <span class="wv-ctl-label" data-i18n="wvChatShow">Show chat</span>
              <span id="wv-chat-badge" class="chat-unread-badge hidden" aria-hidden="true"></span>
            </button>
          </div>

          <!-- Transcript history panel: shows final subtitle lines with timestamps.
               Open by default; the toggle button hides/reveals it. -->
          <section id="wv-transcript" class="wv-transcript" aria-label="Transcript">
            <div id="wv-transcript-list" class="wv-tr-list" role="log" aria-live="polite" aria-relevant="additions"></div>
            <p id="wv-transcript-empty" class="wv-tr-empty" data-i18n="wvTranscriptEmpty">No subtitles yet.</p>
          </section>

          <!-- Auto-translated chat panel (Feature ⑤). Everyone sends; everyone reads each
               message translated into their own language. Collapsed + hidden until enabled
               and the guest taps "Show chat". The list has aria-live=polite so new messages
               are announced; the input row is reachable above the mobile keyboard. -->
          <section id="wv-chat" class="wv-chat hidden" aria-label="Chat">
            <div id="wv-chat-list" class="wv-chat-list" role="log" aria-live="polite" aria-relevant="additions"></div>
            <!-- One-time display-name prompt for a guest who hasn't chosen a name yet. -->
            <div id="wv-chat-name" class="wv-chat-name hidden">
              <label class="wv-chat-name-label" for="wv-chat-name-input" data-i18n="wvChatNamePrompt">Choose a display name to chat</label>
              <div class="wv-chat-name-row">
                <input id="wv-chat-name-input" class="wv-chat-name-input" type="text" maxlength="40" autocomplete="off" data-i18n-ph="wvChatNamePlaceholder" placeholder="Your name" />
                <button id="wv-chat-name-save" type="button" class="wv-chat-send" data-i18n="wvChatSend">Send</button>
              </div>
            </div>
            <!-- Upload progress bar (hidden while no upload is in flight). -->
            <div id="wv-chat-upload" class="wv-chat-upload hidden">
              <div id="wv-chat-upload-fill" class="wv-chat-upload-fill"></div>
            </div>
            <div id="wv-attach-preview" class="wv-attach-preview hidden" role="status" aria-live="polite"></div>
            <form id="wv-chat-form" class="wv-chat-form">
              <div class="chat-input-row">
                <textarea id="wv-chat-input" class="wv-chat-input" maxlength="500" rows="1" autocomplete="off" enterkeyhint="send" data-i18n-ph="wvChatPlaceholder" placeholder="Type a message…"></textarea>
                <div class="chat-input-actions">
                  <div class="emoji-picker-wrap">
                    <button id="wv-emoji-toggle" type="button" class="btn-ghost icon-btn emoji-btn" aria-label="Emoji" aria-expanded="false" aria-controls="wv-emoji-panel">😀</button>
                    <div id="wv-emoji-panel" class="emoji-panel hidden" role="group" aria-label="Emoji"></div>
                  </div>
                  <button id="wv-chat-attach" type="button" class="btn-ghost icon-btn attach-btn" aria-label="Attach file">📎</button>
                  <input id="wv-chat-file" type="file" hidden accept="image/*,.pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.txt,.csv" />
                  <button id="wv-chat-send" type="submit" class="btn-primary send-btn" data-i18n="wvChatSend">Send</button>
                </div>
              </div>
              <div id="wv-chat-counter" class="chat-counter" aria-live="polite">0/500</div>
            </form>
            <p id="wv-chat-notice" class="wv-chat-notice hidden" role="status" aria-live="polite"></p>
          </section>
        </div>
      )
    }
  </main>

  <script>
    import { mountWebinarPlayer } from '../../scripts/webinar-view';
    mountWebinarPlayer();
  </script>

  <style>
    .wv {
      min-height: 100dvh;
      display: grid;
      /* Center horizontally, but top-align vertically: when the stacked content
         (video + transcript + chat) grows taller than the viewport — e.g. on
         mobile with both panels open — the document extends downward and scrolls
         in Y, instead of centering the overflow and clipping the chat input off
         the bottom edge. */
      justify-items: center;
      align-items: start;
      padding: 16px;
      background:
        radial-gradient(1200px 600px at 50% -10%, rgba(59, 130, 246, 0.18), transparent 60%),
        var(--bg);
    }
    .wv-card {
      text-align: center;
      max-width: 460px;
      width: 100%;
    }
    .wv-glyph {
      font-size: 3rem;
      margin-bottom: 12px;
    }
    .wv-title {
      font-size: 1.5rem;
      margin: 0 0 8px;
    }
    .wv-text {
      color: var(--text-muted, #9aa4b2);
      margin: 0 0 20px;
    }
    .wv-btn {
      display: inline-block;
      padding: 12px 20px;
      border-radius: 10px;
      background: var(--accent, #3b82f6);
      color: #fff;
      text-decoration: none;
      font-weight: 600;
    }
    /* Pre-webinar name gate — shown full-screen before the webinar if the guest has
       no stored display name. Hides the webinar behind it until the name is submitted. */
    .wv-name-gate {
      position: fixed;
      inset: 0;
      z-index: 50;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
      background: var(--bg, #0d0f16);
    }
    .wv-name-gate.hidden {
      display: none;
    }
    .wv-name-gate-card {
      display: flex;
      flex-direction: column;
      gap: 16px;
      padding: 28px 24px;
      border-radius: 16px;
      background: var(--surface, #1b2330);
      border: 1px solid var(--border, #2a3444);
      width: 100%;
      max-width: 360px;
    }
    .wv-name-gate-label {
      font-size: 0.95rem;
      font-weight: 600;
      color: var(--text, #e5e7eb);
      margin: 0;
      text-align: center;
    }
    .wv-name-gate-row {
      display: flex;
      gap: 8px;
    }
    .wv-name-gate-input {
      flex: 1 1 auto;
      min-width: 0;
      min-height: 44px;
      padding: 0 14px;
      font-size: 1rem;
      font-family: inherit;
      border-radius: 10px;
      background: var(--bg, #0d0f16);
      border: 1px solid var(--border, #2a3444);
      color: var(--text, #e5e7eb);
    }
    .wv-name-gate-input:focus {
      outline: 2px solid var(--accent, #3b82f6);
      outline-offset: 1px;
    }
    .wv-stage {
      width: 100%;
      max-width: 960px;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }
    .wv-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      flex-wrap: wrap;
    }
    .wv-head-meta {
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .wv-heading {
      font-size: 1.3rem;
      margin: 0;
    }
    .wv-watching {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 0.82rem;
      font-weight: 600;
      padding: 4px 12px;
      border-radius: 999px;
      background: var(--surface, #1b2330);
      border: 1px solid var(--border, #2a3444);
      color: var(--text-muted, #9aa4b2);
    }
    .wv-watching.hidden {
      display: none;
    }
    .wv-watching-ico {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: currentColor;
      opacity: 0.7;
    }
    .wv-badge {
      font-size: 0.82rem;
      font-weight: 600;
      padding: 4px 12px;
      border-radius: 999px;
      background: var(--surface, #1b2330);
      border: 1px solid var(--border, #2a3444);
      color: var(--text-muted, #9aa4b2);
    }
    .wv-badge.is-live {
      background: rgba(239, 68, 68, 0.15);
      border-color: rgba(239, 68, 68, 0.5);
      color: #f87171;
    }
    /* Live timer — a clickable badge consistent with .wv-badge. Tabular numerals keep the
       HH:MM from jittering as it ticks. Reveals only while the webinar is live. */
    .wv-timer {
      font-size: 0.82rem;
      font-weight: 600;
      padding: 4px 12px;
      border-radius: 999px;
      background: var(--surface, #1b2330);
      border: 1px solid var(--border, #2a3444);
      color: var(--text-muted, #9aa4b2);
      cursor: pointer;
      font-family: inherit;
      font-variant-numeric: tabular-nums;
      letter-spacing: 0.02em;
    }
    .wv-timer:hover {
      border-color: var(--accent, #3b82f6);
    }
    .wv-timer:focus-visible {
      outline: 2px solid var(--accent, #3b82f6);
      outline-offset: 1px;
    }
    .wv-timer.hidden {
      display: none;
    }
    .wv-video-wrap {
      position: relative;
      width: 100%;
      aspect-ratio: 16 / 9;
      background: #000;
      border-radius: 14px;
      overflow: hidden;
    }
    .wv-video {
      width: 100%;
      height: 100%;
      /* cover (not contain) so the video ALWAYS fills the 16:9 frame, cropping as
         needed — webcams aren't all 16:9 (many are 4:3), and pillarboxing looked
         like a "4:3 video". Matches the meet grid, which also uses cover. */
      object-fit: cover;
      background: #000;
    }
    .wv-overlay {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 14px;
      padding: 24px;
      text-align: center;
      color: #e5e7eb;
      background: rgba(0, 0, 0, 0.55);
      backdrop-filter: blur(2px);
    }
    .wv-overlay.hidden {
      display: none;
    }
    .wv-tap {
      position: absolute;
      inset: 0;
      display: grid;
      place-items: center;
      font-size: 1.1rem;
      font-weight: 700;
      color: #fff;
      background: rgba(0, 0, 0, 0.5);
      border: none;
      cursor: pointer;
    }
    .wv-tap.hidden {
      display: none;
    }
    /* Primary start CTA — a centered pill button layered over the video. It is the
       reliable start gesture (autoplay is blocked until the user acts). */
    .wv-cta {
      position: absolute;
      inset: 0;
      margin: auto;
      width: max-content;
      height: max-content;
      padding: 14px 28px;
      border: none;
      border-radius: 999px;
      background: var(--accent, #3b82f6);
      color: #fff;
      font-size: 1.05rem;
      font-weight: 700;
      font-family: inherit;
      cursor: pointer;
      box-shadow: 0 6px 24px rgba(0, 0, 0, 0.45);
    }
    .wv-cta:hover {
      filter: brightness(1.08);
    }
    .wv-cta:focus-visible {
      outline: 2px solid #fff;
      outline-offset: 2px;
    }
    .wv-cta.hidden {
      display: none;
    }
    /* Live-subtitle overlay: a caption band along the bottom of the video. Empty until
       the first frame; pointer-events off so it never blocks the video controls. */
    .wv-subtitles {
      position: absolute;
      left: 0;
      right: 0;
      bottom: 8px;
      display: flex;
      justify-content: center;
      padding: 0 16px;
      pointer-events: none;
      z-index: 2;
    }
    /* The subtitle box + line spans are created at runtime by subtitle-render.ts, so their
       classes must be :global (Astro's scoping can't reach JS-created nodes). */
    .wv-subtitles :global(.subtitle) {
      display: inline-flex;
      flex-direction: column;
      gap: 2px;
      max-width: 90%;
      padding: 6px 12px;
      border-radius: 8px;
      background: rgba(0, 0, 0, 0.68);
      color: #fff;
      text-align: center;
      text-shadow: 0 1px 2px rgba(0, 0, 0, 0.6);
      line-height: 1.35;
    }
    .wv-subtitles :global(.subtitle-interim) {
      opacity: 0.75;
    }
    .wv-subtitles :global(.subtitle-translation) {
      font-size: 1rem;
      font-weight: 600;
    }
    .wv-subtitles :global(.subtitle-original) {
      font-size: 0.82rem;
      opacity: 0.8;
    }
    /* Viewer controls row (audio + captions). */
    .wv-controls {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      justify-content: center;
    }
    .wv-ctl {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      font-size: 0.85rem;
      font-weight: 600;
      padding: 8px 14px;
      border-radius: 999px;
      background: var(--surface, #1b2330);
      border: 1px solid var(--border, #2a3444);
      color: var(--text, #e5e7eb);
      cursor: pointer;
    }
    .wv-ctl:hover {
      border-color: var(--accent, #3b82f6);
    }
    .wv-ctl-ico {
      font-size: 1rem;
      line-height: 1;
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }
    /* Compact "CC" badge — a small bold monospace boxed glyph in place of an emoji. */
    .wv-cc-badge {
      font-size: 0.7em;
      font-weight: 700;
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      line-height: 1;
      padding: 2px 4px;
      border: 1px solid currentColor;
      border-radius: 4px;
    }
    /* Unread-message count badge on the "Show chat" toggle — a small red pill that
