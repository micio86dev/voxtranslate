---
// There is deliberately NO bundled copy of the policy in this file. The text is managed
// in the backoffice — authored in `directus/legal/privacy.<lang>.md`, seeded into
// `legal_pages` / `legal_translations`, and fetched at runtime by `Legal.astro` — so
// exactly one version of it exists. A second copy pasted here is what let the app claim
// Deepgram powered the Standard tier long after Qwen replaced it, and a privacy policy is
// the last document that may disagree with itself.
//
// What remains below is a status line, not a policy: it covers the one case the fetch
// cannot, an unreachable API, and tells the reader how to obtain the current text instead
// of leaving them on a blank page. `updated` / `version` are the pre-hydration values and
// are overwritten by the managed version as soon as it loads; keep them in step with
// `VERSION` in `directus/gen-content-seed.mjs`. This note lives in the frontmatter rather
// than an HTML comment so it is not shipped to the reader's browser.
import Legal from '../layouts/Legal.astro';
---

<Legal
  title="Privacy Policy"
  description="How VoxTranslate collects, uses, and protects your data during real-time translated video meetings. Our GDPR-aligned privacy policy."
  updated="8 August 2026"
  version="2026-08-08"
>
  <p>
    Loading the current Privacy Policy… If it does not appear, it is temporarily
    unavailable — email
    <a href="mailto:privacy@voxtranslate.app">privacy@voxtranslate.app</a> and we will
    send you the version in force.
  </p>
  <noscript>
    <p>
      This policy is published from our backoffice and needs JavaScript to load. Email
      <a href="mailto:privacy@voxtranslate.app">privacy@voxtranslate.app</a> and we will
      send you the version in force.
    </p>
  </noscript>
</Legal>
