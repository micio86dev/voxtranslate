          <textarea id="glossary-csv-text" rows="4" spellcheck="false" data-i18n-ph="glossaryCsvPh" placeholder={T('glossaryCsvPh')} data-i18n-label="glossaryCsvTitle" aria-label={T('glossaryCsvTitle')}></textarea>
          <button id="glossary-import" class="btn-ghost" data-i18n="glossaryImport">{T('glossaryImport')}</button>
