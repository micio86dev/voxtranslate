    <!-- End-webinar confirmation (spec: End webinar). Reuses the shared
         .modal-overlay focus-trap + Escape + focus-restore wired in app.ts. -->
    <div id="webinar-end-modal" class="modal-overlay hidden">
      <div class="modal card" role="dialog" aria-modal="true" aria-labelledby="webinar-end-modal-title">
        <div class="modal-head">
          <span id="webinar-end-modal-title" class="card-title" data-i18n="webinarEndTitle">{T('webinarEndTitle')}</span>
        </div>
        <p class="webinar-end-body" data-i18n="webinarEndBody">{T('webinarEndBody')}</p>
        <div class="modal-actions">
          <button id="webinar-end-cancel" class="btn-ghost" type="button" data-i18n="cancel">{T('cancel')}</button>
          <button id="webinar-end-confirm" class="btn-primary danger" type="button" data-i18n="webinarEndConfirm">{T('webinarEndConfirm')}</button>
        </div>
      </div>
    </div>

    <!-- Fullscreen QR zoom (webinar-ui-fixes #9): tapping a card's QR opens this
         centered overlay with a large QR + the join URL. Reuses the shared
         .modal-overlay focus-trap + Escape + focus-restore wired in app.ts. -->
    <div id="webinar-qr-modal" class="modal-overlay hidden">
      <div class="modal card webinar-qr-modal" role="dialog" aria-modal="true" aria-labelledby="webinar-qr-modal-title">
        <div class="modal-head">
          <span id="webinar-qr-modal-title" class="card-title"></span>
          <button id="webinar-qr-close" class="btn-ghost icon-btn" data-i18n-title="closeTip" title={T('closeTip')} aria-label={T('closeTip')}>✕</button>
        </div>
