        <div id="glossary-lang-bar" class="glossary-lang-bar"></div>
        <div id="glossary-table-head" class="glossary-table-head" aria-hidden="true"></div>
        <div id="glossary-rows" class="glossary-rows"></div>
        <div class="glossary-toolbar">
          <button id="glossary-add-row" class="btn-ghost" data-i18n="glossaryAddRow">{T('glossaryAddRow')}</button>
