    <div id="consent-modal" class="modal-overlay hidden">
      <div class="modal card modal-narrow" role="dialog" aria-modal="true" aria-labelledby="consent-title">
        <span id="consent-title" class="card-title" data-i18n="consentTitle">{T('consentTitle')}</span>
        <p class="modal-text" data-i18n="consentText">{T('consentText')}</p>
        <label class="consent-check"><input type="checkbox" id="consent-age" /> <span data-i18n="consentAge">{T('consentAge')}</span></label>
        <label class="consent-check"><input type="checkbox" id="consent-tos" /> <span id="consent-tos-label" data-i18n="consentTos">{T('consentTos')}</span></label>
        <p id="consent-status" class="status-line" role="status"></p>
        <div class="modal-actions">
          <button id="consent-decline" class="btn-ghost" data-i18n="decline">{T('decline')}</button>
          <button id="consent-accept" class="btn-primary" data-i18n="agreeContinue">{T('agreeContinue')}</button>
        </div>
      </div>
    </div>

    <!-- ===================== REPORT MODAL ===================== -->
    <div id="report-modal" class="modal-overlay hidden">
      <div class="modal card modal-narrow" role="dialog" aria-modal="true" aria-labelledby="report-title">
        <div class="modal-head">
          <span id="report-title" class="card-title" data-i18n="reportTitle">{T('reportTitle')}</span>
          <button id="report-close" class="btn-ghost icon-btn" data-i18n-title="closeTip" title={T('closeTip')} aria-label={T('closeTip')}></button>
        </div>
        <p class="modal-text"><span data-i18n="reportFor">{T('reportFor')}</span> <strong id="report-target"></strong></p>
        <div id="report-reasons" class="report-reasons"></div>
        <p id="report-status" class="status-line" role="status"></p>
      </div>
