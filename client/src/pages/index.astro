        <p id="webinar-qr-modal-url" class="webinar-qr-modal-url"></p>
      </div>
    </div>

    <!-- Webinar detail sheet (D5/D7 — PR3): full webinar info + action area.
         One modal re-populated per open (populated via populateWebinarDetail in app.ts).
         ESC / close button closes via the shared .modal-overlay focus-trap.
         PR4 will fill #wdm-edit-section with the edit form. -->
    <div id="webinar-detail-modal" class="modal-overlay hidden">
      <div class="modal card webinar-detail-modal" role="dialog" aria-modal="true" aria-labelledby="wdm-title">
        <!-- Modal header: title + close -->
        <div class="modal-head wdm-head">
          <h2 id="wdm-title" class="wdm-title"></h2>
          <button id="wdm-close" class="btn-ghost icon-btn" data-i18n-title="closeTip" title={T('closeTip')} aria-label={T('closeTip')}>✕</button>
        </div>

        <!-- Status + tier badges row -->
        <div class="wdm-badges">
          <span id="wdm-status" class="webinar-status"></span>
          <span id="wdm-tier" class="wdm-badge wdm-tier-badge"></span>
          <span id="wdm-visibility" class="wdm-badge wdm-visibility-badge"></span>
        </div>

        <!-- Scrollable body -->
        <div class="wdm-body">

          <!-- Schedule section -->
          <section class="wdm-section" id="wdm-schedule-section">
            <h3 class="wdm-section-label" data-i18n="webinarSchedule">{T('webinarSchedule')}</h3>
            <dl class="wdm-dl">
              <div class="wdm-row" id="wdm-source-lang-row">
                <dt class="wdm-dt" data-i18n="webinarDetailSourceLang">{T('webinarDetailSourceLang')}</dt>
                <dd id="wdm-source-lang" class="wdm-dd"></dd>
              </div>
              <div class="wdm-row" id="wdm-scheduled-row">
                <dt class="wdm-dt" data-i18n="webinarDetailScheduledFor">{T('webinarDetailScheduledFor')}</dt>
                <dd id="wdm-scheduled" class="wdm-dd"></dd>
              </div>
              <div class="wdm-row hidden" id="wdm-actual-row">
                <dt class="wdm-dt" data-i18n="webinarDetailActualTime">{T('webinarDetailActualTime')}</dt>
                <dd id="wdm-actual" class="wdm-dd"></dd>
              </div>
              <div class="wdm-row hidden" id="wdm-reminder-row">
                <dt class="wdm-dt" data-i18n="webinarDetailReminderLead">{T('webinarDetailReminderLead')}</dt>
                <dd id="wdm-reminder" class="wdm-dd"></dd>
              </div>
            </dl>
          </section>

          <!-- Description section (hidden when empty) -->
          <section class="wdm-section hidden" id="wdm-description-section">
            <h3 class="wdm-section-label" data-i18n="webinarDetailDescription">{T('webinarDetailDescription')}</h3>
            <p id="wdm-description" class="wdm-description-text"></p>
          </section>

          <!-- Share section: join link + QR -->
          <section class="wdm-section" id="wdm-share-section">
            <h3 class="wdm-section-label" data-i18n="webinarJoinLink">{T('webinarJoinLink')}</h3>
            <div class="wdm-share-row">
              <!-- QR: tappable → fullscreen zoom overlay (same pattern as the card QR) -->
              <img id="wdm-qr" class="webinar-qr wdm-qr" width="100" height="100" alt="" tabindex="0" role="button" aria-label={T('webinarQrZoom')} title={T('webinarQrZoom')} />
              <div class="wdm-share-info">
                <input id="wdm-join-url" class="webinar-link-input wdm-join-url" type="text" readonly aria-label={T('webinarJoinLink')} />
                <!-- The three share actions share one row on desktop and stack on mobile
                     (wdm-share-actions), so none of them is cramped against the others. -->
                <div class="wdm-share-actions">
                  <button id="wdm-copy-btn" type="button" class="btn-ghost" data-i18n="copy">{T('copy')}</button>
                  <button id="wdm-qr-download" type="button" class="btn-ghost" data-i18n="webinarQrDownload">{T('webinarQrDownload')}</button>
                  <button id="wdm-qr-print" type="button" class="btn-ghost" data-i18n="webinarQrPrint">{T('webinarQrPrint')}</button>
                </div>
                <p class="wdm-code-hint">
                  <span data-i18n="webinarCode">{T('webinarCode')}</span>: <code id="wdm-code"></code>
                </p>
              </div>
            </div>
          </section>

          <!-- Settings section: flags -->
          <section class="wdm-section" id="wdm-settings-section">
            <h3 class="wdm-section-label" data-i18n="webinarDetailSettings">{T('webinarDetailSettings')}</h3>
            <div class="wdm-flags" id="wdm-flags"></div>
          </section>

          <!-- Metadata: created date -->
          <p class="wdm-meta-line">
            <span data-i18n="webinarCreatedOn">{T('webinarCreatedOn')}</span>
            <span id="wdm-created-at"></span>
          </p>

        <!-- Edit form: rendered only when status === 'scheduled' (PR4 / D5-edit / D6-edit).
             All editable fields + destructive Cancel/Archive actions live here (req #6).
             app.ts populates + shows this section when openWebinarDetailModal runs. -->
        <div id="wdm-edit-section" class="hidden">
          <div class="wdm-edit-divider"></div>
          <form id="wdm-edit-form" class="wdm-edit-form" novalidate>
            <h3 class="wdm-section-label" data-i18n="webinarEditTitle">{T('webinarEditTitle')}</h3>

            <!-- Title -->
            <label class="ws-field">
              <span class="ws-field-label" data-i18n="webinarTitleLabel">{T('webinarTitleLabel')}</span>
              <input id="wde-title" class="ws-select" type="text" maxlength="200" autocomplete="off" />
            </label>

            <!-- Description -->
            <label class="ws-field">
              <span class="ws-field-label" data-i18n="webinarDetailDescription">{T('webinarDetailDescription')}</span>
              <textarea id="wde-description" class="ws-select wde-description" rows="3" autocomplete="off"></textarea>
            </label>

            <!-- Source language -->
            <label class="ws-field">
              <span class="ws-field-label" data-i18n="webinarDetailSourceLang">{T('webinarDetailSourceLang')}</span>
              <select id="wde-lang" class="ws-select"></select>
            </label>

            <!-- Tier -->
            <label class="ws-field">
              <span class="ws-field-label" data-i18n="webinarTier">{T('webinarTier')}</span>
              <select id="wde-tier" class="ws-select">
                <option value="enhanced" data-i18n="webinarTierEnhanced">{T('webinarTierEnhanced')}</option>
                <option value="standard" data-i18n="webinarTierStandard">{T('webinarTierStandard')}</option>
              </select>
            </label>

            <!-- Schedule: start + end -->
            <div class="webinar-schedule-row">
              <label class="ws-field grow">
                <span class="ws-field-label" data-i18n="webinarScheduleStart">{T('webinarScheduleStart')}</span>
                <input id="wde-start" class="ws-select" type="datetime-local" autocomplete="off" />
              </label>
              <label class="ws-field grow">
                <span class="ws-field-label" data-i18n="webinarScheduleEnd">{T('webinarScheduleEnd')}</span>
                <input id="wde-end" class="ws-select" type="datetime-local" autocomplete="off" disabled />
              </label>
            </div>

            <!-- Reminder lead time -->
            <label class="ws-field">
              <span class="ws-field-label" data-i18n="webinarReminderLabel">{T('webinarReminderLabel')}</span>
              <input id="wde-reminder" class="ws-select" type="number" min="0" max="1440" step="1" autocomplete="off" />
            </label>

            <!-- Toggle switches: record_video, record_transcript, chat_enabled, visibility, members_only -->
            <div class="webinar-toggles">
              <div class="webinar-toggle-row">
                <span class="webinar-toggle-label" id="wde-record-video-label" data-i18n="webinarRecordVideo">{T('webinarRecordVideo')}</span>
                <button id="wde-record-video" class="ws-switch" type="button" role="switch" aria-checked="false" aria-labelledby="wde-record-video-label"><span class="ws-switch-knob" aria-hidden="true"></span></button>
              </div>
              <div class="webinar-toggle-row">
                <span class="webinar-toggle-label" id="wde-record-transcript-label" data-i18n="webinarRecordTranscript">{T('webinarRecordTranscript')}</span>
                <button id="wde-record-transcript" class="ws-switch" type="button" role="switch" aria-checked="false" aria-labelledby="wde-record-transcript-label"><span class="ws-switch-knob" aria-hidden="true"></span></button>
              </div>
              <div class="webinar-toggle-row">
                <span class="webinar-toggle-label" id="wde-chat-enabled-label" data-i18n="webinarChatEnabled">{T('webinarChatEnabled')}</span>
                <button id="wde-chat-enabled" class="ws-switch" type="button" role="switch" aria-checked="false" aria-labelledby="wde-chat-enabled-label"><span class="ws-switch-knob" aria-hidden="true"></span></button>
              </div>
              <div class="webinar-toggle-row">
                <span class="webinar-toggle-label" id="wde-visibility-label" data-i18n="webinarVisibilityPublic">{T('webinarVisibilityPublic')}</span>
                <button id="wde-visibility" class="ws-switch" type="button" role="switch" aria-checked="false" aria-labelledby="wde-visibility-label"><span class="ws-switch-knob" aria-hidden="true"></span></button>
              </div>
              <div class="webinar-toggle-row">
                <span class="webinar-toggle-label" id="wde-members-only-label" data-i18n="webinarMembersOnly">{T('webinarMembersOnly')}</span>
                <button id="wde-members-only" class="ws-switch" type="button" role="switch" aria-checked="false" aria-labelledby="wde-members-only-label"><span class="ws-switch-knob" aria-hidden="true"></span></button>
              </div>
              <!-- notify_friends: only visible for public scheduled webinars (mirroring create form) -->
              <div class="webinar-toggle-row hidden" id="wde-notify-friends-row">
                <span class="webinar-toggle-label" id="wde-notify-friends-label" data-i18n="webinarNotifyFriends">{T('webinarNotifyFriends')}</span>
                <button id="wde-notify-friends" class="ws-switch" type="button" role="switch" aria-checked="true" aria-labelledby="wde-notify-friends-label"><span class="ws-switch-knob" aria-hidden="true"></span></button>
              </div>
            </div>

            <!-- Save + status -->
            <div class="webinar-create-actions">
              <button id="wde-save-btn" type="submit" class="btn-primary webinar-create-btn" data-i18n="webinarSaveChanges">{T('webinarSaveChanges')}</button>
            </div>
            <p id="wde-status" class="status-line hidden" role="status"></p>

            <!-- Destructive actions: Cancel webinar + Archive (req #6 — moved from card into edit section) -->
            <div class="wde-destructive-actions">
              <button id="wde-cancel-btn" type="button" class="btn-ghost danger wde-destructive-btn" data-i18n="webinarCancel">{T('webinarCancel')}</button>
              <button id="wde-archive-btn" type="button" class="btn-ghost wde-destructive-btn" data-i18n="webinarArchive">{T('webinarArchive')}</button>
            </div>
          </form>
        </div>

        <!-- Action area: lifecycle actions for non-scheduled webinars (Archive for active
             non-scheduled; Restore for archived). Calendar row injected by app.ts. -->
        <div class="wdm-actions" id="wdm-actions">
          <div id="wdm-lifecycle-actions" class="wdm-lifecycle-actions"></div>
          <div id="wdm-calendar-row"></div>
        </div>
        </div><!-- /.wdm-body -->

      </div>
    </div>

    <!-- Actionable in-app banner (e.g. a friend is in a public room → Join). A fixed
         top overlay populated + toggled from app.ts. Distinct from the transient
         #notif-banner weak-network nudge. -->
    <div id="friend-banner" class="friend-banner hidden" role="status" aria-live="polite">
      <span id="friend-banner-text" class="friend-banner-text"></span>
      <div class="friend-banner-actions">
        <button id="friend-banner-join" class="btn-primary" data-i18n="join">{T('join')}</button>
        <button id="friend-banner-dismiss" class="btn-ghost" data-i18n="dismiss">{T('dismiss')}</button>
      </div>
