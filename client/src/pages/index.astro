        <div class="modal-actions">
          <button id="exhausted-dismiss" class="btn-ghost" data-i18n="dismiss">{T('dismiss')}</button>
          <button id="exhausted-buy" class="btn-primary" data-i18n="buyCredits">{T('buyCredits')}</button>
        </div>
      </div>
