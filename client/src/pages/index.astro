---
import Base from '../layouts/Base.astro';
import en from '../scripts/i18n/en.json';
// Server-render the English default for every data-i18n* slot so the page paints real text at
// FCP (no empty placeholders → better LCP/CLS, spec 0104). applyI18n() still localizes on the
// client when the active locale differs. Single source of truth: en.json (no drift).
const T = (k: string): string => (en as Record<string, string>)[k] ?? '';

const LANGS = [
  { code: 'it', name: 'Italiano' },
  { code: 'en', name: 'English' },
  { code: 'es', name: 'Español' },
  { code: 'fr', name: 'Français' },
  { code: 'de', name: 'Deutsch' },
  { code: 'pt', name: 'Português' },
  { code: 'ja', name: '日本語' },
  { code: 'zh', name: '中文' },
];

// Structured data for rich results (Google understands WebApplication schema).
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'VoxTranslate',
  alternateName: 'VoxTranslate AI Voice Translator',
  // From Astro.site (astro.config, PUBLIC_SITE_ORIGIN) rather than a literal, so the
  // schema url cannot disagree with the canonical tags on the same page.
  url: Astro.site?.origin ?? 'https://app.voxtranslate.app',
  applicationCategory: 'CommunicationApplication',
  operatingSystem: 'Any (web browser)',
  description:
    'Real-time AI voice translator for video calls: VoxTranslate translates your voice live — voice-to-voice — with auto-translated chat, so everyone speaks their own language and is understood.',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  featureList: [
    'Real-time AI voice translation',
    'Voice-to-voice translation in video calls',
    'Auto-translated text chat',
    'Peer-to-peer video meetings',
    'Live speech-to-text captions',
  ],
};
---

<Base
  title="VoxTranslate — AI Voice Translator for Real-Time Video Calls"
  description="Free real-time AI voice translator. Speak your own language and be understood in everyone else's — VoxTranslate translates your voice live, voice-to-voice, in video calls and chat across 84 languages, right in your browser."
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  <main class="app">
    <!-- ===================== LOGIN (billing mode only) ===================== -->
    <section id="login" class="screen hidden">
      <div class="login-card card">
        <h1 class="brand">Vox<span>Translate</span></h1>
        <p class="tagline" data-i18n="tagline">{T('tagline')}</p>
        <p class="login-sub" data-i18n="loginSub">{T('loginSub')}</p>
        <!-- Custom Google-branded button (spec 0087): looks like the official
             "Sign in with Google" button but opens Google's NATIVE account chooser
             (FedCM) on click, so there's no white personalized card. If the native
             chooser is unavailable (rate-limited / no FedCM), app.ts reveals
             Google's official button into #gsi-official as a working fallback. -->
        <div id="gsi-button" class="gsi-button">
          <button id="gsi-signin" class="gsi-btn hidden" type="button">
            <span class="gsi-btn-g" aria-hidden="true">
              <svg viewBox="0 0 48 48" width="18" height="18">
                <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
                <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
                <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
                <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
              </svg>
            </span>
            <span class="gsi-btn-label" data-i18n="continueGoogle">{T('continueGoogle')}</span>
          </button>
          <div id="gsi-official" class="gsi-official"></div>
        </div>
        <div class="login-or"><span data-i18n="orText">{T('orText')}</span></div>
        <button id="guest-btn" class="btn-ghost guest-btn" data-i18n="continueGuest">{T('continueGuest')}</button>
        <p class="legal-footer">
          <a href="/terms" target="_blank" rel="noopener" data-i18n="terms">{T('terms')}</a>
          <a href="/privacy" target="_blank" rel="noopener" data-i18n="privacy">{T('privacy')}</a>
          <a href="/acceptable-use" target="_blank" rel="noopener" data-i18n="acceptableUse">{T('acceptableUse')}</a>
        </p>
      </div>
    </section>

    <!-- ===================== HOME / LOBBY ===================== -->
    <section id="home" class="screen">
      <header class="home-header">
        <div class="brand-row">
          <img class="brand-logo" src="/logo-88.png" alt="" width="44" height="44" decoding="async" fetchpriority="high" />
          <h1 class="brand">Vox<span>Translate</span></h1>
        </div>
        <p class="tagline" data-i18n="tagline">{T('tagline')}</p>
        <!-- Signed-in nav (spec: account hub): a balance pill, the one-tap Buy CTA, and a
             single avatar menu that holds every secondary account destination. Replaces the
             old row of six competing buttons. -->
        <div id="account-bar" class="account-bar hidden">
          <div id="balance-pill" class="balance-pill" data-i18n-title="currentBalance" title={T('currentBalance')}>
            <span class="balance-ico" data-ico="wallet" aria-hidden="true"></span>
            <span id="account-balance" class="account-balance"></span>
          </div>
          <button id="buy-btn" class="btn-primary buy-cta" data-i18n="buyCredits">{T('buyCredits')}</button>
          <div class="account-menu">
            <button id="account-trigger" class="account-trigger" aria-haspopup="true" aria-expanded="false" aria-controls="account-menu" data-i18n-label="account" aria-label={T('account')}>
              <img id="account-avatar" class="account-avatar" alt="" referrerpolicy="no-referrer" />
              <span id="account-name" class="account-name"></span>
              <span class="account-chevron" aria-hidden="true">▾</span>
              <span id="friends-badge" class="chat-badge avatar-badge hidden">0</span>
            </button>
            <!-- role="menu": an arrow-key navigable list of account destinations, closed by
                 ESC / click-outside (wired in app.ts alongside the overlay focus handling). -->
            <div id="account-menu" class="account-menu-pop hidden" role="menu" data-i18n-label="account" aria-label={T('account')}>
              <button class="acct-item" type="button" role="menuitem" data-acct-nav="profile"><span class="acct-item-ico" data-ico="user" aria-hidden="true"></span><span class="acct-item-label" data-i18n="profileTitle">{T('profileTitle')}</span></button>
              <button class="acct-item" type="button" role="menuitem" data-acct-nav="billing"><span class="acct-item-ico" data-ico="wallet" aria-hidden="true"></span><span class="acct-item-label" data-i18n="billingTitle">{T('billingTitle')}</span></button>
              <button class="acct-item" type="button" role="menuitem" data-acct-nav="friends"><span class="acct-item-ico" data-ico="users" aria-hidden="true"></span><span class="acct-item-label" data-i18n="friendsTitle">{T('friendsTitle')}</span><span id="friends-menu-badge" class="chat-badge acct-item-badge hidden">0</span></button>
              <button class="acct-item" type="button" role="menuitem" data-acct-nav="notifications"><span class="acct-item-ico" data-ico="bell" aria-hidden="true"></span><span class="acct-item-label" data-i18n="notifTitle">{T('notifTitle')}</span></button>
              <button class="acct-item" type="button" role="menuitem" data-acct-nav="privacy"><span class="acct-item-ico" data-ico="shield" aria-hidden="true"></span><span class="acct-item-label" data-i18n="privacyData">{T('privacyData')}</span></button>
              <a id="workspace-btn" class="acct-item workspace-btn hidden" role="menuitem" data-i18n-title="workspace" title={T('workspace')} target="_blank" rel="noopener"><span class="acct-item-ico" data-ico="grid" aria-hidden="true"></span><span class="acct-item-label" data-i18n="workspace">{T('workspace')}</span></a>
              <!-- Webinars host hub (webinar phase 0): revealed once an active-sub org is found. -->
              <button id="webinars-btn" class="acct-item webinars-btn hidden" type="button" role="menuitem"><span class="acct-item-ico" data-ico="video" aria-hidden="true"></span><span class="acct-item-label" data-i18n="webinarsTitle">{T('webinarsTitle')}</span></button>
              <div class="acct-sep" role="separator"></div>
              <button id="logout-btn" class="acct-item acct-danger" type="button" role="menuitem"><span class="acct-item-ico" data-ico="leave" aria-hidden="true"></span><span class="acct-item-label" data-i18n="logout">{T('logout')}</span></button>
            </div>
          </div>
        </div>
        <!-- Guests have no account bar, so this is their only way back to the login
             screen (spec 0037). Sits where the account bar would be for parity. -->
        <div id="guest-bar" class="guest-bar hidden">
          <div class="guest-bar-copy">
            <span class="guest-bar-title" data-i18n="guestBarTitle">{T('guestBarTitle')}</span>
            <span class="guest-bar-sub" data-i18n="guestBarSub">{T('guestBarSub')}</span>
          </div>
          <button id="guest-signin-btn" class="guest-signin" data-i18n="signIn">{T('signIn')}</button>
        </div>
      </header>
      <div class="home-body">
        <div class="card">
          <div class="field-row">
            <label class="field grow">
              <span class="field-label" data-i18n="nameLabel">{T('nameLabel')}</span>
              <input id="name" type="text" maxlength="24" autocomplete="off" data-i18n-ph="namePlaceholder" placeholder={T('namePlaceholder')} />
            </label>
            <label class="field grow" id="lang-field">
              <span class="field-label" data-i18n="langLabel">{T('langLabel')}</span>
              <select id="lang">
                <option value="auto" data-i18n="langAuto">{T('langAuto')}</option>
                {LANGS.map((l) => <option value={l.code}>{l.name}</option>)}
              </select>
            </label>
          </div>
          <!-- Translation-engine selector (spec 0093): rendered by app.ts from
               /api/engines; stays hidden when only one engine is available. -->
          <div class="field" id="engine-field" hidden>
            <span class="field-label" data-i18n="engineLabel">{T('engineLabel')}</span>
            <div id="engine-options" class="engine-options" role="radiogroup" data-i18n-label="engineLabel" aria-label={T('engineLabel')}></div>
          </div>
          <!-- Language-first picker (spec 0102): rendered by app.ts when LANGUAGE_FIRST_UX
               is on. Replaces the legacy language <select> + engine selector above — pick a
               target language from the union, then choose among the tiers that output it.
               The hidden #lang <select> stays the canonical value holder (join payload + UI
               language), so the picker just drives it. -->
          <div class="field" id="langfirst-field" hidden>
            <span class="field-label" data-i18n="langLabel">{T('langLabel')}</span>
            <button id="lang-trigger" type="button" class="lang-trigger" aria-haspopup="listbox" aria-expanded="false" data-i18n-label="langLabel" aria-label={T('langLabel')}>
              <span class="lang-trigger-flag" id="lang-trigger-flag" aria-hidden="true"></span>
              <span class="lang-trigger-text" id="lang-trigger-text"></span>
              <span class="lang-trigger-chevron" aria-hidden="true">▾</span>
            </button>
            <div id="lang-panel" class="lang-panel" role="listbox" hidden>
              <div class="lang-panel-search">
                <input id="lang-search" type="text" autocomplete="off" spellcheck="false" data-i18n-ph="langSearchPlaceholder" placeholder={T('langSearchPlaceholder')} data-i18n-label="langSearchPlaceholder" aria-label={T('langSearchPlaceholder')} />
              </div>
              <div id="lang-panel-list" class="lang-panel-list"></div>
              <p id="lang-panel-empty" class="lang-panel-empty" data-i18n="langSearchEmpty" hidden>{T('langSearchEmpty')}</p>
            </div>
            <!-- Tier cards for the chosen language (cheapest pre-selected). -->
            <div class="field" id="tier-field" hidden>
              <span class="field-label" data-i18n="engineLabel">{T('engineLabel')}</span>
              <div id="tier-options" class="engine-options" role="radiogroup" data-i18n-label="engineLabel" aria-label={T('engineLabel')}></div>
              <p id="tier-note" class="tier-note" hidden></p>
            </div>
          </div>
        </div>

        <div class="card">
          <span class="card-title" data-i18n="createOrJoin">{T('createOrJoin')}</span>
          <label class="field">
            <span class="field-label" data-i18n="roomCode">{T('roomCode')}</span>
            <div class="room-row">
              <input id="room" type="text" autocomplete="off" spellcheck="false" />
              <button id="dice" class="btn-ghost icon-btn" data-i18n-title="diceTip" title={T('diceTip')} aria-label={T('diceTip')}></button>
              <button id="btn-glossary-home" class="btn-ghost icon-btn" data-i18n-title="glossaryTip" title={T('glossaryTip')} data-i18n-label="glossaryTip" aria-label={T('glossaryTip')} hidden></button>
            </div>
          </label>
          <div class="field">
            <span class="field-label" data-i18n="visibility">{T('visibility')}</span>
            <div class="seg" id="vis-group" role="group" data-i18n-label="visibility" aria-label={T('visibility')}>
              <button type="button" class="seg-btn active" data-vis="public" aria-pressed="true" data-i18n="public">{T('public')}</button>
              <button type="button" class="seg-btn" data-vis="private" aria-pressed="false" data-i18n="private">{T('private')}</button>
            </div>
            <span class="hint" id="vis-hint"></span>
          </div>
          <button id="enter" class="btn-primary" data-i18n="connect">{T('connect')}</button>
          <p id="home-status" class="status-line" role="status"></p>
        </div>

        <!-- Scheduled meetings on Google Calendar (signed-in only; spec: Phase 1e). -->
        <div class="card hidden" id="schedule-card">
          <div class="card-title-row">
            <span class="card-title" data-i18n="scheduleTitle">{T('scheduleTitle')}</span>
            <button id="schedule-open" class="btn-ghost" data-i18n="scheduleNew">{T('scheduleNew')}</button>
          </div>
          <div id="schedule-list" class="schedule-list"></div>
        </div>

        <div class="card">
          <div class="card-title-row">
            <span class="card-title" data-i18n="publicRooms">{T('publicRooms')}</span>
            <button id="refresh" class="btn-ghost" data-i18n="refresh">{T('refresh')}</button>
          </div>
          <div id="rooms-list" class="rooms-list"></div>
        </div>

        <!-- Host a webinar CTA (D9, PR5). Shown only for signed-in B2B users with at
             least one host-capable org. Visibility toggled in updateWorkspaceLink()
             alongside #webinars-btn, via the same canHostWebinar(org) gate. -->
        <div class="card hidden host-webinar-cta" id="host-webinar-cta">
          <div class="card-title-row">
            <span class="card-title" data-i18n="homeHostWebinarTitle">{T('homeHostWebinarTitle')}</span>
          </div>
          <p class="host-cta-desc" data-i18n="homeHostWebinarDesc">{T('homeHostWebinarDesc')}</p>
          <button id="home-host-webinar-btn" class="btn-primary" data-i18n="homeHostWebinarCta">{T('homeHostWebinarCta')}</button>
        </div>

        <!-- Public webinars discovery (sibling of the public rooms list). Hidden while
             the list is empty; populated from GET /api/webinars/public in app.ts.
             Clicking a card navigates to the participant page /w/{code}. -->
        <div class="card hidden" id="public-webinars-card">
          <div class="card-title-row">
            <span class="card-title" data-i18n="publicWebinars">{T('publicWebinars')}</span>
          </div>
          <div id="public-webinars" class="webinars-list"></div>
        </div>
        <!-- Legal links footer on the lobby (mirrors the login-screen footer; keeps terms/privacy/acceptable-use reachable from the app home). -->
        <p class="legal-footer">
          <a href="/terms" target="_blank" rel="noopener" data-i18n="terms">{T('terms')}</a>
          <a href="/privacy" target="_blank" rel="noopener" data-i18n="privacy">{T('privacy')}</a>
          <a href="/acceptable-use" target="_blank" rel="noopener" data-i18n="acceptableUse">{T('acceptableUse')}</a>
        </p>
      </div>
      <button id="onb-home-help" class="help-fab" type="button" data-i18n-title="onbHelpLabel" title={T('onbHelpLabel')} aria-label={T('onbHelpLabel')}>?</button>
    </section>

    <!-- ===================== SESSION DETAIL (auth only) ===================== -->
    <section id="session" class="screen hidden">
      <div class="session-body">
        <header class="session-header">
          <button id="session-back" class="btn-ghost" data-i18n="back">{T('back')}</button>
          <h1 class="card-title" data-i18n="sessionDetails">{T('sessionDetails')}</h1>
          <span class="room-tag"><span id="session-room" class="mono"></span></span>
        </header>
        <!-- At-a-glance summary: each fact gets its own labelled cell so it's
             obvious what every value means (issue #4). -->
        <dl class="session-stats">
          <div class="stat">
            <dt class="stat-label" data-i18n="dateLabel">{T('dateLabel')}</dt>
            <dd id="session-date" class="stat-value"></dd>
          </div>
          <div class="stat">
            <dt class="stat-label" data-i18n="durationLabel">{T('durationLabel')}</dt>
            <dd id="session-duration" class="stat-value"></dd>
          </div>
          <div class="stat">
            <dt class="stat-label" data-i18n="eventsStatLabel">{T('eventsStatLabel')}</dt>
            <dd id="session-events" class="stat-value"></dd>
          </div>
          <div class="stat stat-wide">
            <dt class="stat-label" data-i18n="participants">{T('participants')}</dt>
            <dd id="session-participants" class="stat-value"></dd>
          </div>
        </dl>

        <!-- Unified "session outputs" card (#224): downloads + an integrated,
             collapsed transcript preview that expands via the toggle. -->
        <div class="card">
          <span class="card-title" data-i18n="sessionOutputs">{T('sessionOutputs')}</span>
          <div id="session-downloads" class="session-downloads">
            <button id="session-dl-pdf" class="btn-primary" data-i18n="downloadPdf">{T('downloadPdf')}</button>
            <button id="session-dl-json" class="btn-primary" data-i18n="downloadJson">{T('downloadJson')}</button>
            <button id="session-dl-srt" class="btn-primary" data-i18n="downloadSrt">{T('downloadSrt')}</button>
            <button id="session-dl-vtt" class="btn-primary" data-i18n="downloadVtt">{T('downloadVtt')}</button>
            <select id="session-sub-mode" data-i18n-label="subtitleMode" aria-label={T('subtitleMode')} data-i18n-title="subtitleMode" title={T('subtitleMode')}>
              <option value="translated" data-i18n="subTranslated">{T('subTranslated')}</option>
              <option value="original" data-i18n="subOriginal">{T('subOriginal')}</option>
              <option value="both" data-i18n="subBoth">{T('subBoth')}</option>
            </select>
          </div>
          <div class="ai-correct-wrap">
            <label class="ai-correct-label">
              <input type="checkbox" id="ai-correct-chk">
              <span data-i18n="aiCorrectLabel">{T('aiCorrectLabel')}</span>
            </label>
            <span id="ai-correct-cost" class="ai-correct-cost"></span>
          </div>
          <div class="session-transcript-block">
            <span class="session-subhead" data-i18n="transcriptLabel">{T('transcriptLabel')}</span>
            <p class="ai-notice" data-i18n="aiGeneratedNotice">{T('aiGeneratedNotice')}</p>
            <div id="session-bookmarks" class="session-bookmarks" hidden></div>
            <p id="session-transcript-status" class="status-line" role="status"></p>
            <div id="session-transcript" class="session-transcript collapsed"></div>
            <button id="session-transcript-toggle" class="btn-ghost session-transcript-toggle hidden"
                    data-i18n="viewFullTranscript" aria-expanded="false">{T('viewFullTranscript')}</button>
          </div>
        </div>

        <!-- AI tools (report / sentiment / email) — each tool renders its own
             card into its slot (see .ai-section), so they read as separate boxes. -->
        <div id="session-ai" class="hidden">
          <span class="card-title" data-i18n="aiTools">{T('aiTools')}</span>
          <div id="ai-report-slot"></div>
          <div id="ai-sentiment-slot"></div>
          <div id="ai-email-slot"></div>
        </div>

        <!-- Quiz history (#221): quizzes run in the call + per-participant scores.
             Hidden until quizzes are loaded for the session. -->
        <div id="session-quizzes" class="card" hidden>
          <span class="card-title" data-i18n="quizzesLabel">{T('quizzesLabel')}</span>
          <div id="session-quizzes-list" class="session-quizzes-list"></div>
        </div>
      </div>
    </section>

    <!-- ===================== PRE-JOIN ===================== -->
    <section id="prejoin" class="screen hidden">
      <div class="prejoin-card card">
        <div class="prejoin-head">
          <h1 class="card-title" data-i18n="prejoinTitle">{T('prejoinTitle')}</h1>
          <span class="room-tag"><span id="prejoin-room" class="mono"></span> · <span id="prejoin-vis" class="vis-badge"></span></span>
          <button id="prejoin-audio-btn" class="btn-ghost icon-btn" type="button" data-i18n-title="audioSettings" title={T('audioSettings')} aria-label={T('audioSettings')} aria-haspopup="dialog"></button>
        </div>
        <div class="preview-wrap">
          <video id="preview" autoplay playsinline muted></video>
          <div class="preview-off" id="preview-off" hidden>
            <span class="preview-avatar" id="preview-avatar"></span>
          </div>
          <div class="preview-controls">
            <button id="pre-mic" class="control-btn" data-i18n-title="muteTip" title={T('muteTip')} aria-label={T('muteTip')}></button>
            <button id="pre-cam" class="control-btn" data-i18n-title="camTip" title={T('camTip')} aria-label={T('camTip')}></button>
          </div>
        </div>
        <div class="field-row">
          <label class="field grow">
            <span class="field-label" data-i18n="camera">{T('camera')}</span>
            <select id="cam-select"></select>
          </label>
          <label class="field grow">
            <span class="field-label" data-i18n="microphone">{T('microphone')}</span>
            <select id="mic-select"></select>
          </label>
        </div>
        <p id="prejoin-status" class="status-line" role="status"></p>
        <!-- Enhanced voice preparation (spec 0108): clones the user's voice so others hear
             them translated in their own voice. Shown for Enhanced-tier users with cloning
             enabled; an explicit record/re-record step driven by app.ts. -->
        <div id="voiceprep" class="voiceprep hidden">
          <p class="voiceprep-title" data-i18n="voicePrepTitle">{T('voicePrepTitle')}</p>
          <p class="voiceprep-prompt" data-i18n="voicePrepPrompt">{T('voicePrepPrompt')}</p>
          <p class="voiceprep-sample" data-i18n="voicePrepSample">{T('voicePrepSample')}</p>
          <!-- Live level meter: fills as enough speech is captured while reading the phrase. -->
          <div id="voiceprep-meter" class="voiceprep-meter hidden" aria-hidden="true"><span id="voiceprep-meter-fill"></span></div>
          <!-- Persistent outcome: ✓ cloned / ✗ not cloned (then a default voice is used). -->
          <p id="voiceprep-result" class="voiceprep-result hidden" role="status"></p>
          <button id="voiceprep-record" class="voiceprep-btn" type="button" data-i18n="voicePrepRecord">{T('voicePrepRecord')}</button>
        </div>
        <!-- VoxTranslate for Business (spec 0106): associate this call with an org/project
             and optionally record it. Hidden for non-business users. -->
        <div id="biz-prejoin" class="field-row hidden">
          <label class="field grow">
            <span class="field-label" data-i18n="bizOrg">{T('bizOrg')}</span>
            <select id="biz-org"></select>
          </label>
          <label class="field grow">
            <span class="field-label" data-i18n="bizProject">{T('bizProject')}</span>
            <select id="biz-project"></select>
          </label>
        </div>
        <label id="biz-record-row" class="biz-record-row hidden">
          <span class="biz-record-icon" aria-hidden="true">☁️</span>
          <span class="biz-record-text" data-i18n="bizRecord">{T('bizRecord')}</span>
          <span class="biz-switch">
            <input id="biz-record" type="checkbox" />
            <span class="biz-switch-track" aria-hidden="true"></span>
          </span>
        </label>
        <div class="prejoin-actions">
          <button id="back-btn" class="btn-ghost" data-i18n="back">{T('back')}</button>
          <button id="join-btn" class="btn-primary" data-i18n="join">{T('join')}</button>
        </div>
      </div>
    </section>

    <!-- ===================== CALL ===================== -->
    <section id="call" class="screen hidden">
      <div id="notif-banner" class="notif-banner hidden" role="status"></div>
      <div class="call-main">
        <!-- The old .call-header row is gone (spec 0061 / #98): its chips now overlay the
             video stage (top-left meta + top-right participant badge), Meet-style. -->
        <div id="low-banner" class="low-banner hidden">
          <span id="low-banner-text" role="status"></span>
          <button id="low-banner-buy" class="btn-ghost" data-i18n="buyCredits">{T('buyCredits')}</button>
        </div>
        <div class="video-stage">
          <div id="video-grid" class="video-grid" data-peers="1"></div>
          <!-- On-video meta cluster, top-left (spec 0061 / #98): HH:MM | ROOM over a
               subtle dark backdrop — replaces the separate header row, Meet-style. -->
          <div class="stage-meta-wrap">
            <div class="stage-meta">
              <span id="header-clock" class="clock-badge hidden"></span>
              <button id="call-room" class="room-badge mono" data-i18n-title="copy" title={T('copy')} aria-label={T('copy')}></button>
              <!-- Your identity folded into the meta line (issue #98 follow-up): replaces
                   the self tile's .video-overlay so the top-left reads as one row, not a
                   stack that covers it. Remote peers keep their per-cell overlays. -->
              <span id="stage-self" class="stage-self hidden">
                <span id="stage-self-name" class="stage-self-name"></span>
                <span id="stage-self-lang" class="stage-self-lang"></span>
              </span>
              <span id="transcript-indicator" class="transcript-indicator hidden" role="img" data-i18n-title="transcriptRecording" title={T('transcriptRecording')} aria-label={T('transcriptRecording')}></span>
              <button id="glossary-badge" class="glossary-badge hidden" data-i18n-title="glossaryActiveTip" title={T('glossaryActiveTip')} aria-label={T('glossaryActiveTip')}></button>
            </div>
            <!-- Visible info strip below meta — duration, visibility, balance always shown. -->
            <div class="stage-info-strip">
              <span class="stage-info-item"><span class="stage-info-label" data-i18n="visibility">{T('visibility')}</span> <span id="call-vis" class="vis-badge"></span></span>
              <span class="stage-info-sep"></span>
              <span class="stage-info-item">
                <span id="session-timer" class="session-badge" role="timer"><span class="sb-ico" aria-hidden="true"></span><span id="session-elapsed">00:00</span></span>
              </span>
              <span class="stage-info-sep"></span>
              <span class="stage-info-item"><span class="stage-info-label" data-i18n="currentBalance">{T('currentBalance')}</span> <span id="call-balance" class="call-balance"></span></span>
            </div>
          </div>
          <!-- Live participant badge, top-right (spec 0055 → on-video in 0061 / #98): your
               avatar initial + count (self + peers). -->
          <span id="part-count" class="part-count-badge hidden" data-i18n-title="participantsTip" title={T('participantsTip')} aria-label={T('participantsTip')}>
            <span id="part-avatar" class="pc-avatar" aria-hidden="true"></span><span id="part-count-n">1</span>
          </span>
          <span id="rec-badge" class="rec-badge hidden">REC <span class="rec-dot"></span> <span id="rec-timer">00:00</span></span>
          <!-- Voice-command countdown timer (spec 0052): set by speaking
               ("imposta timer di 10 minuti") or via the manual popover. Counts
               down on the stage; the × cancels it. -->
          <span id="timer-badge" class="timer-badge hidden" role="timer">
            <span class="ti-ico" aria-hidden="true"></span>
            <span id="timer-remaining" class="ti-remaining">00:00</span>
            <button id="timer-cancel" class="ti-cancel" data-i18n-title="timerCancel" title={T('timerCancel')} data-i18n-label="timerCancel" aria-label={T('timerCancel')}></button>
          </span>
          <div id="timer-pop" class="timer-pop hidden" role="group" data-i18n-label="timerPopTitle" aria-label={T('timerPopTitle')}>
            <button id="timer-pop-close" class="btn-ghost icon-btn ti-close" data-i18n-title="closeTip" title={T('closeTip')} aria-label="Close"></button>
            <span class="timer-pop-title" data-i18n="timerPopTitle">{T('timerPopTitle')}</span>
            <div class="timer-quick">
              <button class="timer-chip" data-min="5"><span class="timer-chip-n">5</span> <span data-i18n="minShort">{T('minShort')}</span></button>
              <button class="timer-chip" data-min="10"><span class="timer-chip-n">10</span> <span data-i18n="minShort">{T('minShort')}</span></button>
              <button class="timer-chip" data-min="15"><span class="timer-chip-n">15</span> <span data-i18n="minShort">{T('minShort')}</span></button>
              <button class="timer-chip" data-min="25"><span class="timer-chip-n">25</span> <span data-i18n="minShort">{T('minShort')}</span></button>
            </div>
            <div class="timer-custom">
              <input id="timer-custom-input" type="number" min="1" max="360" step="1" inputmode="numeric"
                data-i18n-ph="timerCustomPh" placeholder={T('timerCustomPh')} data-i18n-label="timerCustomPh" aria-label={T('timerCustomPh')} />
              <button id="timer-custom-start" class="btn-primary" data-i18n="timerStart">{T('timerStart')}</button>
            </div>
            <span class="timer-hint" data-i18n="timerVoiceHint">{T('timerVoiceHint')}</span>
          </div>
          <!-- Bookmark label prompt (spec 0013 → 0039): pressing 🔖 opens this with a
               REQUIRED label; the pin is saved only when a non-empty label is
               confirmed (an empty / abandoned prompt saves nothing). -->
          <div id="bookmark-pop" class="bookmark-pop hidden" role="group" data-i18n-label="bookmarkLabelPrompt" aria-label={T('bookmarkLabelPrompt')}>
            <span id="bookmark-pop-title" class="bookmark-pop-title" role="status"></span>
            <input id="bookmark-label-input" type="text" maxlength="200" autocomplete="off"
              data-i18n-ph="bookmarkLabelPh" placeholder={T('bookmarkLabelPh')} data-i18n-label="bookmarkLabelPh" aria-label={T('bookmarkLabelPh')} />
            <button id="bookmark-label-save" class="btn-primary bm-save" data-i18n="saveBtn">{T('saveBtn')}</button>
            <button id="bookmark-show-all" class="btn-ghost" data-i18n="showAllBookmarks">{T('showAllBookmarks')}</button>
            <!-- Explicit close (#226): the prompt had only Escape / auto-dismiss; an X
                 matches every other modal's close affordance. -->
            <button id="bookmark-pop-close" class="btn-ghost icon-btn bm-close" data-i18n-title="closeTip" title={T('closeTip')} aria-label="Close"></button>
          </div>
          <!-- Collaborative whiteboard overlay (spec 0045 → advanced in 0062 / #96):
               covers the stage; ops relay over the WS and a late-joiner gets a
               snapshot. Multi-page, highlighter + shapes, and PNG/PDF export. -->
          <div id="whiteboard" class="whiteboard hidden">
            <!-- Drawable-area affordance (#96 follow-up): the board's logical canvas is a
                 fixed 16:9 sheet letterboxed inside the overlay, so the margins aren't
                 drawable. This frame is sized by whiteboard.ts to that exact sheet — it
                 carries the dot grid + a soft border so you can SEE where you can draw.
                 pointer-events:none + behind the canvas, so it never affects drawing,
                 recording, or export. -->
            <div class="wb-frame" aria-hidden="true"></div>
            <canvas id="wb-canvas" class="wb-canvas"></canvas>
            <div class="wb-toolbar" role="toolbar" data-i18n-label="whiteboardTip" aria-label={T('whiteboardTip')}>
              <span class="wb-tools">
                <button id="wb-pen" class="wb-tool active" data-tool="pen" data-i18n-title="wbPen" title={T('wbPen')} aria-label={T('wbPen')}></button>
                <button id="wb-highlighter" class="wb-tool" data-tool="highlighter" data-i18n-title="wbHighlighter" title={T('wbHighlighter')} aria-label={T('wbHighlighter')}></button>
                <button id="wb-eraser" class="wb-tool" data-tool="eraser" data-i18n-title="wbEraser" title={T('wbEraser')} aria-label={T('wbEraser')}></button>
                <button id="wb-line" class="wb-tool" data-tool="line" data-i18n-title="wbLine" title={T('wbLine')} aria-label={T('wbLine')}></button>
                <button id="wb-arrow" class="wb-tool" data-tool="arrow" data-i18n-title="wbArrow" title={T('wbArrow')} aria-label={T('wbArrow')}></button>
                <button id="wb-rect" class="wb-tool" data-tool="rect" data-i18n-title="wbRect" title={T('wbRect')} aria-label={T('wbRect')}></button>
                <button id="wb-ellipse" class="wb-tool" data-tool="ellipse" data-i18n-title="wbEllipse" title={T('wbEllipse')} aria-label={T('wbEllipse')}></button>
              </span>
              <span class="wb-sep" aria-hidden="true"></span>
              <span class="wb-widths" role="group" data-i18n-label="wbWidth" aria-label={T('wbWidth')}>
                <button class="wb-width" data-width="s" data-i18n-title="wbWidthS" title={T('wbWidthS')} aria-label={T('wbWidthS')}><span class="wb-dot wb-dot-s"></span></button>
                <button class="wb-width active" data-width="m" data-i18n-title="wbWidthM" title={T('wbWidthM')} aria-label={T('wbWidthM')}><span class="wb-dot wb-dot-m"></span></button>
                <button class="wb-width" data-width="l" data-i18n-title="wbWidthL" title={T('wbWidthL')} aria-label={T('wbWidthL')}><span class="wb-dot wb-dot-l"></span></button>
              </span>
              <span class="wb-sep" aria-hidden="true"></span>
              <span class="wb-colors">
                <button class="wb-color active" data-color="#f1f5f9" style="--c:#f1f5f9" aria-label="white"></button>
                <button class="wb-color" data-color="#3b82f6" style="--c:#3b82f6" aria-label="blue"></button>
                <button class="wb-color" data-color="#ef4444" style="--c:#ef4444" aria-label="red"></button>
                <button class="wb-color" data-color="#22c55e" style="--c:#22c55e" aria-label="green"></button>
                <button class="wb-color" data-color="#f59e0b" style="--c:#f59e0b" aria-label="amber"></button>
              </span>
              <span class="wb-sep" aria-hidden="true"></span>
              <button id="wb-clear" class="wb-tool" data-i18n-title="wbClear" title={T('wbClear')} aria-label={T('wbClear')}></button>
              <span class="wb-export-wrap">
                <button id="wb-export" class="wb-tool" aria-haspopup="true" aria-expanded="false" aria-controls="wb-export-menu" data-i18n-title="wbExport" title={T('wbExport')} aria-label={T('wbExport')}></button>
                <span id="wb-export-menu" class="wb-export-menu hidden" role="group" data-i18n-label="wbExport" aria-label={T('wbExport')}>
                  <button id="wb-export-png" class="btn-ghost" data-i18n="wbExportPng">{T('wbExportPng')}</button>
                  <button id="wb-export-pdf" class="btn-ghost" data-i18n="wbExportPdf">{T('wbExportPdf')}</button>
                </span>
              </span>
              <button id="wb-close" class="wb-tool" data-i18n-title="closeTip" title={T('closeTip')} aria-label={T('closeTip')}></button>
            </div>
            <!-- Page strip (spec 0062): navigate · add · duplicate · delete pages. -->
            <div class="wb-pagebar" role="group" data-i18n-label="wbPages" aria-label={T('wbPages')}>
              <button id="wb-page-prev" class="wb-page-btn" data-i18n-title="wbPrevPage" title={T('wbPrevPage')} aria-label={T('wbPrevPage')}></button>
              <span id="wb-page-label" class="wb-page-label" role="status">1 / 1</span>
              <button id="wb-page-next" class="wb-page-btn" data-i18n-title="wbNextPage" title={T('wbNextPage')} aria-label={T('wbNextPage')}></button>
              <span class="wb-sep" aria-hidden="true"></span>
              <button id="wb-page-add" class="wb-page-btn" data-i18n-title="wbAddPage" title={T('wbAddPage')} aria-label={T('wbAddPage')}></button>
              <button id="wb-page-dup" class="wb-page-btn" data-i18n-title="wbDupPage" title={T('wbDupPage')} aria-label={T('wbDupPage')}></button>
              <button id="wb-page-del" class="wb-page-btn" data-i18n-title="wbDelPage" title={T('wbDelPage')} aria-label={T('wbDelPage')}></button>
            </div>
          </div>
        </div>
        <!-- Tic-Tac-Toe & quiz moved OUTSIDE .video-stage (isolation: isolate)
             so their z-index competes in the root stacking context (above ⋯ menu). -->
        <div id="minigame" class="minigame hidden">
          <div class="mg-head">
            <span class="mg-title">Tic-Tac-Toe</span>
            <button id="mg-close" class="btn-ghost icon-btn" data-i18n-title="closeTip" title={T('closeTip')} aria-label={T('closeTip')}></button>
          </div>
          <p id="mg-status" class="mg-status" role="status"></p>
          <div id="mg-board" class="mg-board"></div>
          <button id="mg-action" class="btn-primary mg-action"></button>
        </div>
        <div id="quiz" class="minigame quiz hidden">
          <div class="mg-head">
            <span class="mg-title">Quiz</span>
            <button id="quiz-close" class="btn-ghost icon-btn" data-i18n-title="closeTip" title={T('closeTip')} aria-label={T('closeTip')}></button>
          </div>
          <!-- AI quiz on demand (spec 0067 / #124): prompt → Groq → credits. -->
          <form id="quiz-ai" class="quiz-ai">
            <input id="quiz-ai-prompt" class="quiz-ai-input" type="text" maxlength="400" autocomplete="off" data-i18n-ph="quizAiPrompt" placeholder={T('quizAiPrompt')} />
            <button id="quiz-ai-gen" type="submit" class="quiz-ai-btn" data-i18n="quizAiGenerate">{T('quizAiGenerate')}</button>
          </form>
          <!-- Estimated cost: scales with the room's distinct languages (the quiz is
               localized for everyone). Language-neutral so it needs no translation. -->
          <p id="quiz-ai-cost" class="quiz-ai-cost" hidden></p>
          <p id="quiz-ai-msg" class="quiz-ai-msg" role="status" hidden></p>
          <!-- Shown only when generation 402s: a way to act on "out of credits" (spec 0083). -->
          <button id="quiz-ai-buy" class="btn-ghost quiz-ai-buy hidden" data-i18n="buyCredits">{T('buyCredits')}</button>
          <p id="quiz-question" class="quiz-question"></p>
          <div id="quiz-options" class="quiz-options"></div>
          <p id="quiz-status" class="mg-status" role="status"></p>
          <button id="quiz-action" class="btn-primary mg-action"></button>
          <!-- Host-only cancel for an in-progress quiz (spec 0070 R4.3). -->
          <button id="quiz-cancel" class="btn-ghost quiz-cancel-btn" data-i18n="quizCancel" hidden>{T('quizCancel')}</button>
        </div>
        <!-- Floating reaction tray ABOVE the controls (spec 0060 / #94): a centered,
             visually-separated pill — always accessible and spammable (rate-limited
             5/s). Buttons are injected in app.ts; the #quick-reactions id is kept so
             the wiring is unchanged. -->
        <div id="quick-reactions" class="reaction-bar" role="group" data-i18n-label="quickReactTip" aria-label={T('quickReactTip')}></div>
        <!-- Buttons are grouped so the bar wraps in tidy clusters (and keeps
             related controls together) instead of one long overflowing row. -->
        <div class="control-bar" role="toolbar" data-i18n-label="controlsLabel" aria-label={T('controlsLabel')}>
          <div class="ctl-group">
            <button id="btn-mic" class="control-btn" data-i18n-title="muteTip" title={T('muteTip')} aria-label={T('muteTip')}></button>
            <button id="btn-cam" class="control-btn" data-i18n-title="camTip" title={T('camTip')} aria-label={T('camTip')}></button>
          </div>
          <div class="ctl-group">
            <button id="btn-subtitle" class="control-btn" data-i18n-title="subtitleTip" title={T('subtitleTip')} aria-label={T('subtitleTip')}></button>
            <button id="btn-tts" class="control-btn" data-i18n-title="ttsTip" title={T('ttsTip')} aria-label={T('ttsTip')}></button>
            <button id="btn-chat" class="control-btn" data-i18n-title="chatTip" title={T('chatTip')} aria-label={T('chatTip')} aria-expanded="false" aria-controls="chat-panel"><span class="chat-ico"></span><span id="chat-badge" class="chat-badge" hidden>0</span></button>
          </div>
          <div class="ctl-group more-group">
            <button id="btn-more" class="control-btn" data-i18n-title="moreTip" title={T('moreTip')} data-i18n-label="moreTip" aria-label={T('moreTip')} aria-haspopup="true" aria-expanded="false" aria-controls="more-menu"></button>
            <!-- role="group" (not "menu"): a labeled disclosure of independent toggle/action
                 buttons, NOT an arrow-key ARIA menu — matches real behaviour + clears axe
                 aria-required-children (spec 0056). -->
            <div id="more-menu" class="more-menu hidden" role="group" data-i18n-label="moreTip" aria-label={T('moreTip')}>
              <div class="mm-group">
                <span class="mm-head" data-i18n="moreGroupStage">{T('moreGroupStage')}</span>
                <div class="mm-grid">
                  <span class="mi"><button id="btn-view" class="control-btn" data-i18n-title="viewGrid" title={T('viewGrid')} aria-label={T('viewGrid')}></button><span class="mi-label" data-i18n="viewGrid">{T('viewGrid')}</span></span>
                  <span class="mi"><button id="btn-share" class="control-btn" data-i18n-title="screenShareTip" title={T('screenShareTip')} aria-label={T('screenShareTip')}></button><span class="mi-label" data-i18n="screenShareTip">{T('screenShareTip')}</span></span>
                  <span class="mi"><button id="btn-bg" class="control-btn" data-i18n-title="bgBlurTip" title={T('bgBlurTip')} aria-label={T('bgBlurTip')}></button><span class="mi-label" data-i18n="bgBlurTip">{T('bgBlurTip')}</span></span>
                  <span class="mi"><button id="btn-pip" class="control-btn" data-i18n-title="pipTip" title={T('pipTip')} aria-label={T('pipTip')}></button><span class="mi-label" data-i18n="pipTip">{T('pipTip')}</span></span>
                  <span class="mi"><button id="btn-fullscreen" class="control-btn" data-i18n-title="fullscreenTip" title={T('fullscreenTip')} aria-label={T('fullscreenTip')}></button><span class="mi-label" data-i18n="fullscreenTip">{T('fullscreenTip')}</span></span>
                  <span class="mi"><button id="btn-record" class="control-btn" data-i18n-title="recordingTip" title={T('recordingTip')} aria-label={T('recordingTip')}></button><span class="mi-label" data-i18n="recordingTip">{T('recordingTip')}</span></span>
                  <span class="mi"><button id="btn-whiteboard" class="control-btn" data-i18n-title="whiteboardTip" title={T('whiteboardTip')} aria-label={T('whiteboardTip')}></button><span class="mi-label" data-i18n="whiteboardTip">{T('whiteboardTip')}</span></span>
                  <span class="mi hidden" id="mi-audio-settings"><button id="btn-audio-settings" class="control-btn" data-i18n-title="audioSettings" title={T('audioSettings')} aria-label={T('audioSettings')} aria-haspopup="dialog"></button><span class="mi-label" data-i18n="audioSettings">{T('audioSettings')}</span></span>
                </div>
              </div>
              <div class="mm-group">
                <span class="mm-head" data-i18n="moreGroupRoom">{T('moreGroupRoom')}</span>
                <div class="mm-grid">
                  <span class="mi"><button id="btn-hand" class="control-btn" data-i18n-title="handTip" title={T('handTip')} aria-label={T('handTip')}></button><span class="mi-label" data-i18n="handTip">{T('handTip')}</span></span>
                  <span class="mi"><button id="btn-participants" class="control-btn" data-i18n-title="participantsTip" title={T('participantsTip')} aria-label={T('participantsTip')} aria-expanded="false" aria-controls="participants-panel"><span class="part-ico"></span><span id="part-badge" class="chat-badge" hidden>0</span></button><span class="mi-label" data-i18n="participantsTip">{T('participantsTip')}</span></span>
                  <span class="mi hidden" id="mi-invite"><button id="btn-invite" class="control-btn" data-i18n-title="inviteTip" title={T('inviteTip')} aria-label={T('inviteTip')} aria-expanded="false" aria-controls="invite-panel"></button><span class="mi-label" data-i18n="inviteTip">{T('inviteTip')}</span></span>
                  <span class="mi"><button id="btn-bookmark" class="control-btn" data-i18n-title="bookmarkTip" title={T('bookmarkTip')} data-i18n-label="bookmarkTip" aria-label={T('bookmarkTip')} hidden></button><span class="mi-label" data-i18n="bookmarkTip">{T('bookmarkTip')}</span></span>
                  <span class="mi hidden" id="mi-minigame"><button id="btn-minigame" class="control-btn" data-i18n-title="minigameTip" title={T('minigameTip')} aria-label={T('minigameTip')}></button><span class="mi-label" data-i18n="minigameTip">{T('minigameTip')}</span></span>
                  <span class="mi"><button id="btn-quiz" class="control-btn" data-i18n-title="quizTip" title={T('quizTip')} aria-label={T('quizTip')}></button><span class="mi-label" data-i18n="quizTip">{T('quizTip')}</span></span>
                  <span class="mi"><button id="btn-timer" class="control-btn" data-i18n-title="timerTip" title={T('timerTip')} aria-label={T('timerTip')}></button><span class="mi-label" data-i18n="timerTip">{T('timerTip')}</span></span>
                </div>
              </div>
            </div>
          </div>
          <div class="ctl-group">
            <button id="btn-leave" class="control-btn leave" data-i18n-title="leaveTip" title={T('leaveTip')} aria-label={T('leaveTip')}></button>
          </div>
        </div>
      </div>

      <!-- Named <section> = region landmark: nestable in <main>, unlike <aside>
           (axe: landmark-complementary-is-top-level). -->
      <section id="participants-panel" class="participants-panel closed" data-panel="participants" data-i18n-label="participants" aria-label={T('participants')}>
        <div class="side-panel-header">
          <span class="card-title" data-i18n="participants">{T('participants')}</span>
          <button id="part-close" class="btn-ghost icon-btn" data-i18n-title="closeTip" title={T('closeTip')} aria-label={T('closeTip')}></button>
        </div>
        <div id="participants-list" class="participants-list"></div>
      </section>

      <!-- Invite panel (spec 0082): copy a join link or email it to people you
           know. Email send is signed-in only; copy works for everyone. -->
      <section id="invite-panel" class="invite-panel closed" data-panel="invite" data-i18n-label="inviteTitle" aria-label={T('inviteTitle')}>
        <div class="side-panel-header">
          <span class="card-title" data-i18n="inviteTitle">{T('inviteTitle')}</span>
          <button id="invite-close" class="btn-ghost icon-btn" data-i18n-title="closeTip" title={T('closeTip')} aria-label={T('closeTip')}></button>
        </div>
        <div class="invite-body">
          <p class="invite-sub" data-i18n="inviteSubtitle">{T('inviteSubtitle')}</p>
          <label class="invite-label" for="invite-link" data-i18n="inviteLinkLabel">{T('inviteLinkLabel')}</label>
          <div class="invite-row">
            <input id="invite-link" class="invite-input" type="text" readonly />
            <button id="invite-copy" class="btn-primary invite-go" data-i18n="copy">{T('copy')}</button>
          </div>
          <div id="invite-email-block" class="invite-email-block">
            <label class="invite-label" for="invite-email" data-i18n="inviteEmailLabel">{T('inviteEmailLabel')}</label>
            <div class="invite-row">
              <input id="invite-email" class="invite-input" type="email" autocomplete="off" spellcheck="false" data-i18n-ph="inviteEmailPh" placeholder={T('inviteEmailPh')} />
              <button id="invite-send" class="btn-primary invite-go" data-i18n="inviteSendBtn">{T('inviteSendBtn')}</button>
            </div>
            <p class="invite-help" data-i18n="inviteEmailHelp">{T('inviteEmailHelp')}</p>
          </div>
          <p id="invite-guest-hint" class="invite-guest-hint hidden" data-i18n="inviteGuestHint">{T('inviteGuestHint')}</p>
          <p id="invite-status" class="invite-status" role="status" aria-live="polite"></p>
        </div>
      </section>

      <section id="bookmarks-panel" class="bookmarks-panel closed" data-i18n-label="bookmarksTitle" aria-label={T('bookmarksTitle')}>
        <div class="side-panel-header">
          <span class="card-title" data-i18n="bookmarksTitle">{T('bookmarksTitle')}</span>
          <button id="bookmarks-close" class="btn-ghost icon-btn" data-i18n-title="closeTip" title={T('closeTip')} aria-label={T('closeTip')}></button>
        </div>
        <div id="bookmarks-list" class="bookmarks-list"></div>
      </section>

      <section id="chat-panel" class="chat-panel closed" data-i18n-label="chatTitle" aria-label={T('chatTitle')}>
        <div class="chat-header">
          <span class="card-title" data-i18n="chatTitle">{T('chatTitle')}</span>
          <button id="chat-close" class="btn-ghost icon-btn" data-i18n-title="closeTip" title={T('closeTip')} aria-label={T('closeTip')}></button>
        </div>
        <div id="chat-messages" class="chat-messages" role="log" data-i18n-label="chatTitle" aria-label={T('chatTitle')}></div>
        <!-- Upload progress (spec 0018): shown while a file uploads. -->
        <div id="chat-upload" class="chat-upload hidden">
          <span id="chat-upload-label" class="chat-upload-label"></span>
          <div class="chat-upload-bar"><div id="chat-upload-fill" class="chat-upload-fill"></div></div>
        </div>
        <!-- Two-row composer (spec 0084): the textarea spans the full panel width
             so there's room to write, with a slim action bar beneath it. Same
             structure on the desktop side panel and the mobile bottom sheet. -->
        <div class="chat-input-row" id="chat-input-row">
          <textarea id="chat-input" rows="1" maxlength="500" autocomplete="off" data-i18n-ph="chatPlaceholder" placeholder={T('chatPlaceholder')}></textarea>
          <div class="chat-input-actions">
            <div class="emoji-picker-wrap">
              <button id="emoji-toggle" class="btn-ghost icon-btn emoji-btn" title="Emoji" aria-label="Emoji" aria-haspopup="true" aria-expanded="false" aria-controls="emoji-panel">😀</button>
              <div id="emoji-panel" class="emoji-panel hidden">
                <span class="emoji-section-label" data-i18n="emojiReact">{T('emojiReact')}</span>
                <div class="emoji-react-row" id="emoji-react"></div>
                <span class="emoji-section-label" data-i18n="emojiInsert">{T('emojiInsert')}</span>
                <div class="emoji-grid" id="emoji-grid"></div>
              </div>
            </div>
            <!-- Attach a file (spec 0018): hidden until the backend reports storage on. -->
            <button id="chat-attach" class="btn-ghost icon-btn attach-btn" hidden data-i18n-title="attachTip" title={T('attachTip')} aria-label="Attach"></button>
            <!-- `accept` is set from UPLOAD_ACCEPT in app.ts (extensions + MIME types) so
                 the mobile picker doesn't grey out documents. -->
            <input id="chat-file-input" type="file" hidden />
            <!-- Record a voice message: tap to start, then stop & send or discard from the
                 recording bar below. Hidden until storage is on (it rides the /files upload). -->
            <button id="chat-record" class="btn-ghost icon-btn record-btn" hidden data-i18n-title="voiceMsgTip" title={T('voiceMsgTip')} aria-label={T('voiceMsgTip')}></button>
            <button id="chat-send" class="btn-primary send-btn" data-i18n-title="send" title={T('send')} aria-label={T('send')}></button>
          </div>
          <!-- Voice-message recording bar: replaces the composer while recording. -->
          <div id="chat-recording" class="chat-recording" data-i18n-label="recording" aria-label={T('recording')}>
            <button id="chat-rec-cancel" class="btn-ghost icon-btn rec-cancel" data-i18n-title="cancel" title={T('cancel')} aria-label={T('cancel')}></button>
            <span class="rec-dot" aria-hidden="true"></span>
            <span id="chat-rec-time" class="rec-time">0:00</span>
            <span class="rec-wave" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></span>
            <button id="chat-rec-send" class="btn-primary rec-send" data-i18n-title="send" title={T('send')} aria-label={T('send')}></button>
          </div>
        </div>
        <!-- Character counter (spec 0070): bottom-right, appears as you near the cap. -->
        <div id="chat-counter" class="chat-counter hidden" aria-live="polite"></div>
        <!-- Drag-and-drop overlay (spec 0018), toggled while a file is dragged over. -->
        <div id="chat-drop" class="chat-drop hidden"><span data-i18n="dropFile">{T('dropFile')}</span></div>
      </section>
      <button id="onb-call-help" class="help-fab help-fab-call" type="button" data-i18n-title="onbHelpLabel" title={T('onbHelpLabel')} aria-label={T('onbHelpLabel')}>?</button>
    </section>

    <!-- ===================== SCHEDULE MEETING MODAL ===================== -->
    <div id="schedule-modal" class="modal-overlay hidden">
      <div class="modal card modal-narrow" role="dialog" aria-modal="true" aria-labelledby="sm-title-h">
        <div class="modal-head">
          <span id="sm-title-h" class="card-title" data-i18n="scheduleNew">{T('scheduleNew')}</span>
          <button id="sm-cancel-btn" class="btn-ghost icon-btn" data-i18n-title="closeTip" title={T('closeTip')} aria-label={T('closeTip')}></button>
        </div>
        <label class="field">
          <span class="field-label" data-i18n="scheduleFTitle">{T('scheduleFTitle')}</span>
          <input id="sm-title" type="text" maxlength="120" autocomplete="off" data-i18n-ph="scheduleFTitlePh" placeholder={T('scheduleFTitlePh')} />
        </label>
        <label class="field">
          <span class="field-label" data-i18n="scheduleFStart">{T('scheduleFStart')}</span>
          <input id="sm-start" type="datetime-local" />
        </label>
        <label class="field">
          <span class="field-label" data-i18n="scheduleFDuration">{T('scheduleFDuration')}</span>
          <input id="sm-duration" type="number" min="5" step="5" value="30" />
        </label>
        <label class="field">
          <span class="field-label" data-i18n="scheduleFRepeat">{T('scheduleFRepeat')}</span>
          <select id="sm-repeat">
            <option value="" data-i18n="scheduleRepeatNone">{T('scheduleRepeatNone')}</option>
            <option value="DAILY" data-i18n="scheduleRepeatDaily">{T('scheduleRepeatDaily')}</option>
            <option value="WEEKLY" data-i18n="scheduleRepeatWeekly">{T('scheduleRepeatWeekly')}</option>
            <option value="MONTHLY" data-i18n="scheduleRepeatMonthly">{T('scheduleRepeatMonthly')}</option>
          </select>
        </label>
        <label id="sm-count-wrap" class="field hidden">
          <span class="field-label" data-i18n="scheduleFOccurrences">{T('scheduleFOccurrences')}</span>
          <input id="sm-count" type="number" min="1" max="730" data-i18n-ph="scheduleOccurrencesPh" placeholder={T('scheduleOccurrencesPh')} />
        </label>
        <label class="field">
          <span class="field-label" data-i18n="scheduleFEmails">{T('scheduleFEmails')}</span>
          <input id="sm-emails" type="text" autocomplete="off" data-i18n-ph="scheduleFEmailsPh" placeholder={T('scheduleFEmailsPh')} />
        </label>
        <p id="sm-err" class="status-line hidden" role="status"></p>
        <div class="modal-actions">
          <button id="sm-cancel-btn2" class="btn-ghost" data-i18n="cancel">{T('cancel')}</button>
          <button id="sm-create" class="btn-primary" data-i18n="scheduleCreate">{T('scheduleCreate')}</button>
        </div>
      </div>
    </div>

    <!-- ===================== CONFIRM DIALOG (custom, localised) ===================== -->
    <div id="confirm-modal" class="modal-overlay hidden">
      <div class="modal card modal-narrow" role="dialog" aria-modal="true">
        <p id="confirm-text" class="modal-text"></p>
        <div class="modal-actions">
          <button id="confirm-no" class="btn-ghost"></button>
          <button id="confirm-yes" class="btn-danger"></button>
        </div>
      </div>
    </div>

    <!-- ===================== BUY CREDITS MODAL ===================== -->
    <!-- Purchase-only (spec: account hub): a quick, focused checkout. The credit / usage /
         transcript history that used to share this modal now lives in Account → Billing,
         so "Buy credits" no longer drops you into session history. -->
    <div id="buy-modal" class="modal-overlay hidden">
      <div class="modal card" role="dialog" aria-modal="true" aria-labelledby="buy-title">
        <div class="modal-head">
          <span id="buy-title" class="card-title" data-i18n="buyCredits">{T('buyCredits')}</span>
          <button id="buy-close" class="btn-ghost icon-btn" data-i18n-title="closeTip" title={T('closeTip')} aria-label={T('closeTip')}></button>
        </div>
        <p class="modal-balance"><span data-i18n="currentBalance">{T('currentBalance')}</span>: <strong id="modal-balance"></strong></p>
        <p id="buy-status" class="status-line" role="status"></p>
        <div id="packages-list" class="packages-list"></div>
      </div>
    </div>

    <!-- ===================== AUDIO SETTINGS (Vox Voices) ===================== -->
    <!-- One surface for translated-speech playback: current engine + status, the Vox
         Voices voice-pack (install / update / remove with progress), the device benchmark,
         and per-engine voice selection with previews. The engine picker + voice choice are
         provider-agnostic (TTSManager); Browser Voice always works, so every Vox-specific
         block is revealed only when the feature is configured / installed. -->
    <div id="audio-modal" class="modal-overlay hidden">
      <div class="modal card audio-modal" role="dialog" aria-modal="true" aria-labelledby="audio-title">
        <div class="modal-head">
          <span id="audio-title" class="card-title" data-i18n="audioSettings">{T('audioSettings')}</span>
          <button id="audio-close" class="btn-ghost icon-btn" data-i18n-title="closeTip" title={T('closeTip')} aria-label={T('closeTip')}></button>
        </div>

        <!-- Speech-engine status -->
        <div class="audio-section">
          <span class="audio-section-title" data-i18n="audioEngineSection">{T('audioEngineSection')}</span>
          <dl class="audio-status">
            <div><dt data-i18n="audioCurrentEngine">{T('audioCurrentEngine')}</dt><dd id="audio-current-engine"></dd></div>
            <div><dt data-i18n="audioEngineStatus">{T('audioEngineStatus')}</dt><dd id="audio-status-val"></dd></div>
            <div id="audio-bench-status-row" class="hidden"><dt data-i18n="audioBenchmark">{T('audioBenchmark')}</dt><dd id="audio-bench-val"></dd></div>
            <div id="audio-version-row" class="hidden"><dt data-i18n="audioPackVersion">{T('audioPackVersion')}</dt><dd id="audio-version-val"></dd></div>
          </dl>
        </div>

        <!-- Voice pack: install card / progress / installed actions. Shown only when the
             feature is configured (a manifest URL is present). -->
        <div id="audio-pack" class="audio-section hidden">
          <div id="audio-install-card" class="audio-install-card hidden">
            <p class="audio-install-title" data-i18n="voxInstallTitle">{T('voxInstallTitle')}</p>
            <p class="audio-install-desc" data-i18n="voxInstallDesc">{T('voxInstallDesc')}</p>
            <ul class="audio-install-points">
              <li data-i18n="voxInstallOneTime">{T('voxInstallOneTime')}</li>
              <li><span data-i18n="voxInstallSize">{T('voxInstallSize')}</span>: <span id="audio-install-size"></span></li>
              <li data-i18n="voxInstallOffline">{T('voxInstallOffline')}</li>
              <li data-i18n="voxInstallRemovable">{T('voxInstallRemovable')}</li>
            </ul>
            <button id="audio-install-btn" class="btn-primary" type="button" data-i18n="voxInstallCta">{T('voxInstallCta')}</button>
          </div>

          <div id="audio-progress" class="audio-progress hidden" role="group" data-i18n-label="voxInstalling" aria-label={T('voxInstalling')}>
            <div class="chat-upload-bar"><div id="audio-progress-fill" class="chat-upload-fill"></div></div>
            <p class="audio-progress-label">
              <span id="audio-progress-pct" aria-live="polite">0%</span>
              <span id="audio-progress-bytes" class="audio-progress-bytes"></span>
            </p>
            <button id="audio-cancel-btn" class="btn-ghost" type="button" data-i18n="cancel">{T('cancel')}</button>
          </div>

          <div id="audio-installed" class="audio-installed hidden">
            <button id="audio-update-btn" class="btn-primary hidden" type="button" data-i18n="voxUpdateNow">{T('voxUpdateNow')}</button>
            <button id="audio-remove-btn" class="btn-ghost" type="button" data-i18n="voxRemove">{T('voxRemove')}</button>
          </div>

          <p id="audio-pack-status" class="status-line" role="status"></p>
        </div>

        <!-- Benchmark: friendly verdict + re-run. Shown once a pack is installed. -->
        <div id="audio-bench-section" class="audio-section hidden">
          <span class="audio-section-title" data-i18n="audioBenchmark">{T('audioBenchmark')}</span>
          <p id="audio-bench-verdict" class="audio-bench-verdict" role="status"></p>
          <button id="audio-bench-btn" class="btn-ghost" type="button" data-i18n="voxRunBenchmark">{T('voxRunBenchmark')}</button>
        </div>

        <!-- Voice selection: engine + per-engine voice pickers (each voice previewable). -->
        <div class="audio-section">
          <span class="audio-section-title" data-i18n="audioVoiceSection">{T('audioVoiceSection')}</span>
          <label class="field">
            <span class="field-label" data-i18n="audioEnginePref">{T('audioEnginePref')}</span>
            <select id="audio-engine-select"></select>
          </label>
          <div id="audio-vox-voices" class="audio-voices hidden">
            <span class="field-label" data-i18n="voxVoices">{T('voxVoices')}</span>
            <div id="audio-vox-list" class="audio-voice-list" role="radiogroup" data-i18n-label="voxVoices" aria-label={T('voxVoices')}></div>
          </div>
          <div class="audio-voices">
            <span class="field-label" data-i18n="browserVoices">{T('browserVoices')}</span>
            <div id="audio-browser-list" class="audio-voice-list" role="radiogroup" data-i18n-label="browserVoices" aria-label={T('browserVoices')}></div>
          </div>
        </div>

        <!-- Developer mode: raw benchmark/engine metrics. Hidden unless dev mode is on. -->
        <div id="audio-dev" class="audio-section audio-dev hidden">
          <span class="audio-section-title" data-i18n="audioDevMode">{T('audioDevMode')}</span>
          <pre id="audio-dev-info" class="audio-dev-info"></pre>
        </div>
      </div>
    </div>

    <!-- ===================== ACCOUNT SCREEN ===================== -->
    <!-- One hub for every account concern (spec: account hub). A section nav (vertical rail
         on desktop, scrollable segmented bar on mobile) switches between Profile, Billing &
         usage, Friends, Notifications and Privacy. The avatar menu deep-links straight to a
         section. Replaces the old split of 1 screen + 3 modals (friends/privacy/buy-history). -->
    <section id="account" class="screen hidden">
      <div class="account-wrap">
        <header class="account-head">
          <button id="account-back" class="btn-ghost icon-btn" data-i18n-title="back" title={T('back')} aria-label={T('back')}></button>
          <h1 class="account-title" data-i18n="account">{T('account')}</h1>
        </header>

        <div class="account-layout">
          <nav class="account-nav" role="tablist" data-i18n-label="account" aria-label={T('account')}>
            <button class="acct-tab" type="button" role="tab" aria-selected="true" data-acct-section="profile" aria-controls="acct-profile"><span class="acct-tab-ico" data-ico="user" aria-hidden="true"></span><span class="acct-tab-label" data-i18n="profileTitle">{T('profileTitle')}</span></button>
            <button class="acct-tab" type="button" role="tab" aria-selected="false" data-acct-section="billing" aria-controls="acct-billing"><span class="acct-tab-ico" data-ico="wallet" aria-hidden="true"></span><span class="acct-tab-label" data-i18n="billingTitle">{T('billingTitle')}</span></button>
            <button class="acct-tab" type="button" role="tab" aria-selected="false" data-acct-section="friends" aria-controls="acct-friends"><span class="acct-tab-ico" data-ico="users" aria-hidden="true"></span><span class="acct-tab-label" data-i18n="friendsTitle">{T('friendsTitle')}</span><span id="friends-tab-badge" class="chat-badge acct-item-badge hidden">0</span></button>
            <button class="acct-tab" type="button" role="tab" aria-selected="false" data-acct-section="notifications" aria-controls="acct-notifications"><span class="acct-tab-ico" data-ico="bell" aria-hidden="true"></span><span class="acct-tab-label" data-i18n="notifTitle">{T('notifTitle')}</span></button>
            <button class="acct-tab" type="button" role="tab" aria-selected="false" data-acct-section="privacy" aria-controls="acct-privacy"><span class="acct-tab-ico" data-ico="shield" aria-hidden="true"></span><span class="acct-tab-label" data-i18n="privacyData">{T('privacyData')}</span></button>
            <!-- Workspace voice notes (Business/Enterprise): hidden until an active-sub org is found. -->
            <button id="acct-tab-workspace" class="acct-tab hidden" type="button" role="tab" aria-selected="false" data-acct-section="workspace" aria-controls="acct-workspace"><span class="acct-tab-ico" data-ico="grid" aria-hidden="true"></span><span class="acct-tab-label" data-i18n="workspace">{T('workspace')}</span></button>
          </nav>

          <div class="account-content">
            <!-- Profile -->
            <section id="acct-profile" class="acct-section" role="tabpanel" data-section="profile" data-i18n-label="profileTitle" aria-label={T('profileTitle')}>
              <div class="profile-card">
                <span id="profile-avatar" class="profile-avatar" aria-hidden="true"></span>
                <div class="profile-id">
                  <span id="profile-name" class="profile-name"></span>
                  <span id="profile-email" class="profile-email"></span>
                </div>
              </div>
            </section>

            <!-- Billing & usage: balance, a quick path back to checkout, and the full
                 history (credits / usage / transcripts) that used to hide in the buy modal. -->
            <section id="acct-billing" class="acct-section hidden" role="tabpanel" data-section="billing" data-i18n-label="billingTitle" aria-label={T('billingTitle')}>
              <div class="billing-balance-row">
                <div class="billing-balance">
                  <span class="billing-balance-label" data-i18n="currentBalance">{T('currentBalance')}</span>
                  <strong id="billing-balance" class="billing-balance-value"></strong>
                </div>
                <button id="billing-buy-btn" class="btn-primary" data-i18n="buyCredits">{T('buyCredits')}</button>
              </div>
              <div class="seg modal-tabs" role="tablist" data-i18n-label="history" aria-label={T('history')}>
                <button id="tab-history" class="seg-btn active" role="tab" aria-selected="true" data-i18n="history">{T('history')}</button>
                <button id="tab-usage" class="seg-btn" role="tab" aria-selected="false" data-i18n="usageHistory">{T('usageHistory')}</button>
                <button id="tab-transcripts" class="seg-btn" role="tab" aria-selected="false" data-i18n="transcripts">{T('transcripts')}</button>
                <button id="tab-invoices" class="seg-btn" role="tab" aria-selected="false" data-i18n="invoicesTitle">{T('invoicesTitle')}</button>
              </div>
              <div id="ledger-list" class="ledger-list"></div>
            </section>

            <!-- Friends: the single source of truth (the old friends modal is gone). -->
            <section id="acct-friends" class="acct-section hidden" role="tabpanel" data-section="friends" data-i18n-label="friendsTitle" aria-label={T('friendsTitle')}>
              <form id="profile-friend-add" class="friend-add">
                <input id="profile-friend-add-email" class="friend-add-input" type="email" autocomplete="off" maxlength="320" data-i18n-ph="friendAddPlaceholder" placeholder={T('friendAddPlaceholder')} />
                <button id="profile-friend-add-btn" type="submit" class="btn-primary friend-add-btn" data-i18n="friendAdd">{T('friendAdd')}</button>
              </form>
              <p id="profile-friend-add-msg" class="status-line friend-add-msg hidden" role="status"></p>

              <section id="profile-friend-requests-section" class="friend-section hidden">
                <h3 class="friend-section-title" data-i18n="friendRequestsIn">{T('friendRequestsIn')}</h3>
                <div id="profile-friend-requests-list" class="friend-list"></div>
              </section>

              <section id="profile-friend-outgoing-section" class="friend-section hidden">
                <h3 class="friend-section-title" data-i18n="friendRequestsOut">{T('friendRequestsOut')}</h3>
                <div id="profile-friend-outgoing-list" class="friend-list"></div>
              </section>

              <section class="friend-section">
                <h3 class="friend-section-title" data-i18n="friendsYours">{T('friendsYours')}</h3>
                <div id="profile-friends-list" class="friend-list"></div>
                <p id="profile-friends-empty" class="friend-empty hidden" data-i18n="friendsEmpty">{T('friendsEmpty')}</p>
              </section>
            </section>

            <!-- Notifications -->
            <section id="acct-notifications" class="acct-section hidden" role="tabpanel" data-section="notifications" data-i18n-label="notifTitle" aria-label={T('notifTitle')}>
              <p class="profile-section-hint" data-i18n="notifHint">{T('notifHint')}</p>
              <div id="notif-prefs" class="notif-prefs"></div>
            </section>

            <!-- Privacy & data (was the privacy modal). -->
            <section id="acct-privacy" class="acct-section hidden" role="tabpanel" data-section="privacy" data-i18n-label="privacyData" aria-label={T('privacyData')}>
              <button id="export-data" class="btn-ghost privacy-btn" data-i18n="exportData">{T('exportData')}</button>
              <!-- Withdrawal path: re-opens the cookie banner so an accept can become a
                   decline. A consent that cannot be withdrawn is not valid consent, and
                   the privacy policy points here. -->
              <button id="cookie-settings" class="btn-ghost privacy-btn" data-i18n="cookieSettings">{T('cookieSettings')}</button>
              <button id="delete-account" class="btn-ghost privacy-btn danger" data-i18n="deleteAccount">{T('deleteAccount')}</button>
              <p class="status-line voice-clone-line"><strong data-i18n="voiceCloneTitle">{T('voiceCloneTitle')}</strong> — <span id="voice-clone-state"></span></p>
              <p id="privacy-status" class="status-line" role="status"></p>
              <div class="legal-links">
                <a href="/terms" target="_blank" rel="noopener" data-i18n="terms">{T('terms')}</a> ·
                <a href="/privacy" target="_blank" rel="noopener" data-i18n="privacy">{T('privacy')}</a> ·
                <a href="/acceptable-use" target="_blank" rel="noopener" data-i18n="acceptableUse">{T('acceptableUse')}</a>
              </div>
            </section>

            <!-- Workspace: record a voice note onto a project (Business/Enterprise). The
                 note is transcribed + translated and lands in the project's insights data. -->
            <section id="acct-workspace" class="acct-section hidden" role="tabpanel" data-section="workspace" data-i18n-label="workspace" aria-label={T('workspace')}>
              <p class="profile-section-hint" data-i18n="wsVoiceIntro">{T('wsVoiceIntro')}</p>
              <div class="ws-pickers">
                <label class="ws-field" id="ws-org-field">
                  <span class="ws-field-label" data-i18n="bizOrg">{T('bizOrg')}</span>
                  <select id="ws-org" class="ws-select"></select>
                </label>
                <label class="ws-field">
                  <span class="ws-field-label" data-i18n="bizProject">{T('bizProject')}</span>
                  <select id="ws-project" class="ws-select"></select>
                </label>
              </div>
              <!-- Recorder: idle record button, then a recording bar (reuses the chat rec-* styles). -->
              <div id="ws-recorder" class="ws-recorder">
                <button id="ws-record" class="btn-primary ws-record-btn" data-i18n="voiceMsgTip" disabled>{T('voiceMsgTip')}</button>
                <div id="ws-recording" class="ws-recording hidden">
                  <button id="ws-rec-cancel" class="btn-ghost icon-btn rec-cancel" data-i18n-title="cancel" title={T('cancel')} aria-label={T('cancel')}></button>
                  <span class="rec-dot" aria-hidden="true"></span>
                  <span id="ws-rec-time" class="rec-time">0:00</span>
                  <span class="rec-wave" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></span>
                  <button id="ws-rec-send" class="btn-primary rec-send" data-i18n-title="send" title={T('send')} aria-label={T('send')}></button>
                </div>
              </div>
              <div id="ws-upload" class="chat-upload hidden">
                <span id="ws-upload-label" class="chat-upload-label"></span>
                <div class="chat-upload-bar"><div id="ws-upload-fill" class="chat-upload-fill"></div></div>
              </div>
              <p id="ws-status" class="status-line" role="status"></p>
              <div id="ws-notes" class="ws-notes"></div>
            </section>
          </div>
        </div>
      </div>
    </section>

    <!-- ===================== WEBINARS (B2B host hub, webinar phase 0) ===================== -->
    <!-- A signed-in host with an active-subscription org creates and manages webinars.
         Each webinar shows a copyable public join link + a QR encoding that link. -->
    <section id="webinars" class="screen hidden">
      <div class="account-wrap">
        <header class="account-head">
          <button id="webinars-back" class="btn-ghost icon-btn" data-i18n-title="back" title={T('back')} aria-label={T('back')}></button>
          <h1 class="account-title" data-i18n="webinarsTitle">{T('webinarsTitle')}</h1>
        </header>

        <div class="webinars-body">
          <p class="profile-section-hint" data-i18n="webinarsIntro">{T('webinarsIntro')}</p>

          <!-- The create form is collapsed by default behind this button (revealed on
               click, re-collapsed after a successful create — app.ts). -->
          <button id="webinar-create-toggle" type="button" class="btn-primary webinar-create-toggle" data-i18n="webinarCreateToggle">{T('webinarCreateToggle')}</button>

          <!-- Create form (hidden until "Create a webinar" is clicked) -->
          <form id="webinar-create" class="webinar-form hidden">
            <label class="ws-field" id="webinar-org-field">
              <span class="ws-field-label" data-i18n="bizOrg">{T('bizOrg')}</span>
              <select id="webinar-org" class="ws-select"></select>
            </label>
            <!-- Optional business project — populated from the selected org (app.ts);
                 hidden when the org has no projects. Defaults to "No project". -->
            <label class="ws-field hidden" id="webinar-project-field">
              <span class="ws-field-label" data-i18n="webinarProject">{T('webinarProject')}</span>
              <select id="webinar-project" class="ws-select"></select>
            </label>
            <label class="ws-field">
              <span class="ws-field-label" data-i18n="webinarTitleLabel">{T('webinarTitleLabel')}</span>
              <input id="webinar-title" class="ws-select" type="text" maxlength="200" required autocomplete="off" data-i18n-ph="webinarTitlePlaceholder" placeholder={T('webinarTitlePlaceholder')} />
            </label>
            <label class="ws-field">
              <span class="ws-field-label" data-i18n="webinarSourceLang">{T('webinarSourceLang')}</span>
              <select id="webinar-lang" class="ws-select"></select>
            </label>
            <label class="ws-field">
              <span class="ws-field-label" data-i18n="webinarTier">{T('webinarTier')}</span>
              <select id="webinar-tier" class="ws-select">
                <option value="enhanced" data-i18n="webinarTierEnhanced">{T('webinarTierEnhanced')}</option>
                <option value="standard" data-i18n="webinarTierStandard">{T('webinarTierStandard')}</option>
              </select>
            </label>
            <!-- Start mode: "Start now" (default, immediate) vs "Schedule" (pick a time).
                 Schedule fields are hidden in "Start now" mode and revealed on toggle. -->
            <div class="ws-field">
              <span class="ws-field-label" data-i18n="webinarStartNow">{T('webinarStartNow')}</span>
              <div id="webinar-mode-seg" class="seg" role="group" aria-label={T('webinarStartNow')}>
                <button type="button" class="seg-btn active" id="webinar-mode-now" data-mode="now" data-i18n="webinarStartNow">{T('webinarStartNow')}</button>
                <button type="button" class="seg-btn" id="webinar-mode-schedule" data-mode="schedule" data-i18n="webinarSchedule">{T('webinarSchedule')}</button>
              </div>
            </div>
            <!-- Schedule fields: revealed only when "Programma" is chosen. -->
            <div id="webinar-schedule-fields" class="hidden">
              <!-- Optional schedule (spec: calendar wiring). Leave both empty for an
                   immediate webinar; a start enables "Add to Google Calendar" on the card. -->
              <div class="webinar-schedule-row">
                <label class="ws-field grow">
                  <span class="ws-field-label" data-i18n="webinarScheduleStart">{T('webinarScheduleStart')}</span>
                  <input id="webinar-start" class="ws-select" type="datetime-local" autocomplete="off" />
                </label>
                <label class="ws-field grow">
                  <span class="ws-field-label" data-i18n="webinarScheduleEnd">{T('webinarScheduleEnd')}</span>
                  <input id="webinar-end" class="ws-select" type="datetime-local" autocomplete="off" disabled />
                </label>
              </div>
              <p class="webinar-schedule-hint" data-i18n="webinarScheduleHint">{T('webinarScheduleHint')}</p>
              <!-- Friend-reminder lead time. Only relevant for a PUBLIC scheduled webinar:
                   the host's friends get a "starting soon" alert this many minutes before
                   the start. Unscheduled public webinars alert their friends at go-live. -->
              <label class="ws-field">
                <span class="ws-field-label" data-i18n="webinarReminderLabel">{T('webinarReminderLabel')}</span>
                <input id="webinar-reminder" class="ws-select" type="number" min="0" max="1440" step="1" value="10" autocomplete="off" />
                <span class="webinar-schedule-hint" data-i18n="webinarReminderHint">{T('webinarReminderHint')}</span>
              </label>
              <!-- notify_friends toggle: visible only for public scheduled webinars.
                   Mirrors the existing webinar-toggle-row pattern. Default ON. -->
              <div class="webinar-toggle-row hidden" id="webinar-notify-friends-row">
                <span class="webinar-toggle-label" id="webinar-notify-friends-label" data-i18n="webinarNotifyFriends">{T('webinarNotifyFriends')}</span>
                <button id="webinar-notify-friends" class="ws-switch" type="button" role="switch" aria-checked="true" aria-labelledby="webinar-notify-friends-label"><span class="ws-switch-knob" aria-hidden="true"></span></button>
              </div>
            </div>
            <!-- Accessible toggle switches (role=switch + aria-checked), wired in app.ts.
                 Label + switch sit on one row; keyboard-operable (Space/Enter). -->
            <div class="webinar-toggles">
              <div class="webinar-toggle-row">
                <span class="webinar-toggle-label" id="webinar-record-video-label" data-i18n="webinarRecordVideo">{T('webinarRecordVideo')}</span>
                <button id="webinar-record-video" class="ws-switch" type="button" role="switch" aria-checked="false" aria-labelledby="webinar-record-video-label"><span class="ws-switch-knob" aria-hidden="true"></span></button>
              </div>
              <div class="webinar-toggle-row">
                <span class="webinar-toggle-label" id="webinar-record-transcript-label" data-i18n="webinarRecordTranscript">{T('webinarRecordTranscript')}</span>
                <button id="webinar-record-transcript" class="ws-switch" type="button" role="switch" aria-checked="true" aria-labelledby="webinar-record-transcript-label"><span class="ws-switch-knob" aria-hidden="true"></span></button>
              </div>
              <div class="webinar-toggle-row">
                <span class="webinar-toggle-label" id="webinar-chat-enabled-label" data-i18n="webinarChatEnabled">{T('webinarChatEnabled')}</span>
                <button id="webinar-chat-enabled" class="ws-switch" type="button" role="switch" aria-checked="false" aria-labelledby="webinar-chat-enabled-label"><span class="ws-switch-knob" aria-hidden="true"></span></button>
              </div>
              <!-- Visibility: OFF (default) = private/link-only; ON = public, listed on the home page. -->
              <div class="webinar-toggle-row">
                <span class="webinar-toggle-label" id="webinar-visibility-public-label" data-i18n="webinarVisibilityPublic">{T('webinarVisibilityPublic')}</span>
                <button id="webinar-visibility-public" class="ws-switch" type="button" role="switch" aria-checked="false" aria-labelledby="webinar-visibility-public-label"><span class="ws-switch-knob" aria-hidden="true"></span></button>
              </div>
              <!-- Members only: OFF (default) = guests can join; ON = login required to join. -->
              <div class="webinar-toggle-row">
                <span class="webinar-toggle-label" id="webinar-members-only-label" data-i18n="webinarMembersOnly">{T('webinarMembersOnly')}</span>
                <button id="webinar-members-only" class="ws-switch" type="button" role="switch" aria-checked="false" aria-labelledby="webinar-members-only-label"><span class="ws-switch-knob" aria-hidden="true"></span></button>
              </div>
              <!-- Voice clone: shown only for Enhanced + when the voice isn't cloned yet (app.ts). -->
              <div class="webinar-toggle-row hidden" id="webinar-voice-clone-row">
                <span class="webinar-toggle-label" id="webinar-voice-clone-label" data-i18n="webinarVoiceClone">{T('webinarVoiceClone')}</span>
                <button id="webinar-voice-clone" class="ws-switch" type="button" role="switch" aria-checked="false" aria-labelledby="webinar-voice-clone-label"><span class="ws-switch-knob" aria-hidden="true"></span></button>
              </div>
              <!-- Shown instead of the toggle when the host's voice is already cloned. -->
              <p id="webinar-voice-cloned-hint" class="webinar-cloned-hint hidden" data-i18n="webinarVoiceCloned">{T('webinarVoiceCloned')}</p>
            </div>
            <div class="webinar-create-actions">
              <button id="webinar-create-btn" type="submit" class="btn-primary webinar-create-btn" data-i18n="webinarCreate">{T('webinarCreate')}</button>
              <button id="webinar-create-cancel" type="button" class="btn-ghost webinar-create-cancel" data-i18n="cancel">{T('cancel')}</button>
            </div>
            <p id="webinar-create-status" class="status-line hidden" role="status"></p>
          </form>

          <!-- Existing webinars for the selected org -->
          <h2 class="webinar-list-title" data-i18n="webinarYours">{T('webinarYours')}</h2>
          <!-- Active | Archived toggle: switches which list `loadWebinars` fetches. -->
          <div id="webinar-tabs" class="seg webinar-tabs" role="tablist">
            <button type="button" class="seg-btn active" data-archived="false" role="tab" aria-selected="true" data-i18n="webinarTabActive">{T('webinarTabActive')}</button>
            <button type="button" class="seg-btn" data-archived="true" role="tab" aria-selected="false" data-i18n="webinarTabArchived">{T('webinarTabArchived')}</button>
          </div>
          <p id="webinar-list-empty" class="friend-empty hidden" data-i18n="webinarNone">{T('webinarNone')}</p>
          <div id="webinar-list" class="webinar-list"></div>
        </div>
      </div>
    </section>

    <!-- Webinar pre-live (Meet-style): clicking "Go live" on a card opens this step —
         camera preview + mic/camera device pickers + mic/cam toggles — before publishing.
         Mirrors the call pre-join (#prejoin). The chosen device ids flow into WhipPublisher. -->
    <section id="webinar-prelive" class="screen hidden">
      <div class="prejoin-card card">
        <div class="prejoin-head">
          <h1 class="card-title" data-i18n="webinarPreliveTitle">{T('webinarPreliveTitle')}</h1>
          <span class="room-tag"><span id="webinar-prelive-name" class="mono"></span></span>
        </div>
        <div class="preview-wrap">
          <video id="webinar-preview" autoplay playsinline muted></video>
          <div class="preview-off" id="webinar-preview-off" hidden>
            <span class="preview-avatar" id="webinar-preview-avatar"></span>
          </div>
          <div class="preview-controls">
            <button id="webinar-pre-mic" class="control-btn" type="button" data-i18n-title="muteTip" title={T('muteTip')} aria-label={T('muteTip')}></button>
            <button id="webinar-pre-cam" class="control-btn" type="button" data-i18n-title="camTip" title={T('camTip')} aria-label={T('camTip')}></button>
          </div>
        </div>
        <div class="field-row">
          <label class="field grow">
            <span class="field-label" data-i18n="camera">{T('camera')}</span>
            <select id="webinar-cam-select"></select>
          </label>
          <label class="field grow">
            <span class="field-label" data-i18n="microphone">{T('microphone')}</span>
            <select id="webinar-mic-select"></select>
          </label>
        </div>
        <p id="webinar-prelive-status" class="status-line" role="status"></p>
        <div class="webinar-prelive-actions">
          <button id="webinar-prelive-cancel" class="btn-ghost" type="button" data-i18n="cancel">{T('cancel')}</button>
          <button id="webinar-prelive-go" class="btn-primary" type="button" data-i18n="webinarGoOnAir">{T('webinarGoOnAir')}</button>
        </div>
      </div>
    </section>

    <!-- Webinar studio (Meet-style host screen while broadcasting): the host's own
         video, an ON AIR badge, title + code, a live participant count, round mic/cam
         controls, and End webinar. Sharing (join link + QR) lives on the pre-live/card,
         not here on-air. -->
    <section id="webinar-studio" class="screen hidden">
      <div class="studio-wrap">
        <div class="studio-main">
          <div class="studio-stage">
            <video id="webinar-studio-video" autoplay playsinline muted></video>
            <div class="studio-video-off" id="webinar-studio-video-off" hidden>
              <span class="preview-avatar" id="webinar-studio-avatar"></span>
            </div>
            <span class="studio-onair-badge" id="webinar-onair-badge" role="status">
              <span class="onair-dot" aria-hidden="true"></span><span id="webinar-onair-text" data-i18n="webinarOnAir">{T('webinarOnAir')}</span>
            </span>
            <!-- REC badge: shown iff activeWebinar.record_video is true (D8).
                 Hidden by default; app.ts openWebinarStudio shows/hides it. -->
            <span class="studio-rec-badge hidden" id="webinar-rec-badge" role="status" aria-live="off" data-i18n="webinarRecBadge">{T('webinarRecBadge')}</span>
            <span class="studio-count-badge" id="webinar-count-badge" data-i18n-title="webinarParticipants" title={T('webinarParticipants')}>
              <span class="studio-count-ico" id="webinar-count-ico" aria-hidden="true"></span><span id="webinar-count-n">0</span>
            </span>
            <!-- Live timer — counts up (elapsed) by default; click toggles to a countdown
                 when the webinar has a scheduled end. Hidden until the studio opens live. -->
            <button id="webinar-studio-timer" type="button" class="studio-timer-badge hidden" role="status" aria-live="off"></button>
          </div>
          <div class="studio-panel card">
            <div class="studio-panel-head">
              <span id="webinar-studio-title" class="card-title"></span>
              <span id="webinar-studio-code" class="webinar-studio-code mono"></span>
            </div>
            <div class="studio-controls">
              <button id="webinar-studio-mic" class="control-btn" type="button" data-i18n-title="muteTip" title={T('muteTip')} aria-label={T('muteTip')}></button>
              <button id="webinar-studio-cam" class="control-btn" type="button" data-i18n-title="camTip" title={T('camTip')} aria-label={T('camTip')}></button>
              <button id="webinar-studio-end" class="btn-primary danger" type="button" data-i18n="webinarEnd">{T('webinarEnd')}</button>
            </div>
          </div>
        </div>

        <!-- Host chat panel (Feature ⑤): the same auto-translated chat the viewers see. The
             host sends with their auth token (→ sender_kind:"host"). Hidden until app.ts
             confirms the active webinar has chat enabled. -->
        <section id="webinar-studio-chat" class="studio-chat card hidden" aria-label={T('webinarChatEnabled')}>
          <div class="studio-chat-head">
            <span class="card-title" data-i18n="webinarChatEnabled">{T('webinarChatEnabled')}</span>
            <button id="webinar-studio-chat-toggle" class="btn-ghost webinar-copy-btn" type="button" aria-pressed="true" aria-controls="webinar-studio-chat-body">
              <span class="ws-chat-toggle-label" data-i18n="wvChatHide">{T('wvChatHide')}</span>
              <span id="webinar-studio-chat-badge" class="chat-unread-badge hidden" aria-hidden="true"></span>
            </button>
          </div>
          <div id="webinar-studio-chat-body" class="studio-chat-body">
            <div id="webinar-studio-chat-list" class="wv-chat-list" role="log" aria-live="polite" aria-relevant="additions"></div>
            <div id="webinar-studio-chat-upload" class="wv-chat-upload hidden">
              <div id="webinar-studio-chat-upload-fill" class="wv-chat-upload-fill"></div>
            </div>
            <div id="webinar-studio-attach-preview" class="wv-attach-preview hidden" role="status" aria-live="polite"></div>
            <form id="webinar-studio-chat-form" class="wv-chat-form">
              <div class="chat-input-row">
                <textarea id="webinar-studio-chat-input" class="wv-chat-input" maxlength="500" rows="1" autocomplete="off" enterkeyhint="send" data-i18n-ph="wvChatPlaceholder" placeholder={T('wvChatPlaceholder')}></textarea>
                <div class="chat-input-actions">
                  <div class="emoji-picker-wrap">
                    <button id="webinar-studio-emoji-toggle" type="button" class="btn-ghost icon-btn emoji-btn" aria-label="Emoji" aria-expanded="false" aria-controls="webinar-studio-emoji-panel">😀</button>
                    <div id="webinar-studio-emoji-panel" class="emoji-panel hidden" role="group" aria-label="Emoji"></div>
                  </div>
                  <button id="webinar-studio-chat-attach" type="button" class="btn-ghost icon-btn attach-btn" aria-label="Attach file">📎</button>
                  <input id="webinar-studio-chat-file" type="file" hidden accept="image/*,.pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.txt,.csv" />
                  <button id="webinar-studio-chat-send" type="submit" class="btn-primary send-btn" data-i18n="wvChatSend">{T('wvChatSend')}</button>
                </div>
              </div>
              <div id="webinar-studio-chat-counter" class="chat-counter" aria-live="polite">0/500</div>
            </form>
            <p id="webinar-studio-chat-notice" class="wv-chat-notice hidden" role="status" aria-live="polite"></p>
          </div>
        </section>
      </div>
    </section>

    <section id="webinar-recap" class="screen hidden">
      <div class="recap-wrap">
        <div class="recap-header">
          <h2 data-i18n="wvRecapTitle">{T('wvRecapTitle')}</h2>
          <button id="recap-close" class="btn-ghost" type="button" data-i18n="wvRecapClose">{T('wvRecapClose')}</button>
        </div>

        <!-- Session datetime + stats row (PR6) -->
        <div id="recap-meta" class="recap-meta hidden">
          <div class="recap-meta-times">
            <span class="recap-meta-label" data-i18n="wvRecapStarted">{T('wvRecapStarted')}</span>
            <span id="recap-actual-start" class="recap-meta-value">—</span>
            <span class="recap-meta-sep">→</span>
            <span class="recap-meta-label" data-i18n="wvRecapEnded">{T('wvRecapEnded')}</span>
            <span id="recap-actual-end" class="recap-meta-value">—</span>
          </div>
          <div id="recap-stats" class="recap-stats hidden">
            <div class="recap-stat">
              <span class="recap-stat-value" id="recap-peak-viewers">—</span>
              <span class="recap-stat-label" data-i18n="wvRecapPeakViewers">{T('wvRecapPeakViewers')}</span>
            </div>
            <div class="recap-stat">
              <span class="recap-stat-value" id="recap-unique-attendees">—</span>
              <span class="recap-stat-label" data-i18n="wvRecapUniqueAttendees">{T('wvRecapUniqueAttendees')}</span>
            </div>
            <div class="recap-stat">
              <span class="recap-stat-value" id="recap-duration">—</span>
              <span class="recap-stat-label" data-i18n="wvRecapDuration">{T('wvRecapDuration')}</span>
            </div>
          </div>
        </div>

        <!-- Tab bar -->
        <div class="recap-tabs" role="tablist">
          <button id="recap-tab-transcript" class="recap-tab active" role="tab" aria-selected="true" data-i18n="wvRecapTabTranscript">{T('wvRecapTabTranscript')}</button>
          <button id="recap-tab-chat" class="recap-tab" role="tab" aria-selected="false" data-i18n="wvRecapTabChat">{T('wvRecapTabChat')}</button>
          <button id="recap-tab-ai" class="recap-tab" role="tab" aria-selected="false" data-i18n="wvRecapTabAiReport">{T('wvRecapTabAiReport')}</button>
          <button id="recap-tab-stats" class="recap-tab" role="tab" aria-selected="false" data-i18n="wvRecapTabStats">{T('wvRecapTabStats')}</button>
        </div>

        <!-- Transcript panel -->
        <div id="recap-transcript-panel" class="recap-panel">
          <!-- Download controls -->
          <div id="recap-download-bar" class="recap-download-bar hidden">
            <label class="recap-dl-field">
