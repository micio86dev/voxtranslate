---
import Base from '../layouts/Base.astro';

const LANGS = [
  { code: 'it', name: 'Italiano' },
  { code: 'en', name: 'English' },
  { code: 'es', name: 'Español' },
  { code: 'fr', name: 'Français' },
  { code: 'de', name: 'Deutsch' },
  { code: 'pt', name: 'Português' },
  { code: 'ja', name: '日本語' },
  { code: 'zh', name: '中文' },
];
---

<Base title="VoxTranslate">
  <main class="app">
    <!-- ===================== LOGIN (billing mode only) ===================== -->
    <section id="login" class="screen hidden">
      <div class="login-card card">
        <h1 class="brand">Vox<span>Translate</span></h1>
        <p class="tagline" data-i18n="tagline"></p>
        <p class="login-sub" data-i18n="loginSub"></p>
        <div id="gsi-button" class="gsi-button"></div>
        <div class="login-or"><span data-i18n="orText"></span></div>
        <button id="guest-btn" class="btn-ghost guest-btn" data-i18n="continueGuest"></button>
        <p class="legal-footer">
          <a href="/terms" target="_blank" data-i18n="terms"></a>
          <a href="/privacy" target="_blank" data-i18n="privacy"></a>
          <a href="/acceptable-use" target="_blank" data-i18n="acceptableUse"></a>
        </p>
      </div>
    </section>

    <!-- ===================== HOME / LOBBY ===================== -->
    <section id="home" class="screen">
      <header class="home-header">
        <h1 class="brand">Vox<span>Translate</span></h1>
        <p class="tagline" data-i18n="tagline"></p>
        <div id="account-bar" class="account-bar hidden">
          <img id="account-avatar" class="account-avatar" alt="" referrerpolicy="no-referrer" />
          <div class="account-info">
            <span id="account-name" class="account-name"></span>
            <span id="account-balance" class="account-balance"></span>
          </div>
          <button id="buy-btn" class="btn-ghost" data-i18n="buyCredits"></button>
          <button id="privacy-open" class="btn-ghost icon-btn" data-i18n-title="privacyData" aria-label="Privacy"></button>
          <button id="logout-btn" class="btn-ghost icon-btn" data-i18n-title="logout" aria-label="Logout"></button>
        </div>
        <!-- Guests have no account bar, so this is their only way back to the login
             screen (spec 0037). Sits where the account bar would be for parity. -->
        <div id="guest-bar" class="guest-bar hidden">
          <div class="guest-bar-copy">
            <span class="guest-bar-title" data-i18n="guestBarTitle"></span>
            <span class="guest-bar-sub" data-i18n="guestBarSub"></span>
          </div>
          <button id="guest-signin-btn" class="guest-signin" data-i18n="signIn"></button>
        </div>
      </header>
      <div class="home-body">
        <div class="card">
          <div class="field-row">
            <label class="field grow">
              <span class="field-label" data-i18n="nameLabel"></span>
              <input id="name" type="text" maxlength="24" autocomplete="off" data-i18n-ph="namePlaceholder" />
            </label>
            <label class="field grow">
              <span class="field-label" data-i18n="langLabel"></span>
              <select id="lang">
                <option value="auto" data-i18n="langAuto"></option>
                {LANGS.map((l) => <option value={l.code}>{l.name}</option>)}
              </select>
            </label>
          </div>
        </div>

        <div class="card">
          <span class="card-title" data-i18n="createOrJoin"></span>
          <label class="field">
            <span class="field-label" data-i18n="roomCode"></span>
            <div class="room-row">
              <input id="room" type="text" autocomplete="off" spellcheck="false" />
              <button id="dice" class="btn-ghost icon-btn" data-i18n-title="diceTip"></button>
              <button id="btn-glossary-home" class="btn-ghost icon-btn" data-i18n-title="glossaryTip" data-i18n-label="glossaryTip" hidden></button>
            </div>
          </label>
          <div class="field">
            <span class="field-label" data-i18n="visibility"></span>
            <div class="seg" id="vis-group" role="group" data-i18n-label="visibility">
              <button type="button" class="seg-btn active" data-vis="public" aria-pressed="true" data-i18n="public"></button>
              <button type="button" class="seg-btn" data-vis="private" aria-pressed="false" data-i18n="private"></button>
            </div>
            <span class="hint" id="vis-hint"></span>
          </div>
          <button id="enter" class="btn-primary" data-i18n="connect"></button>
          <p id="home-status" class="status-line" role="status"></p>
        </div>

        <div class="card">
          <div class="card-title-row">
            <span class="card-title" data-i18n="publicRooms"></span>
            <button id="refresh" class="btn-ghost" data-i18n="refresh"></button>
          </div>
          <div id="rooms-list" class="rooms-list"></div>
        </div>
      </div>
    </section>

    <!-- ===================== SESSION DETAIL (auth only) ===================== -->
    <section id="session" class="screen hidden">
      <div class="session-body">
        <header class="session-header">
          <button id="session-back" class="btn-ghost" data-i18n="back"></button>
          <h1 class="card-title" data-i18n="sessionDetails"></h1>
          <span class="room-tag"><span id="session-room" class="mono"></span></span>
        </header>
        <!-- At-a-glance summary: each fact gets its own labelled cell so it's
             obvious what every value means (issue #4). -->
        <dl class="session-stats">
          <div class="stat">
            <dt class="stat-label" data-i18n="dateLabel"></dt>
            <dd id="session-date" class="stat-value"></dd>
          </div>
          <div class="stat">
            <dt class="stat-label" data-i18n="durationLabel"></dt>
            <dd id="session-duration" class="stat-value"></dd>
          </div>
          <div class="stat">
            <dt class="stat-label" data-i18n="eventsStatLabel"></dt>
            <dd id="session-events" class="stat-value"></dd>
          </div>
          <div class="stat stat-wide">
            <dt class="stat-label" data-i18n="participants"></dt>
            <dd id="session-participants" class="stat-value"></dd>
          </div>
        </dl>

        <div class="card">
          <span class="card-title" data-i18n="downloads"></span>
          <div id="session-downloads" class="session-downloads">
            <button id="session-dl-pdf" class="btn-primary" data-i18n="downloadPdf"></button>
            <button id="session-dl-json" class="btn-primary" data-i18n="downloadJson"></button>
            <button id="session-dl-srt" class="btn-primary" data-i18n="downloadSrt"></button>
            <button id="session-dl-vtt" class="btn-primary" data-i18n="downloadVtt"></button>
            <select id="session-sub-mode" data-i18n-label="subtitleMode" data-i18n-title="subtitleMode">
              <option value="translated" data-i18n="subTranslated"></option>
              <option value="original" data-i18n="subOriginal"></option>
              <option value="both" data-i18n="subBoth"></option>
            </select>
          </div>
          <div class="ai-correct-wrap">
            <label class="ai-correct-label">
              <input type="checkbox" id="ai-correct-chk">
              <span data-i18n="aiCorrectLabel"></span>
            </label>
            <span id="ai-correct-cost" class="ai-correct-cost"></span>
          </div>
        </div>

        <!-- AI tools (report / sentiment / email) — slots filled by later phases. -->
        <div id="session-ai" class="card hidden">
          <span class="card-title" data-i18n="aiTools"></span>
          <div id="ai-report-slot"></div>
          <div id="ai-sentiment-slot"></div>
          <div id="ai-email-slot"></div>
        </div>

        <div class="card">
          <span class="card-title" data-i18n="transcriptLabel"></span>
          <div id="session-bookmarks" class="session-bookmarks" hidden></div>
          <p id="session-transcript-status" class="status-line" role="status"></p>
          <div id="session-transcript" class="session-transcript"></div>
        </div>
      </div>
    </section>

    <!-- ===================== PRE-JOIN ===================== -->
    <section id="prejoin" class="screen hidden">
      <div class="prejoin-card card">
        <div class="prejoin-head">
          <h1 class="card-title" data-i18n="prejoinTitle"></h1>
          <span class="room-tag"><span id="prejoin-room" class="mono"></span> · <span id="prejoin-vis" class="vis-badge"></span></span>
        </div>
        <div class="preview-wrap">
          <video id="preview" autoplay playsinline muted></video>
          <div class="preview-off" id="preview-off" hidden>
            <span class="preview-avatar" id="preview-avatar"></span>
          </div>
          <div class="preview-controls">
            <button id="pre-mic" class="control-btn" data-i18n-title="muteTip"></button>
            <button id="pre-cam" class="control-btn" data-i18n-title="camTip"></button>
          </div>
        </div>
        <div class="field-row">
          <label class="field grow">
            <span class="field-label" data-i18n="camera"></span>
            <select id="cam-select"></select>
          </label>
          <label class="field grow">
            <span class="field-label" data-i18n="microphone"></span>
            <select id="mic-select"></select>
          </label>
        </div>
        <p id="prejoin-status" class="status-line" role="status"></p>
        <div class="prejoin-actions">
          <button id="back-btn" class="btn-ghost" data-i18n="back"></button>
          <button id="join-btn" class="btn-primary" data-i18n="join"></button>
        </div>
      </div>
    </section>

    <!-- ===================== CALL ===================== -->
    <section id="call" class="screen hidden">
      <div id="notif-banner" class="notif-banner hidden" role="status"></div>
      <div class="call-main">
        <!-- The old .call-header row is gone (spec 0061 / #98): its chips now overlay the
             video stage (top-left meta + top-right participant badge), Meet-style. -->
        <div id="low-banner" class="low-banner hidden">
          <span id="low-banner-text" role="status"></span>
          <button id="low-banner-buy" class="btn-ghost" data-i18n="buyCredits"></button>
        </div>
        <div class="video-stage">
          <div id="video-grid" class="video-grid" data-peers="1"></div>
          <!-- On-video meta cluster, top-left (spec 0061 / #98): HH:MM | ROOM over a
               subtle dark backdrop — replaces the separate header row, Meet-style. -->
          <div class="stage-meta-wrap">
            <div class="stage-meta">
              <span id="header-clock" class="clock-badge hidden"></span>
              <button id="call-room" class="room-badge mono" data-i18n-title="copy"></button>
              <!-- Your identity folded into the meta line (issue #98 follow-up): replaces
                   the self tile's .video-overlay so the top-left reads as one row, not a
                   stack that covers it. Remote peers keep their per-cell overlays. -->
              <span id="stage-self" class="stage-self hidden">
                <span id="stage-self-name" class="stage-self-name"></span>
                <span id="stage-self-lang" class="stage-self-lang"></span>
              </span>
              <span id="transcript-indicator" class="transcript-indicator hidden" role="img" data-i18n-title="transcriptRecording"></span>
              <button id="glossary-badge" class="glossary-badge hidden" data-i18n-title="glossaryActiveTip"></button>
            </div>
            <!-- Visible info strip below meta — duration, visibility, balance always shown. -->
            <div class="stage-info-strip">
              <span class="stage-info-item"><span class="stage-info-label" data-i18n="visibility"></span> <span id="call-vis" class="vis-badge"></span></span>
              <span class="stage-info-sep"></span>
              <span class="stage-info-item">
                <span id="session-timer" class="session-badge" role="timer"><span class="sb-ico" aria-hidden="true"></span><span id="session-elapsed">00:00</span></span>
              </span>
              <span class="stage-info-sep"></span>
              <span class="stage-info-item"><span class="stage-info-label" data-i18n="currentBalance"></span> <span id="call-balance" class="call-balance"></span></span>
            </div>
          </div>
          <!-- Live participant badge, top-right (spec 0055 → on-video in 0061 / #98): your
               avatar initial + count (self + peers). -->
          <span id="part-count" class="part-count-badge hidden" data-i18n-title="participantsTip">
            <span id="part-avatar" class="pc-avatar" aria-hidden="true"></span><span id="part-count-n">1</span>
          </span>
          <span id="rec-badge" class="rec-badge hidden">REC <span class="rec-dot"></span> <span id="rec-timer">00:00</span></span>
          <!-- Voice-command countdown timer (spec 0052): set by speaking
               ("imposta timer di 10 minuti") or via the manual popover. Counts
               down on the stage; the × cancels it. -->
          <span id="timer-badge" class="timer-badge hidden" role="timer">
            <span class="ti-ico" aria-hidden="true"></span>
            <span id="timer-remaining" class="ti-remaining">00:00</span>
            <button id="timer-cancel" class="ti-cancel" data-i18n-title="timerCancel" data-i18n-label="timerCancel"></button>
          </span>
          <div id="timer-pop" class="timer-pop hidden" role="group" data-i18n-label="timerPopTitle">
            <span class="timer-pop-title" data-i18n="timerPopTitle"></span>
            <div class="timer-quick">
              <button class="timer-chip" data-min="5"><span class="timer-chip-n">5</span> <span data-i18n="minShort"></span></button>
              <button class="timer-chip" data-min="10"><span class="timer-chip-n">10</span> <span data-i18n="minShort"></span></button>
              <button class="timer-chip" data-min="15"><span class="timer-chip-n">15</span> <span data-i18n="minShort"></span></button>
              <button class="timer-chip" data-min="25"><span class="timer-chip-n">25</span> <span data-i18n="minShort"></span></button>
            </div>
            <div class="timer-custom">
              <input id="timer-custom-input" type="number" min="1" max="360" step="1" inputmode="numeric"
                data-i18n-ph="timerCustomPh" data-i18n-label="timerCustomPh" />
              <button id="timer-custom-start" class="btn-primary" data-i18n="timerStart"></button>
            </div>
            <span class="timer-hint" data-i18n="timerVoiceHint"></span>
          </div>
          <!-- Bookmark label prompt (spec 0013 → 0039): pressing 🔖 opens this with a
               REQUIRED label; the pin is saved only when a non-empty label is
               confirmed (an empty / abandoned prompt saves nothing). -->
          <div id="bookmark-pop" class="bookmark-pop hidden" role="group" data-i18n-label="bookmarkLabelPrompt">
            <span id="bookmark-pop-title" class="bookmark-pop-title" role="status"></span>
            <input id="bookmark-label-input" type="text" maxlength="200" autocomplete="off"
              data-i18n-ph="bookmarkLabelPh" data-i18n-label="bookmarkLabelPh" />
            <button id="bookmark-label-save" class="btn-primary bm-save" data-i18n="saveBtn"></button>
            <button id="bookmark-show-all" class="btn-ghost" data-i18n="showAllBookmarks"></button>
          </div>
          <!-- Collaborative whiteboard overlay (spec 0045 → advanced in 0062 / #96):
               covers the stage; ops relay over the WS and a late-joiner gets a
               snapshot. Multi-page, highlighter + shapes, and PNG/PDF export. -->
          <div id="whiteboard" class="whiteboard hidden">
            <canvas id="wb-canvas" class="wb-canvas"></canvas>
            <div class="wb-toolbar" role="toolbar" data-i18n-label="whiteboardTip">
              <span class="wb-tools">
                <button id="wb-pen" class="wb-tool active" data-tool="pen" data-i18n-title="wbPen"></button>
                <button id="wb-highlighter" class="wb-tool" data-tool="highlighter" data-i18n-title="wbHighlighter"></button>
                <button id="wb-eraser" class="wb-tool" data-tool="eraser" data-i18n-title="wbEraser"></button>
                <button id="wb-line" class="wb-tool" data-tool="line" data-i18n-title="wbLine"></button>
                <button id="wb-arrow" class="wb-tool" data-tool="arrow" data-i18n-title="wbArrow"></button>
                <button id="wb-rect" class="wb-tool" data-tool="rect" data-i18n-title="wbRect"></button>
                <button id="wb-ellipse" class="wb-tool" data-tool="ellipse" data-i18n-title="wbEllipse"></button>
              </span>
              <span class="wb-sep" aria-hidden="true"></span>
              <span class="wb-widths" role="group" data-i18n-label="wbWidth">
                <button class="wb-width" data-width="s" data-i18n-title="wbWidthS"><span class="wb-dot wb-dot-s"></span></button>
                <button class="wb-width active" data-width="m" data-i18n-title="wbWidthM"><span class="wb-dot wb-dot-m"></span></button>
                <button class="wb-width" data-width="l" data-i18n-title="wbWidthL"><span class="wb-dot wb-dot-l"></span></button>
              </span>
              <span class="wb-sep" aria-hidden="true"></span>
              <span class="wb-colors">
                <button class="wb-color active" data-color="#f1f5f9" style="--c:#f1f5f9" aria-label="white"></button>
                <button class="wb-color" data-color="#3b82f6" style="--c:#3b82f6" aria-label="blue"></button>
                <button class="wb-color" data-color="#ef4444" style="--c:#ef4444" aria-label="red"></button>
                <button class="wb-color" data-color="#22c55e" style="--c:#22c55e" aria-label="green"></button>
                <button class="wb-color" data-color="#f59e0b" style="--c:#f59e0b" aria-label="amber"></button>
              </span>
              <span class="wb-sep" aria-hidden="true"></span>
              <button id="wb-clear" class="wb-tool" data-i18n-title="wbClear"></button>
              <span class="wb-export-wrap">
                <button id="wb-export" class="wb-tool" aria-haspopup="true" aria-expanded="false" aria-controls="wb-export-menu" data-i18n-title="wbExport"></button>
                <span id="wb-export-menu" class="wb-export-menu hidden" role="group" data-i18n-label="wbExport">
                  <button id="wb-export-png" class="btn-ghost" data-i18n="wbExportPng"></button>
                  <button id="wb-export-pdf" class="btn-ghost" data-i18n="wbExportPdf"></button>
                </span>
              </span>
              <button id="wb-close" class="wb-tool" data-i18n-title="closeTip"></button>
            </div>
            <!-- Page strip (spec 0062): navigate · add · duplicate · delete pages. -->
            <div class="wb-pagebar" role="group" data-i18n-label="wbPages">
              <button id="wb-page-prev" class="wb-page-btn" data-i18n-title="wbPrevPage"></button>
              <span id="wb-page-label" class="wb-page-label" role="status">1 / 1</span>
              <button id="wb-page-next" class="wb-page-btn" data-i18n-title="wbNextPage"></button>
              <span class="wb-sep" aria-hidden="true"></span>
              <button id="wb-page-add" class="wb-page-btn" data-i18n-title="wbAddPage"></button>
              <button id="wb-page-dup" class="wb-page-btn" data-i18n-title="wbDupPage"></button>
              <button id="wb-page-del" class="wb-page-btn" data-i18n-title="wbDelPage"></button>
            </div>
          </div>
        </div>
        <!-- Tic-Tac-Toe & quiz moved OUTSIDE .video-stage (isolation: isolate)
             so their z-index competes in the root stacking context (above ⋯ menu). -->
        <div id="minigame" class="minigame hidden">
          <div class="mg-head">
            <span class="mg-title">Tic-Tac-Toe</span>
            <button id="mg-close" class="btn-ghost icon-btn" data-i18n-title="closeTip"></button>
          </div>
          <p id="mg-status" class="mg-status" role="status"></p>
          <div id="mg-board" class="mg-board"></div>
          <button id="mg-action" class="btn-primary mg-action"></button>
        </div>
        <div id="quiz" class="minigame quiz hidden">
          <div class="mg-head">
            <span class="mg-title">Quiz</span>
            <button id="quiz-close" class="btn-ghost icon-btn" data-i18n-title="closeTip"></button>
          </div>
          <!-- AI quiz on demand (spec 0067 / #124): prompt → Groq → credits. -->
          <form id="quiz-ai" class="quiz-ai">
            <input id="quiz-ai-prompt" class="quiz-ai-input" type="text" maxlength="400" autocomplete="off" data-i18n-ph="quizAiPrompt" />
            <button id="quiz-ai-gen" type="submit" class="quiz-ai-btn" data-i18n="quizAiGenerate"></button>
          </form>
          <p id="quiz-ai-msg" class="quiz-ai-msg" role="status" hidden></p>
          <p id="quiz-question" class="quiz-question"></p>
          <div id="quiz-options" class="quiz-options"></div>
          <p id="quiz-status" class="mg-status" role="status"></p>
          <button id="quiz-action" class="btn-primary mg-action"></button>
          <!-- Host-only cancel for an in-progress quiz (spec 0070 R4.3). -->
          <button id="quiz-cancel" class="btn-ghost quiz-cancel-btn" data-i18n="quizCancel" hidden></button>
        </div>
        <!-- Floating reaction tray ABOVE the controls (spec 0060 / #94): a centered,
             visually-separated pill — always accessible and spammable (rate-limited
             5/s). Buttons are injected in app.ts; the #quick-reactions id is kept so
             the wiring is unchanged. -->
        <div id="quick-reactions" class="reaction-bar" role="group" data-i18n-label="quickReactTip"></div>
        <!-- Buttons are grouped so the bar wraps in tidy clusters (and keeps
             related controls together) instead of one long overflowing row. -->
        <div class="control-bar" role="toolbar" data-i18n-label="controlsLabel">
          <div class="ctl-group">
            <button id="btn-mic" class="control-btn" data-i18n-title="muteTip"></button>
            <button id="btn-cam" class="control-btn" data-i18n-title="camTip"></button>
          </div>
          <div class="ctl-group">
            <button id="btn-subtitle" class="control-btn" data-i18n-title="subtitleTip"></button>
            <button id="btn-tts" class="control-btn" data-i18n-title="ttsTip"></button>
            <button id="btn-chat" class="control-btn" data-i18n-title="chatTip" aria-expanded="false" aria-controls="chat-panel"><span class="chat-ico"></span><span id="chat-badge" class="chat-badge" hidden>0</span></button>
          </div>
          <div class="ctl-group more-group">
            <button id="btn-more" class="control-btn" data-i18n-title="moreTip" data-i18n-label="moreTip" aria-haspopup="true" aria-expanded="false" aria-controls="more-menu"></button>
            <!-- role="group" (not "menu"): a labeled disclosure of independent toggle/action
                 buttons, NOT an arrow-key ARIA menu — matches real behaviour + clears axe
                 aria-required-children (spec 0056). -->
            <div id="more-menu" class="more-menu hidden" role="group" data-i18n-label="moreTip">
              <div class="mm-group">
                <span class="mm-head" data-i18n="moreGroupStage"></span>
                <div class="mm-grid">
                  <span class="mi"><button id="btn-view" class="control-btn" data-i18n-title="viewGrid"></button><span class="mi-label" data-i18n="viewGrid"></span></span>
                  <span class="mi"><button id="btn-share" class="control-btn" data-i18n-title="screenShareTip"></button><span class="mi-label" data-i18n="screenShareTip"></span></span>
                  <span class="mi"><button id="btn-bg" class="control-btn" data-i18n-title="bgBlurTip"></button><span class="mi-label" data-i18n="bgBlurTip"></span></span>
                  <span class="mi"><button id="btn-pip" class="control-btn" data-i18n-title="pipTip"></button><span class="mi-label" data-i18n="pipTip"></span></span>
                  <span class="mi"><button id="btn-fullscreen" class="control-btn" data-i18n-title="fullscreenTip"></button><span class="mi-label" data-i18n="fullscreenTip"></span></span>
                  <span class="mi"><button id="btn-record" class="control-btn" data-i18n-title="recordingTip"></button><span class="mi-label" data-i18n="recordingTip"></span></span>
                  <span class="mi"><button id="btn-whiteboard" class="control-btn" data-i18n-title="whiteboardTip"></button><span class="mi-label" data-i18n="whiteboardTip"></span></span>
                </div>
              </div>
              <div class="mm-group">
                <span class="mm-head" data-i18n="moreGroupRoom"></span>
                <div class="mm-grid">
                  <span class="mi"><button id="btn-hand" class="control-btn" data-i18n-title="handTip"></button><span class="mi-label" data-i18n="handTip"></span></span>
                  <span class="mi"><button id="btn-participants" class="control-btn" data-i18n-title="participantsTip" aria-expanded="false" aria-controls="participants-panel"><span class="part-ico"></span><span id="part-badge" class="chat-badge" hidden>0</span></button><span class="mi-label" data-i18n="participantsTip"></span></span>
                  <span class="mi"><button id="btn-bookmark" class="control-btn" data-i18n-title="bookmarkTip" data-i18n-label="bookmarkTip" hidden></button><span class="mi-label" data-i18n="bookmarkTip"></span></span>
                  <span class="mi"><button id="btn-minigame" class="control-btn" data-i18n-title="minigameTip"></button><span class="mi-label" data-i18n="minigameTip"></span></span>
                  <span class="mi"><button id="btn-quiz" class="control-btn" data-i18n-title="quizTip"></button><span class="mi-label" data-i18n="quizTip"></span></span>
                  <span class="mi"><button id="btn-timer" class="control-btn" data-i18n-title="timerTip"></button><span class="mi-label" data-i18n="timerTip"></span></span>
                </div>
              </div>
            </div>
          </div>
          <div class="ctl-group">
            <button id="btn-leave" class="control-btn leave" data-i18n-title="leaveTip"></button>
          </div>
        </div>
      </div>

      <!-- Named <section> = region landmark: nestable in <main>, unlike <aside>
           (axe: landmark-complementary-is-top-level). -->
      <section id="participants-panel" class="participants-panel closed" data-panel="participants" data-i18n-label="participants">
        <div class="side-panel-header">
          <span class="card-title" data-i18n="participants"></span>
          <button id="part-close" class="btn-ghost icon-btn" data-i18n-title="closeTip"></button>
        </div>
        <div id="participants-list" class="participants-list"></div>
      </section>

      <section id="bookmarks-panel" class="bookmarks-panel closed" data-i18n-label="bookmarksTitle">
        <div class="side-panel-header">
          <span class="card-title" data-i18n="bookmarksTitle"></span>
          <button id="bookmarks-close" class="btn-ghost icon-btn" data-i18n-title="closeTip"></button>
        </div>
        <div id="bookmarks-list" class="bookmarks-list"></div>
      </section>

      <section id="chat-panel" class="chat-panel closed" data-i18n-label="chatTitle">
        <div class="chat-header">
          <span class="card-title" data-i18n="chatTitle"></span>
          <button id="chat-close" class="btn-ghost icon-btn" data-i18n-title="closeTip"></button>
        </div>
        <div id="chat-messages" class="chat-messages" role="log" data-i18n-label="chatTitle"></div>
        <!-- Upload progress (spec 0018): shown while a file uploads. -->
        <div id="chat-upload" class="chat-upload hidden">
          <span id="chat-upload-label" class="chat-upload-label"></span>
          <div class="chat-upload-bar"><div id="chat-upload-fill" class="chat-upload-fill"></div></div>
        </div>
        <div class="chat-input-row">
          <div class="emoji-picker-wrap">
            <button id="emoji-toggle" class="btn-ghost icon-btn emoji-btn" title="Emoji" aria-label="Emoji" aria-haspopup="true" aria-expanded="false" aria-controls="emoji-panel">😀</button>
            <div id="emoji-panel" class="emoji-panel hidden">
              <span class="emoji-section-label" data-i18n="emojiReact"></span>
              <div class="emoji-react-row" id="emoji-react"></div>
              <span class="emoji-section-label" data-i18n="emojiInsert"></span>
              <div class="emoji-grid" id="emoji-grid"></div>
            </div>
          </div>
          <!-- Attach a file (spec 0018): hidden until the backend reports storage on. -->
          <button id="chat-attach" class="btn-ghost icon-btn attach-btn" hidden data-i18n-title="attachTip" aria-label="Attach"></button>
          <input id="chat-file-input" type="file" hidden accept=".txt,.md,.csv,.log,.pdf,.docx,.doc,.odt,.rtf,.xlsx,.pptx" />
          <textarea id="chat-input" rows="1" maxlength="500" autocomplete="off" data-i18n-ph="chatPlaceholder"></textarea>
          <button id="chat-send" class="btn-primary send-btn" data-i18n-title="send"></button>
        </div>
        <!-- Character counter (spec 0070): bottom-right, appears as you near the cap. -->
        <div id="chat-counter" class="chat-counter hidden" aria-live="polite"></div>
        <!-- Drag-and-drop overlay (spec 0018), toggled while a file is dragged over. -->
        <div id="chat-drop" class="chat-drop hidden"><span data-i18n="dropFile"></span></div>
      </section>
    </section>

