        <div id="onb-home-content" class="onb-content">
          <div id="onb-home-illus" class="onb-illus" aria-hidden="true"></div>
          <h2 id="onb-home-title" class="onb-title"></h2>
          <p id="onb-home-body" class="onb-body"></p>
        </div>
        <div id="onb-home-dots" class="onb-dots" aria-hidden="true"></div>
        <p id="onb-home-count" class="onb-count" aria-live="polite"></p>
        <div class="onb-actions">
          <button id="onb-home-back" class="btn-ghost onb-back" type="button" data-i18n="onbBack">{T('onbBack')}</button>
          <button id="onb-home-next" class="btn-primary onb-next" type="button">{T('onbNext')}</button>
        </div>
      </div>
    </div>

    <!-- ===================== BUG REPORT (spec 0071) ===================== -->
    <!-- Always-available "report a problem" button for every user (guest or signed-in).
         z-index sits below the in-call UI (#call), so it's hidden during a call. -->
    <button id="bug-report-btn" class="bug-fab" data-i18n-title="reportProblem" title={T('reportProblem')} aria-label="Report a problem" aria-haspopup="dialog">
      <span class="bug-fab-ico" aria-hidden="true"></span>
      <span class="bug-fab-label" data-i18n="reportProblem">{T('reportProblem')}</span>
    </button>
    <div id="bug-report-modal" class="modal-overlay hidden">
      <div class="modal card modal-narrow" role="dialog" aria-modal="true" aria-labelledby="bug-report-title">
        <div class="modal-head">
          <span id="bug-report-title" class="card-title" data-i18n="reportProblem">{T('reportProblem')}</span>
          <button id="bug-report-close" class="btn-ghost icon-btn" data-i18n-title="closeTip" title={T('closeTip')} aria-label={T('closeTip')}></button>
        </div>
        <textarea id="bug-report-text" class="bug-report-text" rows="4" maxlength="2000" data-i18n-ph="bugReportPlaceholder" placeholder={T('bugReportPlaceholder')}></textarea>
        <p id="bug-report-status" class="status-line" role="status"></p>
        <button id="bug-report-send" class="btn-primary" data-i18n="bugReportSend">{T('bugReportSend')}</button>
      </div>
    </div>

    <!-- ===================== COOKIE / PROCESSING BANNER ===================== -->
    <div id="cookie-banner" class="cookie-banner hidden">
      <span id="cookie-text" class="cookie-text" data-i18n="cookieText">{T('cookieText')}</span>
      <div class="cookie-actions">
        <a href="/privacy" target="_blank" rel="noopener" class="cookie-link" data-i18n="privacy">{T('privacy')}</a>
        <!-- Decline is a real, equally reachable choice: consent that cannot be refused
             as easily as it is given is not consent. Same button size as Accept. -->
        <button id="cookie-decline" class="btn-ghost cookie-btn" data-i18n="decline">{T('decline')}</button>
        <button id="cookie-accept" class="btn-primary cookie-btn" data-i18n="cookieAccept">{T('cookieAccept')}</button>
      </div>
    </div>

    <!-- ===================== LOCATION OPT-IN (optional, helps improve service) ===================== -->
    <div id="geo-banner" class="cookie-banner hidden">
      <span id="geo-text" class="cookie-text" data-i18n="geoText">{T('geoText')}</span>
      <div class="cookie-actions">
        <button id="geo-dismiss" class="btn-ghost cookie-btn" data-i18n="geoNotNow">{T('geoNotNow')}</button>
        <button id="geo-enable" class="btn-primary cookie-btn" data-i18n="geoEnable">{T('geoEnable')}</button>
      </div>
    </div>

    <!-- ===================== BALANCE EXHAUSTED MODAL ===================== -->
    <div id="exhausted-modal" class="modal-overlay hidden">
      <div class="modal card modal-narrow" role="dialog" aria-modal="true" aria-labelledby="exhausted-title">
        <span id="exhausted-title" class="card-title" data-i18n="outOfCredits">{T('outOfCredits')}</span>
