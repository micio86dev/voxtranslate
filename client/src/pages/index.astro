        <div class="modal-head">
          <span id="glossary-title" class="card-title" data-i18n="glossaryTitle">{T('glossaryTitle')}</span>
          <button id="glossary-close" class="btn-ghost icon-btn" data-i18n-title="closeTip" title={T('closeTip')} aria-label={T('closeTip')}></button>
        </div>
        <p class="modal-text" data-i18n="glossaryHint">{T('glossaryHint')}</p>
        <label class="field">
          <span class="field-label" data-i18n="glossaryNameLabel">{T('glossaryNameLabel')}</span>
          <input id="glossary-name" type="text" maxlength="100" autocomplete="off" data-i18n-ph="glossaryNamePh" placeholder={T('glossaryNamePh')} />
