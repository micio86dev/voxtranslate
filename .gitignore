# Rust
/server/target

# Node / Astro
/client/node_modules
/client/dist
/client/.astro

# Cloudflare Wrangler + Supabase CLI local state (R2/pack ops)
.wrangler/
/client/.wrangler/
/client/supabase/
# Supabase CLI machine-local link state (project-ref, versions, pooler-url) —
# autogenerated by `supabase link`; keep config.toml/migrations committable.
**/supabase/.temp/

# Local scratchpad (build helpers like ct.sh, session temp files) — not shipped
/scratchpad/

# Env / secrets
.env
/server/.env
/client/.env

# OS / editor
.DS_Store

# Test artifacts
/sample.aiff
/sample.webm
/*.webm
/*.aiff
/*.png

# Vercel
.vercel
.vercel

# Test / coverage artifacts
/client/coverage
/client/test-results
/client/playwright-report
/client/.cache
/server/tarpaulin-report.html
/client/coverage-unit

# Agent skills (skills.sh) — bodies are restorable from skills-lock.json via
# `bunx skills experimental_install`, so the lock file is committed and the
# bodies are ignored. Exception: deepgram-api is renamed from the upstream
# `api` skill (clarity), which a lock restore can't preserve, so it is vendored.
/.claude/skills/*
!/.claude/skills/deepgram-api/
/.agents/

# Claude Code local scheduler lock (runtime artifact)
.claude/scheduled_tasks.lock

# gentle-ai skill-registry cache (auto-generated, machine-specific absolute paths)
/.atl/

# Translation-cache benchmark (spec 0107): generated reports + local secrets
/scripts/bench_results/
/scripts/.env.bench

# Codex CLI local config (contains local MCP api keys — never commit)
/.codex/

# Terraform state — contains provisioned resource attributes and any value the
# provider stored verbatim, including tokens passed as variables. Never commit it.
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl
*.tfvars

# Terraform backend config: holds the Cloudflare account ID and R2 credentials.
backend.hcl
/server/target-rebuild

# Marketing audit deliverables (generated reports: HTML/PDF + raw scrape artifacts).
# Regenerate with the agent team in .claude/skills/ — not source, and large binaries.
/marketing-audit/

# Translator partials for the i18n merge scripts (client/scripts/merge-*-i18n.mjs).
# Scratch input, not source: the merged strings live in client/src/scripts/i18n/*.json.
client/.talk-i18n/
