# scripts/bench_cache.sh configuration (spec 0107). Copy to scripts/.env.bench
# and fill in. scripts/.env.bench is gitignored — never commit real tokens.
#
#   cp scripts/.env.bench.example scripts/.env.bench
#   # edit scripts/.env.bench, then:
#   set -a; . scripts/.env.bench; set +a
#   scripts/bench_cache.sh

# --- Target backend ---------------------------------------------------------
# Public base URL of the deployed VoxTranslate backend (no trailing slash).
VOXTRANSLATE_API_URL=https://your-backend.up.railway.app
# Must match the BENCH_SECRET set on the Railway backend service. Server-only.
BENCH_SECRET=

# --- Railway GraphQL API (env-var toggle + redeploy) ------------------------
# Railway account/team token with access to the project.
RAILWAY_API_TOKEN=
# IDs from the Railway dashboard (Project Settings → the URL carries the IDs).
RAILWAY_PROJECT_ID=
RAILWAY_SERVICE_ID=
RAILWAY_ENVIRONMENT_ID=

# --- Groq pricing (for the cost estimate, USD per 1M tokens) ----------------
# Update when Groq pricing changes; used only for the report's cost section.
GROQ_PRICE_PER_M_INPUT=0.05
GROQ_PRICE_PER_M_OUTPUT=0.10
