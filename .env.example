# Core keys (see server/.env.example for the full list incl. optional
# auth/billing/Stripe/pricing variables).

# REQUIRED — Alibaba Cloud Model Studio (DashScope). Powers the Standard tier's
# Qwen-Omni Realtime speech-to-speech translation; the server refuses to boot without
# it. Create one at https://modelstudio.console.alibabacloud.com → API-KEY.
# `QWEN_API_KEY` is accepted as an alias if you prefer naming it after the model.
DASHSCOPE_API_KEY=sk-your_dashscope_key_here
# Silence (ms) that ends a caption segment, shared by calls and webinars. Raise it if
# sentences are being chopped at natural pauses; lower it for snappier subtitles.
# QWEN_SEGMENT_IDLE_MS=900
# Realtime ASR model backing the ORIGINAL-language transcript — a second catalogue entry
# the region must carry. Override only if a region publishes it under another name.
# QWEN_ASR_MODEL=qwen3-asr-flash-realtime
# OPTIONAL second Model Studio region. Unset = single route (the default). Set, and a
# session that cannot OPEN on the primary retries once here, logged at WARN both times.
# Standard is the capacity-fallback engine and never reports AtCapacity, so without this
# a broken primary region takes the whole room down instead of degrading.
# QWEN_FALLBACK_ENDPOINT=wss://dashscope-intl.aliyuncs.com/api-ws/v1/realtime
# QWEN_FALLBACK_API_KEY=sk-your_other_region_key
# QWEN_FALLBACK_WORKSPACE_ID=
# REQUIRED — Groq: text translation for chat messages, transcripts, and summaries.
GROQ_API_KEY=gsk_your_groq_key_here
# OPTIONAL — Deepgram is no longer used by any LIVE tier. It remains only for BATCH
# transcription of uploaded files, meeting recordings, and voice messages; leave it
# empty and those features degrade instead of failing the boot.
DEEPGRAM_API_KEY=
PORT=3001

# Auth/billing is optional — fill DATABASE_URL + GOOGLE_CLIENT_ID + JWT_SECRET
# (and Stripe + pricing) in server/.env to enable accounts and credits.
DATABASE_URL=
GOOGLE_CLIENT_ID=
JWT_SECRET=
