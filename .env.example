# Core keys (see server/.env.example for the full list incl. optional
# auth/billing/Stripe/pricing variables).

# REQUIRED — Alibaba Cloud Model Studio (DashScope). Powers the Standard tier's
# Qwen-Omni Realtime speech-to-speech translation; the server refuses to boot without
# it. Create one at https://modelstudio.console.alibabacloud.com → API-KEY.
# `QWEN_API_KEY` is accepted as an alias if you prefer naming it after the model.
DASHSCOPE_API_KEY=sk-your_dashscope_key_here
# Silence (ms) that ends a caption segment, shared by calls and webinars. Raise it if
# sentences are being chopped at natural pauses; lower it for snappier subtitles.
# QWEN_SEGMENT_IDLE_MS=900
# Realtime ASR model backing the ORIGINAL-language transcript — a second catalogue entry
# the region must carry. Override only if a region publishes it under another name.
# QWEN_ASR_MODEL=qwen3-asr-flash-realtime
# OPTIONAL second Model Studio region. Unset = single route (the default). Set, and a
# session that cannot OPEN on the primary retries once here, logged at WARN both times.
# Standard is the capacity-fallback engine and never reports AtCapacity, so without this
# a broken primary region takes the whole room down instead of degrading.
# QWEN_FALLBACK_ENDPOINT=wss://dashscope-intl.aliyuncs.com/api-ws/v1/realtime
# QWEN_FALLBACK_API_KEY=sk-your_other_region_key
# QWEN_FALLBACK_WORKSPACE_ID=
# REQUIRED — Groq: text translation for chat messages, transcripts, and summaries.
GROQ_API_KEY=gsk_your_groq_key_here
# OPTIONAL — Deepgram is no longer used by any LIVE tier. It remains only for BATCH
# transcription of uploaded files, meeting recordings, and voice messages; leave it
# empty and those features degrade instead of failing the boot.
DEEPGRAM_API_KEY=
PORT=3001

# Auth/billing is optional — fill DATABASE_URL + GOOGLE_CLIENT_ID + JWT_SECRET
# (and Stripe + pricing) in server/.env to enable accounts and credits.
DATABASE_URL=
GOOGLE_CLIENT_ID=
JWT_SECRET=

# ---------------------------------------------------------------------------
# Translated telephone calls (spec 0111) — OPTIONAL, off by default.
#
# With VOIP_ENABLED unset, the routes are not registered at all: a request 404s
# rather than reaching a handler that has to remember to check a flag. That is
# the kill switch, and it is why turning the feature off needs nothing else.
#
# `VOIP_PROVIDER=mock` is a legitimate value in staging: it exercises the whole
# flow — dial, media, consent, billing, settlement — with no telco and no charges.
# Full setup: docs/voip-telnyx-setup.md
# ---------------------------------------------------------------------------
# VOIP_ENABLED=true
# VOIP_PROVIDER=telnyx                       # or `mock`
# VOIP_ROLLOUT_STAGE=internal                # disabled|internal|beta|business|ga
# VOIP_BETA_ORG_IDS=
# Public base the PROVIDER connects back to for call audio. Built server-side and
# never taken from a request — an attacker-chosen stream URL would make the
# provider a confused deputy pointed at anything on its network.
# VOIP_MEDIA_WS_BASE=wss://api.voxtranslate.app
#
# EU-only processing. Implemented and enforced — and turning it ON today refuses
# EVERY call, because no translation tier can satisfy it: Standard reaches Alibaba
# in Singapore and Groq handles subtitle/transcript text in the US on every tier.
# That is the honest behaviour, not a bug. See docs/voip-data-flow.md.
# VOIP_REQUIRE_EU_PROCESSING=false
# VOIP_DEFAULT_REGION=Frankfurt, Germany
#
# Commercials. Margin is a FLOOR, proven as an invariant (docs/voip-billing.md).
# VOIP_MIN_GROSS_MARGIN_PERCENT=20
# VOIP_COST_SAFETY_BUFFER_PERCENT=10
# Refuse a destination above this provider cost per minute, BEFORE dialling. The
# single most effective anti-toll-fraud control here.
# VOIP_MAX_DESTINATION_RATE=1.00
# VOIP_DAILY_PROVIDER_SPEND_LIMIT=50
# VOIP_MAX_CALL_DURATION_MINUTES=60
# VOIP_MAX_CONCURRENT_CALLS_GLOBAL=50
# VOIP_MAX_CONCURRENT_CALLS_PER_ORG=10
# VOIP_MAX_CONCURRENT_CALLS_PER_USER=2
#
# Destinations. An EMPTY allow-list means "no allow-list", not "no countries".
# VOIP_ALLOW_INTERNATIONAL=true
# VOIP_ALLOWED_COUNTRIES=
# VOIP_BLOCKED_COUNTRIES=
# Mainland China stays closed until a call to a real handset physically in China
# has been placed and recorded. A VPN test does not qualify.
# docs/voip-china-validation.md
# VOIP_CHINA_ENABLED=false
# VOIP_CHINA_REQUIRE_VALIDATED_ROUTE=true
#
# Capture. Recording is off by default and, when on, the person you call is told
# before anything is kept — that part is not switchable.
# VOIP_RECORDING_ENABLED=false
# VOIP_TRANSCRIPTION_ENABLED=true
# VOIP_VIDEO_ENABLED=false
#
# A rate older than this is stale, and a stale rate REFUSES the call rather than
# pricing it from a guess. Failing loudly here is deliberate.
# VOIP_RATE_MAX_AGE_SECS=86400
# VOIP_WEBHOOK_TOLERANCE_SECS=300
# HMAC key that pseudonymises phone numbers in logs, metrics and analytics.
# Falls back to JWT_SECRET when unset, so a missing value can never silently
# start writing real numbers into logs.
# VOIP_PSEUDONYM_KEY=
#
# Telnyx. The EU base and a Frankfurt anchor are the DEFAULTS, and both are
# required for the EU claim — either one alone is a residency statement that is
# not true.
# TELNYX_API_KEY=
# TELNYX_API_BASE=https://api.telnyx.eu
# TELNYX_CONNECTION_ID=
# TELNYX_OUTBOUND_VOICE_PROFILE_ID=
# Without the public key every webhook is rejected. Fail-closed on purpose: a
# deployment that forgot it would otherwise take call-control instructions from
# anyone who can reach the endpoint.
# TELNYX_PUBLIC_KEY=
# TELNYX_DEFAULT_CALLER_ID=
# TELNYX_MEDIA_ANCHOR=Frankfurt, Germany
#
# Live smoke tests. Never in CI; one of them places a REAL, PAID call.
# VOIP_LIVE_TESTS=false
